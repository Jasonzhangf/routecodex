          "crates/routecodex-v4-build-link/src/**",
          "crates/routecodex-v4-build-link/tests/**"
        ],
        "minimum_test_count": 11,
        "ordinary_mode_after_freeze": "disabled",
        "reenable_on": [
          "source_change",
          "contract_change",
          "public_api_change",
          "artifact_change",
          "dependency_change"
