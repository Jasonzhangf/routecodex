{
  "access": {
    "protected_paths": [
      ".appsdk/**",
      "generated/**",
      "protected/source/**"
    ]
  },
  "governance": {
    "active_kind": "immutable_consumable_library",
    "active_root": "active/lib/**",
    "debug_merge_comment_required": true,
    "freeze_requirements": [
      "git_clean",
      "source_commit_or_tag",
      "library_hash",
      "public_api_hash",
      "review_pass",
      "previous_active_immutable"
    ],
    "generated_kinds": [
      "compiler_output",
      "indexes"
    ],
    "generated_root": "generated/**",
    "playground_retention": "archive_then_remove",
    "playground_root": "playground/experiments/**",
    "promotion_requires": [
      "experiment_evidence",
      "architecture_review_pass",
      "unique_owner",
      "required_gates"
    ],
    "protected_kinds": [
      "source",
      "contracts",
      "history"
    ],
    "protected_root": "protected/**",
    "record_contracts": [
      "contracts/records/evidence-record.schema.json",
      "contracts/records/goal-clarification-record.schema.json",
      "contracts/records/review-record.schema.json",
      "contracts/records/promotion-record.schema.json",
      "contracts/records/regression-report.schema.json",
      "contracts/records/freeze-record.schema.json",
      "contracts/records/record-graph.contract.json"
    ],
    "runtime_forbidden_roots": [
      "playground/**",
      "generated/**",
      "protected/source/**"
    ],
    "zone_transition_contract": "contracts/transitions/zone-transition-manifest.json"
  },
  "lifecycle": {
    "stage": "contract_bound"
  },
  "lifecycles": {
    "artifact": "generated",
    "issue": "open",
    "library": "draft",
    "source_snapshot": "mutable"
  },
  "modules": [
    {
      "active_artifact": "active/lib/routecodex-v4-governance/**",
      "artifact_paths": [
        "governance.contract.json"
      ],
      "build": {
        "args": [
          "-c",
          "mkdir -p generated/modules/routecodex-v4-governance/lib && printf 'routecodex-v4-governance contract bundle\\n' > generated/modules/routecodex-v4-governance/lib/governance.contract.json"
        ],
        "program": "sh",
        "working_directory": "."
      },
      "contract_paths": [
        ".appsdk/contracts/**",
        "contracts/records/goal-clarification-record.schema.json",
        "contracts/goal-clarification-state-machine.json"
      ],
      "dependency_modules": [],
      "generated_outputs": [
        "generated/governance/**"
      ],
      "module_id": "routecodex-v4-governance",
      "owned_paths": [
        ".appsdk/**",
        "contracts/**"
      ],
      "regression": {
        "allow_skipped": false,
        "command": {
          "args": [
            "verify",
            "."
          ],
          "program": "appsdk",
          "working_directory": "."
        },
        "input_paths": [
          "contracts/**",
          ".appsdk/**"
        ],
        "minimum_test_count": 1,
        "ordinary_mode_after_freeze": "disabled",
        "reenable_on": [
          "source_change",
          "contract_change",
          "public_api_change",
          "artifact_change",
          "dependency_change"
        ],
        "required_before_freeze": true,
        "suite_id": "v4-governance-regression"
      },
      "source_owner": "routecodex-v4-governance",
      "stage": "source_implemented"
    },
    {
      "active_artifact": "active/lib/routecodex-v4-build-link/**",
      "artifact_paths": [
        "build-link.resolver.contract.json"
      ],
      "build": {
        "args": [
          "-c",
          "cargo build --release -p routecodex-v4-build-link && mkdir -p generated/modules/routecodex-v4-build-link/lib && printf '{\"module_id\":\"routecodex-v4-build-link\",\"artifact_kind\":\"resolver-binary\",\"schema_version\":1}\\n' > generated/modules/routecodex-v4-build-link/lib/build-link.resolver.contract.json"
        ],
