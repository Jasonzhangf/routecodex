{
  "access": {
    "protected_paths": [
      ".appsdk/**",
      "generated/**",
      "protected/source/**"
    ]
  },
  "governance": {
    "active_kind": "immutable_consumable_library",
    "active_root": "active/lib/**",
    "debug_merge_comment_required": true,
    "freeze_requirements": [
      "git_clean",
      "source_commit_or_tag",
      "library_hash",
      "public_api_hash",
      "review_pass",
      "previous_active_immutable"
    ],
    "generated_kinds": [
      "compiler_output",
      "indexes"
    ],
    "generated_root": "generated/**",
    "playground_retention": "archive_then_remove",
    "playground_root": "playground/experiments/**",
    "promotion_requires": [
      "experiment_evidence",
      "architecture_review_pass",
      "unique_owner",
      "required_gates"
    ],
    "protected_kinds": [
      "source",
      "contracts",
      "history"
    ],
    "protected_root": "protected/**",
    "record_contracts": [
      "contracts/records/evidence-record.schema.json",
      "contracts/records/goal-clarification-record.schema.json",
      "contracts/records/review-record.schema.json",
      "contracts/records/promotion-record.schema.json",
      "contracts/records/regression-report.schema.json",
      "contracts/records/freeze-record.schema.json",
      "contracts/records/record-graph.contract.json"
    ],
    "runtime_forbidden_roots": [
      "playground/**",
      "generated/**"
    ],
    "zone_transition_contract": "contracts/transitions/zone-transition-manifest.json"
  },
  "lifecycle": {
    "stage": "contract_bound"
  },
  "lifecycles": {
    "artifact": "generated",
    "issue": "open",
    "library": "draft",
    "source_snapshot": "mutable"
  },
  "modules": [
    {
      "active_artifact": "active/lib/routecodex-v4-governance/**",
      "generated_outputs": [
        "generated/governance/**"
      ],
      "module_id": "routecodex-v4-governance",
      "owned_paths": [
        "playground/experiments/**",
        "protected/source/**",
        "tests/core/**"
      ],
      "source_owner": "routecodex-v4-governance",
      "regression": {
        "required_before_freeze": true,
        "suite_id": "v4-governance-regression",
        "command": {
          "program": "appsdk",
          "args": ["verify", "."],
          "working_directory": "."
        },
        "input_paths": ["contracts/**", ".appsdk/**"],
        "minimum_test_count": 1,
        "allow_skipped": false,
        "ordinary_mode_after_freeze": "disabled",
        "reenable_on": ["source_change", "contract_change", "public_api_change", "artifact_change", "dependency_change"]
      },
      "stage": "source_implemented"
    },
    {
      "active_artifact": "active/lib/routecodex-v4-nodegraph/**",
      "generated_outputs": [
        "generated/nodegraph/**"
      ],
      "module_id": "routecodex-v4-nodegraph",
      "owned_paths": [
        "crates/routecodex-v4-nodegraph/**",
        "tests/nodegraph/**"
      ],
      "source_owner": "routecodex-v4-nodegraph",
      "regression": {
        "required_before_freeze": true,
        "suite_id": "v4-base-node-l0-regression",
        "command": {
          "program": "cargo",
          "args": ["test", "-p", "routecodex-v4-nodegraph", "--test", "l0_base_node"],
          "working_directory": "."
        },
        "input_paths": [
          "crates/routecodex-v4-nodegraph/src/base_node.rs",
          "crates/routecodex-v4-nodegraph/tests/l0_base_node.rs",
          "contracts/node-graph.contract.json",
          "contracts/pipeline-abstraction.contract.json",
          "contracts/test-layers.contract.json"
        ],
        "minimum_test_count": 12,
        "allow_skipped": false,
        "ordinary_mode_after_freeze": "disabled",
        "reenable_on": ["source_change", "contract_change", "public_api_change", "artifact_change", "dependency_change"]
      },
      "stage": "source_implemented"
    }
  ],
  "project_id": "routecodex-v4",
  "schema_version": 1,
  "sdk": {
    "name": "appsdk",
    "version": "0.1.0"
  }
}
