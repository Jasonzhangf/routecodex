{
  "schema_version": 1,
  "command_context": {
    "cwd": "v4",
    "contract": "Every command in this registry executes with the V4 project root (v4/) as working directory; commands are not runnable from the repository root."
  },
  "gates":[
    {"gate_id":"contract_valid","command":"appsdk verify <project>","required_for":["compile","promotion","freeze"]},
    {"gate_id":"sdk_pinned","command":"appsdk pin-lock <project> --binary \"$(command -v appsdk)\"","required_for":["compile","promotion","freeze"]},
    {"gate_id":"sdk_bundle_resources","command":"appsdk verify <project>","required_for":["compile","promotion","freeze","publish"]},
    {"gate_id":"global_sdk_only","command":"command -v appsdk && appsdk version && test -x \"$(command -v appsdk)\" && test \"sha256:$(shasum -a 256 \"$(command -v appsdk)\" | cut -d ' ' -f 1)\" = \"$(jq -r .digest <project>/.appsdk/sdk.lock)\" && appsdk verify --admission <project>","required_for":["compile","promotion","freeze","publish"]},
    {"gate_id":"record_graph","command":"appsdk verify <project>","required_for":["architecture_stable","freeze","publish"]},
    {"gate_id":"vcs_clean","command":"appsdk verify <project>","required_for":["freeze"]},
    {"gate_id":"regression_report","command":"appsdk verify <project>","required_for":["freeze","frozen_integrity"]},
    {"gate_id":"v4_base_node_l0_regression","command":"cargo test -p routecodex-v4-base-node --test l0_base_node --manifest-path Cargo.toml --locked","required_for":["routecodex-v4-base-node:architecture_stable","routecodex-v4-base-node:freeze"]},
    {"gate_id":"v4_edge_l1_regression","command":"cargo run --quiet --release --manifest-path Cargo.toml -p routecodex-v4-build-link -- test-consumer --root . --consumer routecodex-v4-edge --deps routecodex-v4-base-node","required_for":["routecodex-v4-edge:architecture_stable","routecodex-v4-edge:freeze","routecodex-v4-edge:active_link"]},
    {"gate_id":"v4_control_l2_regression","command":"cargo run --quiet --release --manifest-path Cargo.toml -p routecodex-v4-build-link -- test-consumer --root . --consumer routecodex-v4-control --deps routecodex-v4-base-node","required_for":["routecodex-v4-control:architecture_stable","routecodex-v4-control:freeze","routecodex-v4-control:active_link"]},
    {"gate_id":"v4_error_l2_regression","command":"cargo run --quiet --release --manifest-path Cargo.toml -p routecodex-v4-build-link -- test-consumer --root . --consumer routecodex-v4-error --deps routecodex-v4-base-node","required_for":["routecodex-v4-error:architecture_stable","routecodex-v4-error:freeze","routecodex-v4-error:active_link"]},
    {"gate_id":"v4_error_compile_fail_regression","command":"cargo test -p routecodex-v4-build-link --test resolver_red_tests negative_error_classify_without_witness_compile_fails --manifest-path Cargo.toml --locked","required_for":["routecodex-v4-error:architecture_stable","routecodex-v4-error:freeze","routecodex-v4-error:active_link"]},
    {"gate_id":"v4_config_l2_regression","command":"cargo run --quiet --release --manifest-path Cargo.toml -p routecodex-v4-build-link -- test-consumer --root . --consumer routecodex-v4-config --deps routecodex-v4-base-node,routecodex-v4-edge","required_for":["routecodex-v4-config:architecture_stable","routecodex-v4-config:freeze"]},
    {"gate_id":"v4_cargo_workspace_build","command":"cargo build --release --manifest-path Cargo.toml --locked","required_for":["routecodex-v4-base-node:compile","routecodex-v4-build-link:compile","routecodex-v4-governance:architecture_stable"]},
    {"gate_id":"v4_workspace_tests","command":"cargo test --workspace --manifest-path Cargo.toml --locked","required_for":["routecodex-v4-build-link:architecture_stable","routecodex-v4-base-node:architecture_stable"]},
    {"gate_id":"v4_active_link_resolver","command":"cargo test -p routecodex-v4-build-link --manifest-path Cargo.toml --locked","required_for":["routecodex-v4-build-link:architecture_stable","routecodex-v4-edge:active_link"]},
    {"gate_id":"v4_active_index_verify","command":"cargo run --quiet --release --manifest-path Cargo.toml -p routecodex-v4-build-link -- verify-index --root .","required_for":["routecodex-v4-build-link:architecture_stable","routecodex-v4-edge:active_link"]},
    {"gate_id":"v4_frozen_source_edge_forbidden","command":"node scripts/architecture/verify-v4-active-link.mjs","required_for":["routecodex-v4-edge:architecture_stable","routecodex-v4-edge:freeze"]},
    {"gate_id":"v4_parity_gate_semantic_parity","command":"node scripts/architecture/verify-v4-semantic-parity.mjs","required_for":["routecodex-v4-skeleton:architecture_stable","routecodex-v4-runtime:architecture_stable"]},
    {"gate_id":"v4_parity_gate_feature_gap","command":"node scripts/architecture/verify-v4-feature-gap.mjs","required_for":["routecodex-v4-skeleton:architecture_stable","routecodex-v4-runtime:architecture_stable"]},
    {"gate_id":"v4_parity_gate_feature_gap_red","command":"node scripts/architecture/verify-v4-feature-gap.mjs --red-self-test","required_for":["routecodex-v4-skeleton:architecture_stable","routecodex-v4-runtime:architecture_stable"]},
    {"gate_id":"v4_parity_gate_node_graph","command":"node scripts/architecture/verify-v4-node-graph.mjs","required_for":["routecodex-v4-governance:architecture_stable","routecodex-v4-skeleton:architecture_stable","routecodex-v4-runtime:architecture_stable"]},
    {"gate_id":"v4_parity_gate_node_graph_red","command":"node scripts/architecture/verify-v4-node-graph.mjs --red-self-test","required_for":["routecodex-v4-governance:architecture_stable","routecodex-v4-skeleton:architecture_stable","routecodex-v4-runtime:architecture_stable"]},
    {"gate_id":"v4_parity_gate_skeleton_topology","command":"node scripts/architecture/verify-v4-skeleton-topology.mjs","required_for":["routecodex-v4-skeleton:architecture_stable"]},
    {"gate_id":"v4_parity_gate_plane_isolation","command":"node scripts/architecture/verify-v4-plane-isolation.mjs","required_for":["routecodex-v4-skeleton:architecture_stable","routecodex-v4-runtime:architecture_stable"]},
    {"gate_id":"v4_parity_gate_execution_binding","command":"node scripts/architecture/verify-v4-execution-binding.mjs","required_for":["routecodex-v4-runtime:architecture_stable"]},
    {"gate_id":"v4_parity_gate_capability_isolation","command":"node scripts/architecture/verify-v4-capability-isolation.mjs","required_for":["routecodex-v4-skeleton:architecture_stable","routecodex-v4-runtime:architecture_stable"]},
    {"gate_id":"v4_parity_gate_v3_resource_coverage","command":"node scripts/architecture/verify-v4-v3-resource-coverage.mjs","required_for":["routecodex-v4-skeleton:architecture_stable","routecodex-v4-runtime:architecture_stable"]},
    {"gate_id":"v4_parity_gate_v3_resource_coverage_red","command":"node scripts/architecture/verify-v4-v3-resource-coverage.mjs --red-self-test","required_for":["routecodex-v4-skeleton:architecture_stable","routecodex-v4-runtime:architecture_stable"]},
    {"gate_id":"v4_parity_gate_resource_binding","command":"node scripts/architecture/verify-v4-resource-binding.mjs","required_for":["routecodex-v4-skeleton:architecture_stable","routecodex-v4-runtime:architecture_stable"]},
    {"gate_id":"v4_parity_gate_resource_binding_red","command":"node scripts/architecture/verify-v4-resource-binding.mjs --red-self-test","required_for":["routecodex-v4-skeleton:architecture_stable","routecodex-v4-runtime:architecture_stable"]},
    {"gate_id":"v4_compat_gate_responses_direct","command":"node scripts/architecture/verify-v4-responses-direct-compat.mjs","required_for":["routecodex-v4-runtime:architecture_stable"]},
    {"gate_id":"v4_compat_gate_relay_continuation","command":"node scripts/architecture/verify-v4-relay-continuation.mjs","required_for":["routecodex-v4-runtime:architecture_stable"]},
    {"gate_id":"v4_compat_gate_relay_continuation_red","command":"node scripts/architecture/verify-v4-relay-continuation.mjs --red-self-test","required_for":["routecodex-v4-runtime:architecture_stable"]},
    {"gate_id":"v4_skeleton_l0_regression","command":"cargo test -p routecodex-v4-skeleton --manifest-path Cargo.toml --locked","required_for":["routecodex-v4-skeleton:architecture_stable","routecodex-v4-skeleton:freeze"]},
    {"gate_id":"v4_plugin_contract_l2_regression","command":"cargo test -p routecodex-v4-plugin-contract --manifest-path Cargo.toml --locked","required_for":["routecodex-v4-plugin-contract:architecture_stable","routecodex-v4-plugin-contract:freeze"]},
    {"gate_id":"v4_plugin_plan_l2_regression","command":"cargo test -p routecodex-v4-plugin-plan --manifest-path Cargo.toml --locked","required_for":["routecodex-v4-plugin-plan:architecture_stable","routecodex-v4-plugin-plan:freeze"]},
    {"gate_id":"v4_plugin_catalog_l2_regression","command":"cargo test -p routecodex-v4-plugin-catalog --manifest-path Cargo.toml --locked","required_for":["routecodex-v4-plugin-catalog:architecture_stable","routecodex-v4-plugin-catalog:freeze"]},
    {"gate_id":"v4_parity_gate_plugin_plan","command":"node scripts/architecture/verify-v4-plugin-plan.mjs","required_for":["routecodex-v4-plugin-contract:architecture_stable","routecodex-v4-plugin-plan:architecture_stable","routecodex-v4-plugin-catalog:architecture_stable"]},
    {"gate_id":"v4_parity_gate_plugin_plan_red","command":"node scripts/architecture/verify-v4-plugin-plan.mjs --red-self-test","required_for":["routecodex-v4-plugin-plan:architecture_stable"]},
    {"gate_id":"v4_runtime_l2_regression","command":"cargo build --release --manifest-path Cargo.toml --locked -p routecodex-v4-skeleton && cargo run --quiet --release --manifest-path Cargo.toml -p routecodex-v4-build-link -- test-consumer --root . --consumer routecodex-v4-runtime --deps routecodex-v4-error,routecodex-v4-base-node,routecodex-v4-control --source-deps routecodex-v4-skeleton","required_for":["routecodex-v4-runtime:architecture_stable","routecodex-v4-runtime:freeze","routecodex-v4-runtime:active_link"]},
    {"gate_id":"v4_debug_l2_regression","command":"cargo run --quiet --release --manifest-path Cargo.toml -p routecodex-v4-build-link -- test-consumer --root . --consumer routecodex-v4-debug --deps routecodex-v4-base-node","required_for":["routecodex-v4-debug:architecture_stable","routecodex-v4-debug:freeze","routecodex-v4-debug:active_link"]},
    {"gate_id":"v4_router_l2_regression","command":"cargo run --quiet --release --manifest-path Cargo.toml -p routecodex-v4-build-link -- test-consumer --root . --consumer routecodex-v4-router --deps routecodex-v4-base-node","required_for":["routecodex-v4-router:architecture_stable","routecodex-v4-router:freeze","routecodex-v4-router:active_link"]},
    {"gate_id":"v4_provider_l2_regression","command":"cargo run --quiet --release --manifest-path Cargo.toml -p routecodex-v4-build-link -- test-consumer --root . --consumer routecodex-v4-provider --deps routecodex-v4-base-node","required_for":["routecodex-v4-provider:architecture_stable","routecodex-v4-provider:freeze","routecodex-v4-provider:active_link"]},
    {"gate_id":"v4_server_l2_regression","command":"cargo run --quiet --release --manifest-path Cargo.toml -p routecodex-v4-build-link -- test-consumer --root . --consumer routecodex-v4-server --deps routecodex-v4-base-node","required_for":["routecodex-v4-server:architecture_stable","routecodex-v4-server:freeze","routecodex-v4-server:active_link"]},
    {"gate_id":"v4_build_verify_positive","command":"node scripts/verify.mjs","required_for":["routecodex-v4-governance:architecture_stable"]},
    {"gate_id":"v4_build_verify_red","command":"node scripts/verify-red.mjs","required_for":["routecodex-v4-governance:architecture_stable"]},
    {"gate_id":"v4_build_verify_ci","command":"node scripts/verify-ci.mjs","required_for":["routecodex-v4-governance:architecture_stable","compile","promotion","freeze"]},
    {"gate_id":"v4_isolation_positive","command":"node scripts/verify-isolation.mjs","required_for":["routecodex-v4-governance:architecture_stable"]},
    {"gate_id":"v4_baseline_digest","command":"node scripts/architecture/verify-v4-feature-gap.mjs && node scripts/architecture/verify-v4-v3-resource-coverage.mjs && node scripts/architecture/verify-v4-relay-continuation.mjs","required_for":["routecodex-v4-skeleton:architecture_stable","routecodex-v4-runtime:architecture_stable"]},
    {"gate_id":"module_artifact_hash","command":"appsdk compile-module <project> --module <id>","required_for":["compile","architecture_stable","freeze"]},
    {"gate_id":"module_freeze","command":"appsdk freeze <project> --module <id>","required_for":["freeze"]},
    {"gate_id":"module_publish_active","command":"appsdk publish-active <project> --module <id> --version <version>","required_for":["active"]}
  ]
}
