{
  "schema_version": 1,
  "gates":[
    {"gate_id":"contract_valid","command":"appsdk verify <project>","required_for":["compile","promotion","freeze"]},
    {"gate_id":"sdk_pinned","command":"appsdk pin-lock <project> --binary \"$(command -v appsdk)\"","required_for":["compile","promotion","freeze"]},
    {"gate_id":"sdk_bundle_resources","command":"appsdk verify <project>","required_for":["compile","promotion","freeze","publish"]},
    {"gate_id":"global_sdk_only","command":"command -v appsdk && appsdk version && test -x \"$(command -v appsdk)\" && test \"sha256:$(shasum -a 256 \"$(command -v appsdk)\" | cut -d ' ' -f 1)\" = \"$(jq -r .digest <project>/.appsdk/sdk.lock)\" && appsdk verify <project>","required_for":["compile","promotion","freeze","publish"]},
    {"gate_id":"record_graph","command":"appsdk verify <project>","required_for":["architecture_stable","freeze","publish"]},
    {"gate_id":"vcs_clean","command":"appsdk verify <project>","required_for":["freeze"]},
    {"gate_id":"regression_report","command":"appsdk verify <project>","required_for":["freeze","frozen_integrity"]},
    {"gate_id":"v4_base_node_l0_regression","command":"cargo test -p routecodex-v4-base-node --test l0_base_node","required_for":["routecodex-v4-base-node:architecture_stable","routecodex-v4-base-node:freeze"]},
    {"gate_id":"v4_edge_l1_regression","command":"cargo test -p routecodex-v4-edge --test l1_edge","required_for":["routecodex-v4-edge:architecture_stable","routecodex-v4-edge:freeze"]},
    {"gate_id":"v4_control_l2_regression","command":"cargo test -p routecodex-v4-control --test l2_control","required_for":["routecodex-v4-control:architecture_stable","routecodex-v4-control:freeze"]},
    {"gate_id":"v4_error_l2_regression","command":"cargo test -p routecodex-v4-error --test l2_error","required_for":["routecodex-v4-error:architecture_stable","routecodex-v4-error:freeze"]},
    {"gate_id":"v4_error_compile_fail_regression","command":"cargo test -p routecodex-v4-error --doc","required_for":["routecodex-v4-error:architecture_stable","routecodex-v4-error:freeze"]},
    {"gate_id":"v4_config_l2_regression","command":"cargo test -p routecodex-v4-config --test l2_config","required_for":["routecodex-v4-config:architecture_stable","routecodex-v4-config:freeze"]},
    {"gate_id":"v4_cargo_workspace_build","command":"cargo build --release --manifest-path v4/Cargo.toml","required_for":["routecodex-v4-base-node:compile","routecodex-v4-edge:compile","routecodex-v4-control:compile","routecodex-v4-error:compile","routecodex-v4-config:compile"]},
    {"gate_id":"module_artifact_hash","command":"appsdk compile-module <project> --module <id>","required_for":["compile","architecture_stable","freeze"]},
    {"gate_id":"module_freeze","command":"appsdk freeze <project> --module <id>","required_for":["freeze"]},
    {"gate_id":"module_publish_active","command":"appsdk publish-active <project> --module <id> --version <version>","required_for":["active"]}
  ]
}
