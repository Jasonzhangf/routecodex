{
  "schema_version": 1,
  "gates":[
    {"gate_id":"contract_valid","command":"appsdk verify <project>","required_for":["compile","promotion","freeze"]},
    {"gate_id":"sdk_pinned","command":"appsdk pin-lock <project> --binary \"$(command -v appsdk)\"","required_for":["compile","promotion","freeze"]},
    {"gate_id":"sdk_bundle_resources","command":"appsdk verify <project>","required_for":["compile","promotion","freeze","publish"]},
    {"gate_id":"global_sdk_only","command":"command -v appsdk && appsdk version && test -x \"$(command -v appsdk)\" && test \"sha256:$(shasum -a 256 \"$(command -v appsdk)\" | cut -d ' ' -f 1)\" = \"$(jq -r .digest <project>/.appsdk/sdk.lock)\" && appsdk verify --admission <project>","required_for":["compile","promotion","freeze","publish"]},
    {"gate_id":"record_graph","command":"appsdk verify <project>","required_for":["architecture_stable","freeze","publish"]},
    {"gate_id":"vcs_clean","command":"appsdk verify <project>","required_for":["freeze"]},
    {"gate_id":"regression_report","command":"appsdk verify <project>","required_for":["freeze","frozen_integrity"]},
    {"gate_id":"v4_base_node_l0_regression","command":"cargo test -p routecodex-v4-base-node --test l0_base_node","required_for":["routecodex-v4-base-node:architecture_stable","routecodex-v4-base-node:freeze"]},
    {"gate_id":"v4_edge_l1_regression","command":"cargo run --quiet --release --manifest-path v4/Cargo.toml -p routecodex-v4-build-link -- test-consumer --root v4 --consumer routecodex-v4-edge --deps routecodex-v4-base-node","required_for":["routecodex-v4-edge:architecture_stable","routecodex-v4-edge:freeze","routecodex-v4-edge:active_link"]},
    {"gate_id":"v4_control_l2_regression","command":"cargo run --quiet --release --manifest-path v4/Cargo.toml -p routecodex-v4-build-link -- test-consumer --root v4 --consumer routecodex-v4-control --deps routecodex-v4-base-node","required_for":["routecodex-v4-control:architecture_stable","routecodex-v4-control:freeze","routecodex-v4-control:active_link"]},
    {"gate_id":"v4_error_l2_regression","command":"cargo run --quiet --release --manifest-path v4/Cargo.toml -p routecodex-v4-build-link -- test-consumer --root v4 --consumer routecodex-v4-error --deps routecodex-v4-base-node","required_for":["routecodex-v4-error:architecture_stable","routecodex-v4-error:freeze","routecodex-v4-error:active_link"]},
    {"gate_id":"v4_error_compile_fail_regression","command":"cargo test -p routecodex-v4-build-link --test resolver_red_tests negative_error_classify_without_witness_compile_fails --manifest-path v4/Cargo.toml","required_for":["routecodex-v4-error:architecture_stable","routecodex-v4-error:freeze","routecodex-v4-error:active_link"]},
    {"gate_id":"v4_config_l2_regression","command":"cargo run --quiet --release --manifest-path v4/Cargo.toml -p routecodex-v4-build-link -- test-consumer --root v4 --consumer routecodex-v4-config --deps routecodex-v4-base-node,routecodex-v4-edge","required_for":["routecodex-v4-config:architecture_stable","routecodex-v4-config:freeze"]},
    {"gate_id":"v4_cargo_workspace_build","command":"cargo build --release --manifest-path v4/Cargo.toml","required_for":["routecodex-v4-base-node:compile","routecodex-v4-build-link:compile"]},
    {"gate_id":"v4_active_link_resolver","command":"cargo test -p routecodex-v4-build-link --manifest-path v4/Cargo.toml","required_for":["routecodex-v4-build-link:architecture_stable","routecodex-v4-edge:active_link"]},
    {"gate_id":"v4_active_index_verify","command":"cargo run --quiet --release --manifest-path v4/Cargo.toml -p routecodex-v4-build-link -- verify-index --root v4","required_for":["routecodex-v4-build-link:architecture_stable","routecodex-v4-edge:active_link"]},
    {"gate_id":"v4_frozen_source_edge_forbidden","command":"node scripts/architecture/verify-v4-active-link.mjs","required_for":["routecodex-v4-edge:architecture_stable","routecodex-v4-edge:freeze"]},
    {"gate_id":"v4_parity_gate_semantic_parity","command":"node scripts/architecture/verify-v4-semantic-parity.mjs","required_for":["routecodex-v4-skeleton:architecture_stable","routecodex-v4-runtime:architecture_stable"]},
    {"gate_id":"v4_parity_gate_skeleton_topology","command":"node scripts/architecture/verify-v4-skeleton-topology.mjs","required_for":["routecodex-v4-skeleton:architecture_stable"]},
    {"gate_id":"v4_parity_gate_plane_isolation","command":"node scripts/architecture/verify-v4-plane-isolation.mjs","required_for":["routecodex-v4-skeleton:architecture_stable","routecodex-v4-runtime:architecture_stable"]},
    {"gate_id":"v4_parity_gate_execution_binding","command":"node scripts/architecture/verify-v4-execution-binding.mjs","required_for":["routecodex-v4-runtime:architecture_stable"]},
    {"gate_id":"v4_parity_gate_capability_isolation","command":"node scripts/architecture/verify-v4-capability-isolation.mjs","required_for":["routecodex-v4-skeleton:architecture_stable","routecodex-v4-runtime:architecture_stable"]},
    {"gate_id":"v4_parity_gate_v3_resource_coverage","command":"node scripts/architecture/verify-v4-v3-resource-coverage.mjs","required_for":["routecodex-v4-skeleton:architecture_stable","routecodex-v4-runtime:architecture_stable"]},
    {"gate_id":"v4_parity_gate_resource_binding","command":"node scripts/architecture/verify-v4-resource-binding.mjs","required_for":["routecodex-v4-skeleton:architecture_stable","routecodex-v4-runtime:architecture_stable"]},
    {"gate_id":"v4_compat_gate_responses_direct","command":"node scripts/architecture/verify-v4-responses-direct-compat.mjs","required_for":["routecodex-v4-runtime:architecture_stable"]},
    {"gate_id":"v4_skeleton_l0_regression","command":"cargo test -p routecodex-v4-skeleton --manifest-path v4/Cargo.toml","required_for":["routecodex-v4-skeleton:architecture_stable","routecodex-v4-skeleton:freeze"]},
    {"gate_id":"v4_runtime_l2_regression","command":"cargo build --release --manifest-path v4/Cargo.toml -p routecodex-v4-skeleton && cargo run --quiet --release --manifest-path v4/Cargo.toml -p routecodex-v4-build-link -- test-consumer --root v4 --consumer routecodex-v4-runtime --deps routecodex-v4-error,routecodex-v4-base-node,routecodex-v4-control --source-deps routecodex-v4-skeleton","required_for":["routecodex-v4-runtime:architecture_stable","routecodex-v4-runtime:freeze","routecodex-v4-runtime:active_link"]},
    {"gate_id":"module_artifact_hash","command":"appsdk compile-module <project> --module <id>","required_for":["compile","architecture_stable","freeze"]},
    {"gate_id":"module_freeze","command":"appsdk freeze <project> --module <id>","required_for":["freeze"]},
    {"gate_id":"module_publish_active","command":"appsdk publish-active <project> --module <id> --version <version>","required_for":["active"]}
  ]
}
