{
  "$id": "https://appsdk.local/contracts/records/pre-review-validation-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "artifact_hash": {
      "type": "string"
    },
    "blackbox_evidence_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "candidate_commit": {
      "type": "string"
    },
    "candidate_tree_hash": {
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "deployment": {
      "description": "Receipt presence follows module.deployment_operations; every supplied receipt is validated.",
      "properties": {
        "entrypoint": {
          "minLength": 1,
          "type": "string"
        },
        "environment_id": {
          "minLength": 1,
          "type": "string"
        },
        "install_receipt_id": {
          "minLength": 1,
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "type": "string"
        },
        "producer": {
          "properties": {
            "adapter": {
              "minLength": 1,
              "type": "string"
            },
            "identity": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "adapter",
            "identity"
          ],
          "type": "object"
        },
        "restart_receipt_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "environment_id",
        "entrypoint",
        "producer",
        "observed_at"
      ],
      "type": "object"
    },
    "fix_candidate_id": {
      "type": "string"
    },
    "issue_id": {
      "type": "string"
    },
    "module_id": {
      "type": "string"
    },
    "result": {
      "const": "pass"
    },
    "source_unchanged": {
      "const": true
    },
    "validation_id": {
      "type": "string"
    },
    "whitebox_evidence_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "whitebox_producer": {
      "properties": {
        "adapter": {
          "minLength": 1,
          "type": "string"
        },
        "identity": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "adapter",
        "identity"
      ],
      "type": "object"
    }
  },
  "required": [
    "validation_id",
    "issue_id",
    "module_id",
    "fix_candidate_id",
    "candidate_commit",
    "candidate_tree_hash",
    "artifact_hash",
    "whitebox_producer",
    "whitebox_evidence_ids",
    "blackbox_evidence_ids",
    "deployment",
    "source_unchanged",
    "result",
    "created_at"
  ],
  "type": "object"
}
