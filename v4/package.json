{
  "name": "routecodex-v4",
  "version": "0.1.0",
  "private": true,
  "description": "RouteCodex V4 self-contained build domain: local Node/Rust locks, canonical build/test/verify entrypoints, and V4-owned architecture gates.",
  "type": "module",
  "engines": {
    "node": ">=20 <26"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "install:global": "node scripts/install-rccv4.mjs",
    "test": "node scripts/test.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:red": "node scripts/verify-red.mjs",
    "verify:ci": "node scripts/verify-ci.mjs",
    "verify:isolation": "node scripts/verify-isolation.mjs",
    "verify:v4-active-link": "node scripts/architecture/verify-v4-active-link.mjs",
    "verify:v4-relay-continuation": "node scripts/architecture/verify-v4-relay-continuation.mjs",
    "verify:v4-feature-layer-batches": "node scripts/architecture/verify-v4-feature-layer-batches.mjs",
    "verify:v4-feature-layer-batches-self-test": "node scripts/architecture/verify-v4-feature-layer-batches.mjs --self-test",
    "verify:v4-feature-layer-batches-admission": "node scripts/architecture/verify-v4-feature-layer-batches.mjs --admission",
    "verify:v4-feature-layer-batches-boundary": "node scripts/architecture/verify-v4-feature-layer-batches.mjs --boundary-self-test",
    "verify:v4-feature-layer-batches-red": "node scripts/architecture/verify-v4-feature-layer-batches.mjs --red-self-test",
    "verify:v4-node-graph": "node scripts/architecture/verify-v4-node-graph.mjs",
    "verify:v4-node-graph-red": "node scripts/architecture/verify-v4-node-graph.mjs --red-self-test",
    "verify:v4-infrastructure": "node scripts/architecture/verify-v4-infrastructure.mjs",
    "verify:v4-infrastructure-red": "node scripts/architecture/verify-v4-infrastructure.mjs --red-self-test",
    "verify:v4-cordis-concurrency-reconciliation": "node scripts/verify-v4-cordis-concurrency-reconciliation.mjs",
    "verify:v4-cordis-concurrency-reconciliation-red": "node scripts/verify-v4-cordis-concurrency-reconciliation.mjs --red-self-test",
    "verify:v4-foundation": "node scripts/verify.mjs",
    "verify:v4-foundation-red": "node scripts/verify-red.mjs",
    "test:cordis-host": "cargo build --manifest-path Cargo.toml -p routecodex-v4-node-container --bin routecodex-v4-node-container-host --locked && node --test cordis/routecodex-v4-cordis-host/tests/*.test.mjs"
  },
  "dependencies": {
    "cordis": "^4.0.0-rc.8",
    "js-yaml": "^4.1.0"
  }
}
