    "semantics": {
      "flow": "source_raised -> host_captured -> runtime_classified -> router_policy_applied -> execution_decision -> client_projected",
      "frozen": true,
      "single_kernel": "V4Error01SourceRaised",
      "single_terminal": "V4Error06ClientProjected",
      "witness_required": "V4Error02HostCaptured -> V4Error03RuntimeClassified requires an opaque ErrorCenter witness bound to the exact ErrorFact lineage",
      "terminal": "V4Error06ClientProjected",
      "owner": "routecodex-v4-error"
    }
  },
  "hook_queue_schema": {
    "required": ["hook_id", "node_id", "kind", "position", "owner", "effect", "resources_read", "resources_written", "control_record_required"],
    "kinds": ["entry", "exit"],
    "effects": ["read_only", "control_only", "semantic"],
    "rules": [
      "entry hooks run before operator in position order",
      "exit hooks run after operator in position order",
      "hooks are not operators and cannot create a second lifecycle or shortcut nodes",
      "hooks must be machine declared; undeclared hooks cannot execute",
      "control in/out requires ControlRecord",
      "debug/snapshot subscriptions are read-only",
      "hook failure enters the error chain explicitly; no fallback"
    ],
    "servertool_exception": {
      "rule": "servertool uses control_only hooks at chat process group entry/exit",
      "req04_injection": "allowed_registered_only",
      "resp03_stripping": "allowed_matching_provenance_only",
      "history_mutation": "forbidden",
      "continuation_immutable_interval_semantics": "forbidden"
    }
  },
  "group_schema": {
    "required": [
      "group_id",
      "group_kind",
      "chain",
      "chain_version",
      "node_id",
      "position",
      "external_interface",
      "entry_node",
      "exit_node",
      "nodes",
      "edges"
    ],
    "external_interface_required": [
      "data_in",
      "data_out",
      "control_in",
      "control_out",
      "control_record_required",
      "debug_subscriptions",
      "snapshot_subscriptions"
    ],
    "rules": [
      "group external interface equals NodeInstance interface",
      "exactly one entry_node and one exit_node",
      "external data_in equals entry node data_in; external data_out equals exit node data_out",
      "parent chain only connects to group entry/exit; internal nodes are not visible to parent",
      "group is not a second lifecycle; errors still enter parent error chain",
      "internal implementation is replaceable while external interface is unchanged",
      "expansion must be semantically equivalent"
    ]
  },
  "pipeline_lifecycle": {
    "chain_must_have": [
      "single entry node",
      "single terminal node",
      "declared adjacent edges entry-to-terminal",
      "explicit error path into error chain"
    ],
    "test_semantics": {
      "layers": {
        "L0_base_node": [
          "base_node_control_in_out_record",
          "base_node_debug_subscription_read_only",
          "base_node_snapshot_subscription_diagnostic",
          "base_node_statistics_observability_only",
          "base_node_debug_switch_diagnostic_only",
          "base_node_dry_run_support",
          "base_node_error_intake_typed",
          "base_node_hook_queue_contract",
          "base_node_no_business_logic"
        ],
        "L1_edge": [
          "edge_data_flow_adjacent_only",
          "edge_data_flow_resource_axis",
          "edge_information_flow_adjacent_only",
          "edge_information_flow_resource_axis",
          "edge_control_flow_record_required",
          "edge_control_flow_scope_isolation",
          "edge_debug_subscription_read_only",
          "edge_error_intake_typed",
          "edge_forbidden_edges"
        ],
        "L2_module": [
          "node_entry_contract",
          "node_exit_contract",
          "node_success_projection",
          "node_error_projection",
          "node_control_record",
          "node_debug_switch_diagnostic_only",
          "node_error_intake_typed",
          "chain_entry_contract",
          "chain_terminal_contract",
          "chain_edge_complete",
          "chain_error_path",
          "group_external_contract",
          "group_internal_wiring",
          "group_no_shortcut",
          "group_expansion_equivalence"
        ]
      },
      "chain_tests": [
        "chain_entry_contract",
        "chain_terminal_contract",
        "chain_edge_complete",
        "chain_error_path",
        "chain_group_equivalence"
      ],
      "node_tests": [
        "node_entry_contract",
        "node_exit_contract",
        "node_success_projection",
        "node_error_projection",
        "node_control_record",
        "node_debug_subscription_read_only",
        "node_statistics_optional",
        "node_debug_switch_diagnostic_only",
        "node_error_intake_typed",
        "node_route_exit_consumer",
        "node_payload_cycle_boundary"
      ],
      "group_tests": [
        "group_external_contract",
        "group_internal_wiring",
        "group_no_shortcut",
        "group_no_second_lifecycle",
        "group_encapsulation",
        "group_expansion_equivalence"
      ]
    },
    "freeze_order": {
      "rule": "L0 BaseNode tests pass -> freeze BaseNode; L1 edge tests pass -> freeze edge contracts; L2 module tests pass -> freeze module",
      "layer_dependency": "upper layers depend on frozen lower layers only; lower layers never depend on derived module implementations",
      "freeze_scope": "freeze locks contract and implementation baseline; registered operators remain extensible on frozen node slots"
    }
  },
  "base_node_capabilities": [
    "control_in",
    "control_out",
    "control_record",
    "debug_subscriptions",
    "snapshot_subscriptions",
    "statistics_optional",
    "debug_switch",
    "dry_run_support",
    "error_intake",
    "hook_queue"
  ],
  "edge_kinds": ["data_flow", "information_flow", "control_flow", "debug_subscription", "error_intake"],
  "edges": {
    "data_flow": {
      "required": ["edge_id", "kind", "chain", "chain_version", "from", "to", "data_in", "data_out", "owner", "adjacent_required"],
      "rule": "only adjacent nodes; resources must be data-axis; one data_in and one data_out per node"
    },
    "information_flow": {
      "required": ["edge_id", "kind", "chain", "chain_version", "from", "to", "info_in", "info_out", "owner", "adjacent_required"],
      "rule": "only adjacent nodes on data_plane=false chains (config/lifecycle/diagnostic); resources must be information-axis; no control or data resource may travel an information edge"
    },
    "control_flow": {
      "required": ["edge_id", "kind", "chain", "chain_version", "from", "to", "operation", "control_key", "scope_keys", "owner", "record_required"],
      "operations": ["register", "consume", "release"],
      "rule": "record_required must be true; scope isolation enforced; control never enters data axis; release owned by registering node"
    },
    "debug_subscription": {
      "required": ["edge_id", "kind", "chain", "chain_version", "from", "to", "topic", "direction", "read_only", "owner"],
      "topics": ["node_event", "state_transition", "diagnostic"],
      "snapshot_topics": ["node_entry", "node_exit", "node_error"],
      "rule": "read_only must be true; no payload; no decision influence"
    },
    "error_intake": {
      "required": ["edge_id", "kind", "chain", "chain_version", "from", "to", "error_stage", "payload_hash", "typed_context", "owner", "record_required"],
      "rule": "any node/operator/hook error enters v4.control.error_center as typed error facts plus payload hash and typed context; the center classifies and audits only; route decision belongs to v4.control.route_exit; original payload is immutable across switch/cooldown/reroute"
    }
  },
  "error_center": {
    "contract_id": "v4-error-center",
    "role": "classify_and_audit_only",
    "intake": "typed error facts from any node/operator/hook via error_intake edge; payload_hash_and_typed_context_only",
    "output": "immutable classify audit record plus opaque fact-lineage-bound single-use witness; classified facts are consumed by v4.control.route_exit decision owner",
    "forbidden": [
      "route operation",
      "retry/cooldown/reroute execution",
      "provider_local_retry_policy",
      "payload rewrite",
      "fallback",
      "provider wire write",
      "client wire write"
    ],
    "rule": "error center never makes routing decisions; it validates a HostCaptured fact with non-empty payload_hash and typed_context, emits an opaque fact-lineage-bound single-use witness, and VR owns the decision using classified error facts and the original request payload reference"
  },
  "route_exit": {
    "contract_id": "v4-route-control-exit",
    "role": "typed route decision output boundary",
    "owner": "routecodex-v4-router",
    "inputs": ["v4.control.route_facts", "v4.control.error_center classified facts", "v4.lifecycle.payload_cycle"],
    "outputs": ["v4.control.route_exit decision"],
    "consumers": ["V4ReqOutbound05ProviderSemantic", "V4Error04RouterPolicyApplied"],
    "forbidden": [
      "payload patch",
      "provider wire write",
      "client wire write",
      "error center route operation",
      "original payload mutation"
    ],
    "rule": "switch/cooldown/reroute are all decisions emitted from this exit and remain inside the same request payload cycle"
  },
  "payload_cycle": {
    "contract_id": "v4-payload-cycle",
    "role": "original request/response payload lifecycle registry",
    "cycle_start": "request_sent",
    "success_terminal": "response entered client; the next request begins a new cycle",
    "error_terminal": "error terminal only; switch/cooldown/reroute are merged into the same cycle",
    "original_payload": "immutable within a cycle; retries re-execute the same original payload",
    "forbidden": ["payload mutation", "cross-cycle reuse", "control fields in payload", "payload reconstruction from control state"]
  },
  "module_debug_switch": {
    "contract_id": "v4-module-debug-switch",
    "scope": ["module_id", "node_id", "chain_version", "scope"],
    "kinds": ["debug", "snapshot", "dry_run", "route_probe"],
