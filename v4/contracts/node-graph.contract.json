  "v4_hub_response_chain": {
    "chain_version": "v4-hub-1",
    "mirror_of": "v4_hub_request_chain",
    "nodes": [
      {"position": 1, "node_id": "V4ProviderSseIn01FrameBoundary", "role_id": "response_inbound", "data_plane": "sse_frame_to_json"},
      {"position": 2, "node_id": "V4HubRespInbound02Parsed", "role_id": "response_inbound", "data_plane": "json_semantic"},
      {"position": 3, "node_id": "V4HubRespChatProcess03Governed", "role_id": "response_chat_process", "group": true, "data_plane": "json_semantic"},
      {"position": 4, "node_id": "V4HubRespOutbound04ClientSemantic", "role_id": "response_outbound", "data_plane": "json_semantic"},
      {"position": 5, "node_id": "V4ServerSseOut05FrameBoundary", "role_id": "response_outbound", "data_plane": "json_to_sse_frame"},
      {"position": 6, "node_id": "V4ServerRespOutbound06ClientFrame", "role_id": "response_outbound", "data_plane": "client_frame"}
    ],
    "semantics": {
      "flow": "provider_sse -> inbound -> chat_process(group) -> outbound -> client_sse -> server",
      "sse_boundary_only": true,
      "internal_data_plane": "json_semantic",
      "sse_in_sse_out_coupling": "forbidden; provider SSE must not pipe directly to client SSE",
      "chat_process": "supernode group with continuation save, response governance, tool harvest, and entry/exit hooks for servertool",
      "continuation_save_only_at": "V4HubRespChatProcess03Governed",
      "immutable_interval": "resp_chatprocess save -> next req_chatprocess restore; no semantic transformation in between",
      "terminal": "V4ServerRespOutbound06ClientFrame is the single success terminal",
      "direct_also_uses_chain": true
    }
  },
