      {"position": 3, "node_id": "V4Error03RuntimeClassified", "role_id": "error_classify", "control_plane": "runtime_classified"},
      {"position": 4, "node_id": "V4Error04RouterPolicyApplied", "role_id": "error_policy", "control_plane": "router_policy_applied"},
      {"position": 5, "node_id": "V4Error05ExecutionDecision", "role_id": "error_decision", "control_plane": "execution_decision"},
      {"position": 6, "node_id": "V4Error06ClientProjected", "role_id": "error_projection", "control_plane": "client_projected"}
