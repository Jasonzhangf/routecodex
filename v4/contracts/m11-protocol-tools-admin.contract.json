    "provider_or_client_payload_reconstruction": "forbidden",
    "secret_material": "handle_only"
  },
  "failure_policy": {
    "fail_fast": true,
    "fallback": "forbidden",
    "silent_strip": "forbidden",
    "payload_reconstruction": "forbidden",
    "automatic_rollback": "forbidden",
    "unknown_lane_or_operation": "explicit_error"
