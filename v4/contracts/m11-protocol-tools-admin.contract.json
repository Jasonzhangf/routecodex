        "v4.response.normal_payload"
      ],
      "invariants": [
        "entry_protocol_is_typed_and_locked",
        "protocol_shape_is_preserved",
        "tool_and_reasoning_fields_are_not_downgraded_to_text",
        "provider_specific_policy_is_not_added_to_hub_contract"
      ]
    },
    {
      "lane_id": "tools",
      "status": "planned",
      "owner_module_id": "routecodex-v4-standard-plugins",
      "existing_owner_function_id": "v4.plugin.standard_library",
