{
  "$defs": {
    "path_receipt": {
      "properties": {
        "artifact_hash": {
          "type": "string"
        },
        "challenge": {
          "type": "string"
        },
        "endpoint_generation": {
          "minimum": 1,
          "type": "integer"
        },
        "entrypoint": {
          "type": "string"
        },
        "environment_id": {
          "type": "string"
        },
        "evidence_id": {
          "type": "string"
        },
        "message_id": {
          "type": "string"
        },
        "observed_at": {
          "type": "string"
        },
        "receiver": {
          "enum": [
            "peer",
            "master"
          ]
        },
        "sender": {
          "enum": [
            "peer",
            "master",
            "daemon"
          ]
        },
        "source_commit": {
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "message_id",
        "challenge",
        "sender",
        "receiver",
        "source_commit",
        "artifact_hash",
        "environment_id",
        "entrypoint",
        "endpoint_generation",
        "observed_at"
      ],
      "type": "object"
    }
  },
  "$id": "https://appsdk.local/contracts/records/collab-live-closure-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "artifact_hash": {
      "type": "string"
    },
    "closure_id": {
      "type": "string"
    },
    "collab_identity": {
      "properties": {
        "app_scope_id": {
          "type": "string"
        },
        "binding_id": {
          "type": "string"
        },
        "native_thread_id": {
          "type": "string"
        },
        "project_scope_id": {
          "type": "string"
        },
        "worker_id": {
          "type": "string"
        }
      },
      "required": [
        "worker_id",
        "binding_id",
        "native_thread_id",
        "app_scope_id",
        "project_scope_id"
      ],
      "type": "object"
    },
    "created_at": {
      "type": "string"
    },
    "entrypoint": {
      "type": "string"
    },
    "environment_id": {
      "type": "string"
    },
    "evidence_ids": {
      "additionalProperties": false,
      "properties": {
        "daemon_to_master": {
          "type": "string"
        },
        "daemon_to_peer": {
          "type": "string"
        },
        "master_to_master": {
          "type": "string"
        },
        "master_to_peer": {
          "type": "string"
        },
        "peer_to_master": {
          "type": "string"
        },
        "peer_to_peer": {
          "type": "string"
        },
        "restart_replay": {
          "type": "string"
        }
      },
      "required": [
        "peer_to_peer",
        "peer_to_master",
        "master_to_peer",
        "master_to_master",
        "daemon_to_peer",
        "daemon_to_master",
        "restart_replay"
      ],
      "type": "object"
    },
    "fix_candidate_id": {
      "type": "string"
    },
    "issue_id": {
      "type": "string"
    },
    "module_id": {
      "type": "string"
    },
    "path_receipts": {
      "additionalProperties": false,
      "properties": {
        "daemon_to_master": {
          "$ref": "#/$defs/path_receipt"
        },
        "daemon_to_peer": {
          "$ref": "#/$defs/path_receipt"
        },
        "master_to_master": {
          "$ref": "#/$defs/path_receipt"
        },
        "master_to_peer": {
          "$ref": "#/$defs/path_receipt"
        },
        "peer_to_master": {
          "$ref": "#/$defs/path_receipt"
        },
        "peer_to_peer": {
          "$ref": "#/$defs/path_receipt"
        },
        "restart_replay": {
          "$ref": "#/$defs/path_receipt"
        }
      },
      "required": [
        "peer_to_peer",
        "peer_to_master",
        "master_to_peer",
        "master_to_master",
        "daemon_to_peer",
        "daemon_to_master",
        "restart_replay"
      ],
      "type": "object"
    },
    "route_receipt": {
      "properties": {
        "daemon_live": {
          "const": true
        },
        "endpoint_generation": {
          "minimum": 1,
          "type": "integer"
        },
        "resolved_at": {
          "type": "string"
        },
        "route_scope": {
          "properties": {
            "app_scope_id": {
              "type": "string"
            },
            "project_scope": {
              "type": "string"
            }
          },
          "required": [
            "project_scope",
            "app_scope_id"
          ],
          "type": "object"
        },
        "source": {
          "const": "collab_cli"
        },
        "storage_root": {
          "type": "string"
        }
      },
      "required": [
        "daemon_live",
        "endpoint_generation",
        "route_scope",
        "storage_root",
        "resolved_at",
        "source"
      ],
      "type": "object"
    },
    "scope_hash": {
      "type": "string"
    },
    "source_commit": {
      "type": "string"
    }
  },
  "required": [
    "closure_id",
    "issue_id",
    "module_id",
    "fix_candidate_id",
    "artifact_hash",
    "scope_hash",
    "source_commit",
    "environment_id",
    "entrypoint",
    "collab_identity",
    "route_receipt",
    "evidence_ids",
    "path_receipts",
    "created_at"
  ],
  "type": "object"
}
