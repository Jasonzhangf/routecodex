{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v4://contracts/execution-epoch-bundle.schema.json",
  "title": "V4 ExecutionEpochBundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "epoch_id", "manifest_hash", "graph_hash", "plugin_artifact_set_hash", "entrypoints", "pipelines", "nodes", "policies"],
  "properties": {
    "schema_version": {"const": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "epoch_id": {"type": "string", "minLength": 1},
    "manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "graph_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "plugin_artifact_set_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "entrypoints": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}, "minProperties": 1},
    "pipelines": {"type": "object", "required": ["request", "response", "error"], "additionalProperties": false, "properties": {"request": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "response": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "error": {"type": "array", "items": {"type": "string"}, "minItems": 1}}},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
    "policies": {"type": "object", "additionalProperties": {"type": "object"}}
  },
  "$defs": {"node": {"type": "object", "additionalProperties": false, "required": ["node_id", "plan_hash", "input_resource", "output_resource", "allowed_edges", "plugins"], "properties": {"node_id": {"type": "string", "minLength": 1}, "plan_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "input_resource": {"type": "string", "minLength": 1}, "output_resource": {"type": "string", "minLength": 1}, "allowed_edges": {"type": "array", "items": {"type": "string"}}, "plugins": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["plugin_id", "version", "artifact_hash", "config_hash"], "properties": {"plugin_id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "artifact_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "config_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}}}}}
}
