{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v4://contracts/cordis-runtime-control.schema.json",
  "title": "V4 Cordis Runtime Control",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "command_id", "generation", "correlation_id", "payload_hash"],
  "properties": {"schema_version": {"const": 1}, "kind": {"enum": ["PrepareEpoch", "CommitEpoch", "AbortEpoch", "DrainEpoch", "RollbackEpoch", "Shutdown", "QueryActiveEpoch", "QueryNodeState", "EpochPrepared", "EpochActivated", "EpochRejected", "EpochDraining", "EpochDrained", "PluginExecutionFailed", "ProviderAvailabilityChanged", "RequestTerminal", "CordisReconciled", "NodeEntered", "NodeExited", "PluginTiming", "PayloadDigest", "StreamFrameCount"]}, "command_id": {"type": "string", "minLength": 1}, "generation": {"type": "integer", "minimum": 0}, "base_epoch": {"type": "integer", "minimum": 0}, "candidate_id": {"type": "string", "minLength": 1}, "epoch_id": {"type": "string", "minLength": 1}, "expected_base_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "correlation_id": {"type": "string", "minLength": 1}, "payload_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "payload": {"type": "object"}}
}
