{
  "active_artifact": "active/lib/routecodex-v4-edge/**",
  "artifact_paths": [
    "libroutecodex_v4_edge.rlib"
  ],
  "build": {
    "args": [
      "-c",
      "cargo run --quiet --release -p routecodex-v4-build-link -- build-consumer --root . --consumer routecodex-v4-edge --deps routecodex-v4-base-node --out generated/modules/routecodex-v4-edge/lib/libroutecodex_v4_edge.rlib"
    ],
    "program": "sh",
    "working_directory": "."
  },
  "contract_paths": [
    "contracts/node-graph.contract.json",
    "contracts/data-control-boundary.contract.json"
  ],
  "dependency_modules": [
    "routecodex-v4-base-node"
  ],
  "generated_outputs": [
    "generated/modules/routecodex-v4-edge/**"
  ],
  "module_id": "routecodex-v4-edge",
  "owned_paths": [
    "crates/routecodex-v4-edge/**"
  ],
  "regression": {
    "allow_skipped": false,
    "command": {
      "args": [
        "test",
        "-p",
        "routecodex-v4-edge",
        "--locked"
      ],
      "program": "cargo",
      "working_directory": "."
    },
    "input_paths": [
      "crates/routecodex-v4-edge/**",
      "contracts/**"
    ],
    "minimum_test_count": 1,
    "ordinary_mode_after_freeze": "disabled",
    "reenable_on": [
      "source_change",
      "contract_change",
      "public_api_change",
      "artifact_change",
      "dependency_change"
    ],
    "required_before_freeze": true,
    "suite_id": "v4-edge-regression"
  },
  "source_owner": "routecodex-v4-edge",
  "stage": "frozen"
}
