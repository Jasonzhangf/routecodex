   647	    }
   648	    let protocol = match provider_type {
   649	        "openai_chat" => "openai-chat",
   650	        _ => RESPONSES_WIRE_PROTOCOL_NAME,
   651	    };
   652	    let tools = tools.clone();
   653	    let mut expanded = Vec::with_capacity(tools.len());
   654	    let mut namespace_name_map = HashMap::new();
   655	    for tool in tools {
   656	        if tool.get("type").and_then(Value::as_str) == Some("namespace") {
   657	            let namespace_name = tool
   658	                .get("name")
   659	                .and_then(Value::as_str)
   660	                .map(str::trim)
   661	                .filter(|value| !value.is_empty());
   662	            if let (Some(namespace_name), Some(children)) =
   663	                (namespace_name, tool.get("tools").and_then(Value::as_array))
