   805	fn validate_provider_wire_tool_names(
   806	    request_id: &str,
   807	    body: &Value,
   808	) -> Result<(), V3ProviderError> {
   809	    fn walk(request_id: &str, value: &Value, path: &str) -> Result<(), V3ProviderError> {
   810	        match value {
   811	            Value::Object(object) => {
   812	                let kind = object.get("type").and_then(Value::as_str);
   813	                if matches!(
   814	                    kind,
   815	                    Some("function_call" | "custom_tool_call" | "tool_use")
   816	                ) {
   817	                    if let Some(name) = object.get("name").and_then(Value::as_str) {
   818	                        if !is_provider_wire_tool_name(name) {
   819	                            return Err(V3ProviderError::FunctionToolShapeFailed {
   820	                                request_id: request_id.to_owned(),
   821	                                detail: format!(
   822	                                    "{path}.name must match ^[a-zA-Z0-9_-]+$: {name:?}"
   823	                                ),
   824	                            });
   825	                        }
   826	                    }
   827	                }
   828	                if kind == Some("function") {
   829	                    if let Some(function) = object.get("function").and_then(Value::as_object) {
   830	                        if let Some(name) = function.get("name").and_then(Value::as_str) {
   831	                            if !is_provider_wire_tool_name(name) {
   832	                                return Err(V3ProviderError::FunctionToolShapeFailed {
   833	                                    request_id: request_id.to_owned(),
   834	                                    detail: format!(
   835	                                        "{path}.function.name must match ^[a-zA-Z0-9_-]+$: {name:?}"
   836	                                    ),
   837	                                });
   838	                            }
   839	                        }
   840	                    }
   841	                }
   842	                for (key, child) in object {
   843	                    walk(request_id, child, &format!("{path}.{key}"))?;
   844	                }
   845	            }
   846	            Value::Array(items) => {
   847	                for (index, child) in items.iter().enumerate() {
   848	                    walk(request_id, child, &format!("{path}[{index}]"))?;
   849	                }
   850	            }

