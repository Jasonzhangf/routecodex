- feature_id: v3.provider_response_error_policy_closeout
  status: implementation_in_progress
  change_risk: critical
  owner_kind: rust_v3_provider_terminal_response_error_policy
  owner_scope: Provider terminal JSON/materialized SSE classification through the existing Error01-06 and provider-action-gate path before provider-success record and Resp04 continuation commit.
  owner_modules:
  - v3/crates/routecodex-v3-config
  - v3/crates/routecodex-v3-runtime
