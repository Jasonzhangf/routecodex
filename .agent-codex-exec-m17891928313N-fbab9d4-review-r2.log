   380	pub fn project_v3_current_turn_entries_from_value(request: &Value) -> V3CurrentTurnEntries {
   381	    if let Some(messages) = request.get("messages").and_then(value_as_array) {
   382	        if !messages.is_empty() {
   383	            return V3CurrentTurnEntries::Chat(project_chat_entries(&messages));
   384	        }
   385	    }
   386	    if let Some(input) = request.get("input") {
   387	        let entries = project_responses_entries(input);
   388	        if !entries.is_empty() {
   389	            return V3CurrentTurnEntries::Responses(entries);
   390	        }
   391	    }
   392	    if let Some(contents) = request.get("contents").and_then(value_as_array) {
   393	        if !contents.is_empty() {
   394	            return V3CurrentTurnEntries::Gemini(project_gemini_entries(&contents));
   395	        }
   396	    }
   397	    if let Some(prompt) = request
   398	        .get("prompt")
   399	        .and_then(Value::as_str)
   400	        .map(str::trim)
   401	        .filter(|text| !text.is_empty())
   402	    {
   403	        return V3CurrentTurnEntries::PromptText(prompt.to_string());
   404	    }
   405	    if let Some(input) = request
   406	        .pointer("/semantics/responses/context/input")
   407	        .and_then(value_as_array)
   408	    {
   409	        if !input.is_empty() {
   410	            return V3CurrentTurnEntries::Responses(project_responses_entries_from_array(&input));
   411	        }
   412	    }
   413	    V3CurrentTurnEntries::Empty
   414	}
   415	
   416	fn project_chat_entries(messages: &[Value]) -> Vec<ChatTurnEntry> {
   417	    messages
   418	        .iter()
   419	        .map(|message| ChatTurnEntry {
   420	            role: chat_role(message.get("role").and_then(Value::as_str)),
   421	            parts: project_chat_parts(message.get("content")),
   422	            tool_calls: project_chat_tool_calls(message.get("tool_calls")),
   423	        })
   424	        .collect()
   425	}
   426	
   427	fn project_chat_tool_calls(value: Option<&Value>) -> Vec<ChatToolCall> {
   428	    let Some(items) = value.and_then(Value::as_array) else {
   429	        return Vec::new();
   430	    };
   431	    items
   432	        .iter()
   433	        .map(|item| ChatToolCall {
   434	            name: item
   435	                .pointer("/function/name")
   436	                .or_else(|| item.get("name"))
   437	                .and_then(Value::as_str)
   438	                .unwrap_or_default()
   439	                .to_string(),
   440	            arguments: item
   441	                .pointer("/function/arguments")
   442	                .or_else(|| item.get("arguments"))
   443	                .or_else(|| item.get("input"))
   444	                .map(|value| value.to_string()),
   445	        })
   446	        .collect()
   447	}
   448	
   449	fn chat_role(role: Option<&str>) -> ChatTurnRole {
   450	    match role
   451	        .map(|value| value.trim().to_ascii_lowercase())
   452	        .as_deref()
   453	    {
   454	        Some("user") => ChatTurnRole::User,
   455	        Some("assistant") => ChatTurnRole::Assistant,
   456	        Some("tool") => ChatTurnRole::Tool,
   457	        Some("system") => ChatTurnRole::System,
   458	        _ => ChatTurnRole::Other,
   459	    }
   460	}
   461	
   462	fn project_chat_parts(value: Option<&Value>) -> Vec<TurnPart> {
   463	    let Some(value) = value else {
   464	        return Vec::new();
   465	    };
   466	    match value {
   467	        Value::String(text) => vec![TurnPart {
   468	            kind: TurnPartKind::Text,
   469	            text: text.clone(),
   470	            ..Default::default()
   471	        }],
   472	        Value::Array(items) => items.iter().map(project_chat_part).collect(),
   473	        _ => Vec::new(),
   474	    }
   475	}
   476	
   477	fn project_chat_part(value: &Value) -> TurnPart {
   478	    let mut part = TurnPart::default();
   479	    if let Some(obj) = value.as_object() {
   480	        let type_value = obj
   481	            .get("type")
   482	            .and_then(Value::as_str)
   483	            .map(|value| value.trim().to_ascii_lowercase())
   484	            .unwrap_or_default();
   485	        if type_value.contains("image") {
   486	            part.kind = TurnPartKind::Image;
   487	            part.has_image = true;
   488	        }
   489	        if type_value == "web_search" || type_value == "websearch" {
   490	            part.kind = TurnPartKind::WebSearch;
   491	            part.has_web_search = true;
   492	        }
   493	        if matches!(
   494	            type_value.as_str(),
   495	            "tool_call" | "tool_use" | "function_call"
   496	        ) {
   497	            part.kind = TurnPartKind::ToolCall;
   498	        }
   499	        if matches!(
   500	            type_value.as_str(),
   501	            "tool_result" | "tool_output" | "function_call_output"
   502	        ) {
   503	            part.kind = TurnPartKind::ToolOutput;
   504	        }
   505	        if part.kind == TurnPartKind::Text || part.kind == TurnPartKind::Other {
   506	            if let Some(text) = obj.get("text").and_then(Value::as_str) {
   507	                part.text = text.to_string();
   508	            }
   509	        }
   510	    }
   511	    if !part.has_image && value_contains_image(value) {
   512	        part.has_image = true;
   513	        if part.kind == TurnPartKind::Text {
   514	            part.kind = TurnPartKind::Image;
   515	        }
   516	    }
   517	    part
   518	}
   519	
   520	fn project_responses_entries(value: &Value) -> Vec<ResponsesTurnEntry> {
   521	    let items = match value {
   522	        Value::Array(items) => items.clone(),
   523	        Value::String(text) if !text.trim().is_empty() => {
   524	            vec![json!({"type": "input_text", "text": text})]
   525	        }
   526	        _ => return Vec::new(),
   527	    };
   528	    project_responses_entries_from_array(&items)
   529	}
   530	
   531	pub fn project_responses_entries_from_array(items: &[Value]) -> Vec<ResponsesTurnEntry> {
   532	    items.iter().map(project_responses_entry).collect()
   533	}
   534	
   535	fn project_responses_entry(value: &Value) -> ResponsesTurnEntry {
   536	    let mut entry = ResponsesTurnEntry::default();
   537	    let role = responses_role_for_value(value);
   538	    entry.role = role;
   539	    let kind = responses_kind_for_value(value);
   540	    entry.kind = kind;
   541	    entry.has_image = value_contains_image(value);
   542	    entry.has_web_search = responses_entry_has_web_search(value);
   543	    entry.is_tool_output_error =
   544	        matches!(kind, ResponsesTurnKind::ToolOutput) && tool_output_is_error(value);
   545	    if matches!(
   546	        kind,
   547	        ResponsesTurnKind::ToolCall | ResponsesTurnKind::WebSearch
   548	    ) {
   549	        if let Some(category) = tool_category_from_call_value(value) {
   550	            entry.tool_call_category = Some(category);
   551	        }
   552	    }
   553	    entry
   554	}
   555	
   556	fn responses_role_for_value(value: &Value) -> ResponsesTurnRole {
   557	    if let Some(role) = value.get("role").and_then(Value::as_str) {
   558	        return match role.trim().to_ascii_lowercase().as_str() {
   559	            "user" => ResponsesTurnRole::User,
   560	            "assistant" => ResponsesTurnRole::Assistant,
   561	            "tool" => ResponsesTurnRole::Tool,
   562	            "system" => ResponsesTurnRole::System,
   563	            _ => ResponsesTurnRole::Other,
   564	        };
   565	    }
   566	    let kind = responses_kind_for_value(value);
   567	    match kind {
   568	        ResponsesTurnKind::Text | ResponsesTurnKind::Image => ResponsesTurnRole::User,
   569	        ResponsesTurnKind::WebSearch
   570	        | ResponsesTurnKind::ToolCall
   571	        | ResponsesTurnKind::Reasoning => ResponsesTurnRole::Assistant,
   572	        ResponsesTurnKind::ToolOutput => ResponsesTurnRole::Tool,
   573	        _ => ResponsesTurnRole::Other,
   574	    }
   575	}
   576	
   577	fn responses_kind_for_value(value: &Value) -> ResponsesTurnKind {
   578	    let type_value = value
   579	        .get("type")
   580	        .and_then(Value::as_str)
   581	        .map(|value| value.trim().to_ascii_lowercase())
   582	        .unwrap_or_default();
   583	    if type_value == "image"
   584	        || type_value.contains("input_image")
   585	        || type_value.contains("output_image")
   586	    {
   587	        return ResponsesTurnKind::Image;
   588	    }
   589	    if type_value == "input_text" || type_value == "output_text" || type_value == "text" {
   590	        return ResponsesTurnKind::Text;
   591	    }
   592	    if type_value == "web_search_call" || type_value == "websearch_call" {
   593	        return ResponsesTurnKind::WebSearch;
   594	    }
   595	    if matches!(
   596	        type_value.as_str(),
   597	        "function_call" | "tool_call" | "custom_tool_call"
   598	    ) {
   599	        return ResponsesTurnKind::ToolCall;
   600	    }
   601	    if matches!(
   602	        type_value.as_str(),
   603	        "function_call_output" | "tool_call_output" | "custom_tool_call_output"
   604	    ) {
   605	        return ResponsesTurnKind::ToolOutput;
   606	    }
   607	    if type_value == "compaction" {
   608	        return ResponsesTurnKind::Compaction;
   609	    }
   610	    if type_value == "reasoning" {
   611	        return ResponsesTurnKind::Reasoning;
   612	    }
   613	    ResponsesTurnKind::Other
   614	}
   615	
   616	fn responses_entry_has_web_search(value: &Value) -> bool {
   617	    let type_value = value
   618	        .get("type")
   619	        .and_then(Value::as_str)
   620	        .map(|value| value.trim().to_ascii_lowercase())
   621	        .unwrap_or_default();
   622	    // web_search_call is a tool-call type; web_search_part inside content[] is the route fact.
   623	    matches!(type_value.as_str(), "web_search" | "websearch")
   624	}
   625	
   626	fn tool_output_is_error(value: &Value) -> bool {
   627	    value
   628	        .get("output")
   629	        .and_then(|output| output.get("is_error"))
   630	        .and_then(Value::as_bool)
   631	        .unwrap_or(false)
   632	        || value
   633	            .get("is_error")
   634	            .and_then(Value::as_bool)
   635	            .unwrap_or(false)
   636	}
   637	
   638	fn tool_category_from_call_value(value: &Value) -> Option<String> {
   639	    let entry_type = value
   640	        .get("type")
   641	        .and_then(Value::as_str)
   642	        .map(|value| value.trim().to_ascii_lowercase())
   643	        .unwrap_or_default();
   644	    let name = value
   645	        .pointer("/function/name")
   646	        .or_else(|| value.get("name"))
   647	        .and_then(Value::as_str)
   648	        .or_else(|| (entry_type == "web_search_call").then_some("web_search"))?;
   649	    let arguments = value
   650	        .pointer("/function/arguments")
   651	        .or_else(|| value.get("arguments"))
   652	        .or_else(|| value.get("input"));
   653	    if let Some(classification) = classify_tool_call(name, arguments) {
   654	        return Some(classification.category);
   655	    }
   656	    None
   657	}
   658	
   659	fn project_gemini_entries(contents: &[Value]) -> Vec<GeminiTurnEntry> {
   660	    contents
   661	        .iter()
   662	        .map(|content| GeminiTurnEntry {
   663	            role: match content.get("role").and_then(Value::as_str) {
   664	                Some("user") => GeminiTurnRole::User,
   665	                Some("model") => GeminiTurnRole::Assistant,
   666	                _ => GeminiTurnRole::Other,
   667	            },
   668	            parts: project_chat_parts(content.get("parts")),
   669	        })
   670	        .collect()
   671	}
   672	
   673	fn value_as_array(value: &Value) -> Option<Vec<Value>> {
   674	    if let Some(items) = value.as_array() {
   675	        return Some(items.clone());
   676	    }
   677	    let raw = value.as_str()?.trim();
   678	    if raw.is_empty() {
   679	        return None;
   680	    }
   681	    serde_json::from_str::<Value>(raw)
   682	        .ok()
   683	        .and_then(|parsed| parsed.as_array().cloned())
   684	}
   685	
   686	fn value_contains_image(value: &Value) -> bool {
   687	    match value {
   688	        Value::Array(items) => items.iter().any(value_contains_image),
   689	        // fbab9d4: Codex view_image carriers embed the screenshot as a
   690	        // stringified JSON array (or a bare data URL) inside
   691	        // `function_call_output.output`; decode and recurse.
   692	        Value::String(text) => string_carries_image(text),
   693	        Value::Object(values) => {
   694	            let type_value = values
   695	                .get("type")
   696	                .and_then(Value::as_str)
   697	                .map(|value| value.trim().to_ascii_lowercase())
   698	                .unwrap_or_default();
   699	            if type_value.contains("image") {
   700	                return true;
   701	            }
   702	            if values.contains_key("image_url") {
   703	                return true;
   704	            }
   705	            if values.contains_key("inline_data") || values.contains_key("file_data") {
   706	                return true;
   707	            }
   708	            if values
   709	                .get("data")
   710	                .and_then(Value::as_str)
   711	                .map(|value| value.trim().to_ascii_lowercase())
   712	                .is_some_and(|value| value.starts_with("data:image/"))
   713	            {
   714	                return true;
   715	            }
   716	            if values
   717	                .get("file_url")
   718	                .and_then(Value::as_str)
   719	                .map(|value| value.trim().to_ascii_lowercase())
   720	                .is_some_and(|value| value.starts_with("data:image/"))
   721	            {
   722	                return true;
   723	            }
   724	            ["content", "parts", "output"]
   725	                .into_iter()
   726	                .filter_map(|field| values.get(field))
   727	                .any(value_contains_image)
   728	        }
   729	        _ => false,
   730	    }
   731	}
   732	
   733	fn string_carries_image(text: &str) -> bool {
   734	    let trimmed = text.trim();
   735	    if trimmed.starts_with("data:image/") {
   736	        return true;
   737	    }
   738	    if trimmed.starts_with('[') || trimmed.starts_with('{') {
   739	        if let Ok(value) = serde_json::from_str::<Value>(trimmed) {
   740	            return value_contains_image(&value);
   741	        }
   742	    }
   743	    false
   744	}

