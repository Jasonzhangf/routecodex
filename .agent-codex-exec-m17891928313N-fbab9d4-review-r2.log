         "model": "gpt-5.6-sol",
         "input": [
             {"type":"input_image","file_id":"hist-1"},
             {"type":"input_text","text":"summary of past chart"},
             {"type":"message","role":"user","content":[
                 {"type":"input_text","text":"describe the recent changes"}
             ]}
         ]
     });
