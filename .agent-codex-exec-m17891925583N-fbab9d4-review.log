- feature_id: v3.simplified_user_config
  status: default_config_toml_source_cutover
  change_risk: high
  owner_kind: rust_v3_config_authoring_projection
  owner_scope: Strict minimal config.toml parser and deterministic projection into the existing V3Config02 authoring contract.
