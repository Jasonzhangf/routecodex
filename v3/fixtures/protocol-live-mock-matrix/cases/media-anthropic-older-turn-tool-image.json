{
  "schema_version": 1,
  "case_id": "media-anthropic-older-turn-tool-image",
  "cell": {"entry_protocol": "anthropic", "provider_protocol": "openai_chat", "transport": "json", "mode": "relay"},
  "client_request": {
    "method": "POST",
    "path": "/v1/messages",
    "headers": {"content-type": "application/json"},
    "body": {
      "model": "mock.chat-model",
      "max_tokens": 64,
      "messages": [
        {"role": "user", "content": "take a screenshot"},
        {"role": "assistant", "content": [{"type": "tool_use", "id": "toolu_1", "name": "screenshot", "input": {}}]},
        {"role": "user", "content": [{"type": "tool_result", "tool_use_id": "toolu_1", "content": [{"type": "image", "source": {"type": "base64", "media_type": "image/png", "data": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg=="}}]}]},
        {"role": "assistant", "content": [{"type": "text", "text": "It shows a login page."}]},
        {"role": "user", "content": "what colour was the button?"}
      ]
    }
  },
  "expected_provider": {
    "paths": ["/v1/chat/completions"],
    "method": "POST",
    "auth_required": true,
    "body_must": {
      "messages": [
        {"role": "user", "content": "take a screenshot"},
        {"role": "assistant", "tool_calls": [{"id": "toolu_1", "type": "function", "function": {"name": "screenshot", "arguments": "{}"}}]},
        {"role": "tool", "tool_call_id": "toolu_1", "content": []},
        {"role": "user", "content": [{"type": "image_url", "image_url": {"url": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg=="}}]},
        {"role": "assistant", "content": [{"type": "text", "text": "It shows a login page."}]},
        {"role": "user", "content": "what colour was the button?"}
      ]
    },
    "body_must_not": ["routecodex_internal", "metadata_center", "debug_snapshot"],
    "exact": null
  },
  "upstream_response": {
    "protocol": "openai_chat",
    "mode": "json",
    "status": 200,
    "content_type": "application/json",
    "body": {"id": "chatcmpl_media_older_turn", "object": "chat.completion", "choices": [{"index": 0, "message": {"role": "assistant", "content": "blue"}, "finish_reason": "stop"}], "usage": {"prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2}}
  },
  "expected_client": {
    "transport": "complete",
    "status": 200,
    "body_must": {"content.0.text": "blue", "stop_reason": "end_turn"},
    "body_must_not": ["provider_error", "internal_error", "routecodex_internal", "metadata_center"],
    "semantic_terminal_required": true
  },
  "assertions": {"provider_attempt_count": 1, "probe_attempts_may_occur": true, "no_control_leakage": true},
  "source": {
    "sha": "bfaedf18301d02a423bd5422d22e41432d231ab8",
    "files": ["internal/gateway/tool_images_test.go"],
    "tests": ["internal/gateway/tool_images_test.go::TestOlderTurnToolResultImageKept"],
    "adaptation": "The fixed older-turn image bytes are replayed; the expected followup keeps the image in the same position rather than summarizing it. The intervening assistant text stays in its legal OpenAI Chat text-part array shape."
  },
  "contract_differences": [
    {"source_behavior": "Magpie moves some tool images into the next user message with a label.", "rcc_requirement": "Preserve the representable image and paired tool result without dropping or rewriting semantics."}
  ]
}
