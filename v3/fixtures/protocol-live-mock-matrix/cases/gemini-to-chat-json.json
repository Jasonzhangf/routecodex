{
  "schema_version": 1,
  "case_id": "gemini-to-chat-json",
  "cell": {"entry_protocol": "gemini", "provider_protocol": "openai_chat", "transport": "json", "mode": "relay"},
  "client_request": {
    "method": "POST",
    "path": "/v1beta/models/mock.chat-model:generateContent",
    "headers": {"content-type": "application/json"},
    "body": {"contents": [{"role": "user", "parts": [{"text": "hello"}]}], "generationConfig": {"maxOutputTokens": 64}}
  },
  "expected_provider": {
    "paths": ["/v1/chat/completions"],
    "method": "POST",
    "auth_required": true,
    "body_must": {"model": "chat-model", "messages.0.role": "user", "messages.0.content": [{"type":"text","text":"hello"}]},
    "body_must_not": ["routecodex_internal", "metadata_center", "debug_snapshot"],
    "exact": null
  },
  "upstream_response": {
    "protocol": "openai_chat",
    "mode": "json",
    "status": 200,
    "content_type": "application/json",
    "body": {"id": "chatcmpl_gemini_to_chat_json", "object": "chat.completion", "choices": [{"index": 0, "message": {"role": "assistant", "content": "ok"}, "finish_reason": "stop"}], "usage": {"prompt_tokens": 7, "completion_tokens": 2, "total_tokens": 9}}
  },
  "expected_client": {
    "transport": "complete",
    "status": 200,
    "body_must": {"candidates.0.content.parts.0.text": "ok", "candidates.0.finishReason": "STOP"},
    "body_must_not": ["provider_error", "internal_error", "routecodex_internal", "metadata_center"],
    "semantic_terminal_required": true
  },
  "assertions": {"provider_attempt_count": 1, "probe_attempts_may_occur": true, "no_control_leakage": true},
