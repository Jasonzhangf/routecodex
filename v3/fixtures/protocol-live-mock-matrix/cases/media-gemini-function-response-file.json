{
  "schema_version": 1,
  "case_id": "media-gemini-function-response-file",
  "cell": {"entry_protocol": "gemini", "provider_protocol": "openai_chat", "transport": "json", "mode": "relay"},
  "client_request": {
    "method": "POST",
    "path": "/v1beta/models/mock.chat-model:generateContent",
    "headers": {"content-type": "application/json"},
    "body": {
      "contents": [
        {"role": "model", "parts": [{"functionCall": {"id": "c1", "name": "read", "args": {}}}]},
        {"role": "user", "parts": [{"functionResponse": {"id": "c1", "name": "read", "response": {"output": "read it"}, "parts": [{"inlineData": {"mimeType": "application/pdf", "data": "UERG"}}, {"fileData": {"mimeType": "image/png", "fileUri": "https://x/y.png"}}]}}]}
      ]
    }
  },
  "expected_provider": {
    "paths": ["/v1/chat/completions"],
    "method": "POST",
    "auth_required": true,
    "body_must": {
      "messages.1.role": "tool",
      "messages.1.tool_call_id": "c1",
      "messages.2.role": "user",
      "messages.2.content.0.image_url.url": "data:image/png;base64,UERG"
    },
    "body_must_not": ["routecodex_internal", "metadata_center", "debug_snapshot"],
    "exact": null
  },
  "upstream_response": {
    "protocol": "openai_chat",
    "mode": "json",
    "status": 200,
    "content_type": "application/json",
    "body": {"id": "chatcmpl_media_file", "object": "chat.completion", "choices": [{"index": 0, "message": {"role": "assistant", "content": "ok"}, "finish_reason": "stop"}], "usage": {"prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2}}
  },
  "expected_client": {
    "transport": "complete",
    "status": 200,
    "body_must": {"candidates.0.content.parts.0.text": "ok", "candidates.0.finishReason": "STOP"},
    "body_must_not": ["provider_error", "internal_error", "routecodex_internal", "metadata_center"],
    "semantic_terminal_required": true
  },
  "assertions": {"provider_attempt_count": 1, "probe_attempts_may_occur": true, "no_control_leakage": true},
  "independent_expected_note": "PDF inline bytes and fileData are preserved without silent deletion; the Chat provider receives representable media in the tool-followup message.",
  "source": {
    "sha": "bfaedf18301d02a423bd5422d22e41432d231ab8",
    "files": ["internal/gateway/gemini_function_parts_test.go"],
    "tests": ["internal/gateway/gemini_function_parts_test.go::TestGeminiFunctionResponseFile"],
    "adaptation": "Fixed PDF and fileData source stimuli; RCC expectation preserves representable media and does not synthesize a description."
  },
  "contract_differences": [
    {"source_behavior": "Magpie follows the function result by keeping file-like data in the same turn.", "rcc_requirement": "Preserve representable media at the native position; never silently drop it."}
  ]
}
