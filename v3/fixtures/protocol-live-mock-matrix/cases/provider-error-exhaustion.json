{
  "schema_version": 1,
  "case_id": "provider-error-exhaustion",
  "cell": {"entry_protocol": "openai_chat", "provider_protocol": "openai_chat", "transport": "json", "mode": "direct"},
  "client_request": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "headers": {"content-type": "application/json"},
    "body": {"model": "mock.unavailable-model", "messages": [{"role": "user", "content": "trigger controlled error"}], "stream": false}
  },
  "expected_provider": {
    "paths": ["/v1/chat/completions"],
    "method": "POST",
    "auth_required": true,
    "body_must": {"model": "unavailable-model", "messages.0.content": "trigger controlled error", "stream": false},
    "body_must_not": ["routecodex_internal", "metadata_center", "debug_snapshot"],
    "exact": null
  },
  "upstream_response": {
    "protocol": "openai_chat",
    "mode": "json",
    "status": 429,
    "content_type": "application/json",
    "body": {"error": {"type": "rate_limit_error", "message": "controlled rate limit"}},
    "attempts": [
      {
        "kind": "json",
        "status": 429,
        "content_type": "application/json",
        "body": {"error": {"type": "rate_limit_error", "message": "controlled rate limit"}}
      },
      {
        "kind": "json",
        "status": 200,
        "content_type": "application/json",
        "body": {
          "id": "chatcmpl_rate_limit_recovered",
          "object": "chat.completion",
          "choices": [
            {
              "index": 0,
              "message": {"role": "assistant", "content": "recovered after the provider rate limit"},
              "finish_reason": "stop"
            }
          ],
          "usage": {"prompt_tokens": 7, "completion_tokens": 4, "total_tokens": 11}
        }
      }
    ]
  },
  "expected_client": {
    "transport": "complete",
    "status": 200,
    "body_must": {
      "choices.0.message.content": "recovered after the provider rate limit",
      "choices.0.finish_reason": "stop"
    },
    "body_must_not": ["rate_limit_error", "controlled rate limit", "provider_error", "internal_error", "routecodex_internal", "metadata_center"],
    "semantic_terminal_required": true
  },
  "assertions": {"provider_attempt_count": 2, "probe_attempts_may_occur": true, "no_control_leakage": true},
  "runtime_setup": {
    "provider_id": "mock-chat",
    "model": "mock.unavailable-model",
    "wire_model": "unavailable-model",
    "candidate_ids": ["mock-chat/mock.unavailable-model"]
  },
  "source": {
    "sha": "bfaedf18301d02a423bd5422d22e41432d231ab8",
    "files": ["internal/gateway/stream_error_open_test.go"],
    "tests": ["internal/gateway/stream_error_open_test.go::TestStreamErrorKeptOpenFailsOverAtOnce"],
    "adaptation": "The provider error body is used only as an error stimulus. RCC keeps the provider error internal, keeps the request alive, and retries the still-eligible identity; this single-candidate fixture proves the retry reaches the provider's next deliverable response."
  },
  "contract_differences": [
    {"source_behavior": "Magpie reports the provider error to the client when no account remains.", "rcc_requirement": "Provider errors stay internal. One HTTP 429 does not end the request: the proxy keeps waiting and retries an eligible identity while recovery remains possible. The residence deadline alone cannot close the client transport."}
  ]
}
