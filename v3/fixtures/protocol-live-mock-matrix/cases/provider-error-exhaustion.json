    "tests": ["internal/gateway/stream_error_open_test.go::TestStreamErrorKeptOpenFailsOverAtOnce"],
    "adaptation": "The only eligible provider returns a complete HTTP error. RCC projects its actual status and body when the declared candidates are exhausted."
  },
