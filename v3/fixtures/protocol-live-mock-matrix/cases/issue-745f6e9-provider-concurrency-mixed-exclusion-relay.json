{
  "schema_version": 1,
  "case_id": "issue-745f6e9-provider-concurrency-mixed-exclusion-relay",
  "cell": {
    "entry_protocol": "responses",
    "provider_protocol": "openai_chat",
    "transport": "sse",
    "mode": "relay"
  },
  "runtime_setup": {
    "provider_id": "mock-chat-busy",
    "model": "mock.chat-model",
    "wire_model": "chat-model",
    "candidate_ids": [
      "mock-chat-busy/mock.chat-model",
      "mock-chat-excluded/mock.chat-model"
    ],
    "provider_concurrency": {
      "maxInFlight": 1,
      "acquireTimeoutMs": 60000,
      "staleLeaseMs": 300000
    }
  },
  "client_request": {
    "method": "POST",
    "path": "/v1/responses",
    "headers": {
      "content-type": "application/json",
      "session-id": "concurrency-mixed-held-relay",
      "thread-id": "concurrency-mixed-held-relay"
    },
    "body": {
      "model": "mock.chat-model",
      "input": "hold the only relay provider capacity",
      "stream": true
    }
  },
  "expected_provider": {
    "paths": [
      "/v1/chat/completions"
    ],
    "method": "POST",
    "auth_required": true,
    "body_must": {
      "model": "chat-model",
      "stream": true
    },
    "body_must_not": [
      "routecodex_internal",
      "metadata_center",
      "debug_snapshot"
    ],
    "exact": null
  },
  "upstream_response": {
    "protocol": "openai_chat",
    "mode": "fault",
    "status": 200,
    "content_type": "text/event-stream",
    "fault": "hold-open-controlled",
    "attempts": [
      {
        "kind": "fault",
        "fault": "hold-open-controlled",
        "sse_events": [
          {
            "data": {
              "id": "chatcmpl_concurrency_mixed_relay",
              "object": "chat.completion.chunk",
              "choices": [
                {
                  "index": 0,
                  "delta": {
                    "role": "assistant",
                    "content": "held response released"
                  }
                }
              ]
            }
          },
          {
            "data": {
              "id": "chatcmpl_concurrency_mixed_relay",
              "object": "chat.completion.chunk",
              "choices": [
                {
                  "index": 0,
                  "delta": {
                    "reasoning": {
                      "summary": [
                        {
                          "type": "summary_text",
                          "text": "concurrency holder completed"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          },
          {
            "data": {
              "id": "chatcmpl_concurrency_mixed_relay",
              "object": "chat.completion.chunk",
              "choices": [
                {
                  "index": 0,
                  "delta": {},
                  "finish_reason": "stop"
                }
              ]
            }
          },
          {
            "data": "[DONE]"
          }
        ]
      },
      {
        "kind": "fault",
        "fault": "controlled-probe-failure",
        "status": 500,
        "content_type": "application/json",
        "body": {
          "error": {
            "message": "controlled probe failure"
          }
        }
      },
      {
        "kind": "sse",
        "status": 200,
        "content_type": "text/event-stream",
        "sse_events": [
          {
            "data": {
              "id": "chatcmpl_concurrency_mixed_reuse_relay",
              "object": "chat.completion.chunk",
              "choices": [
                {
                  "index": 0,
                  "delta": {
                    "role": "assistant",
                    "content": "capacity reused"
                  }
                }
              ]
            }
          },
          {
            "data": {
              "id": "chatcmpl_concurrency_mixed_reuse_relay",
              "object": "chat.completion.chunk",
              "choices": [
                {
                  "index": 0,
                  "delta": {
                    "reasoning": {
                      "summary": [
                        {
                          "type": "summary_text",
                          "text": "capacity reuse completed"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          },
          {
            "data": {
              "id": "chatcmpl_concurrency_mixed_reuse_relay",
              "object": "chat.completion.chunk",
              "choices": [
                {
                  "index": 0,
                  "delta": {},
                  "finish_reason": "stop"
                }
              ]
            }
          },
          {
            "data": "[DONE]"
          }
        ]
      }
    ]
  },
  "expected_client": {
    "transport": "complete",
    "status": 200,
    "body_must": {
      "text": "held response released",
      "status": "completed",
      "output_items.0.type": "reasoning",
      "output_items.0.summary.0.text": "concurrency holder completed",
      "output_items.1.type": "message",
      "output_items.1.role": "assistant",
      "output_items.1.content.0.type": "output_text",
      "output_items.1.content.0.text": "held response released"
    },
    "body_must_not": [
      "provider_error",
      "internal_error",
      "routecodex_internal",
      "metadata_center"
    ],
    "semantic_terminal_required": true
  },
  "concurrency_replay": {
    "kind": "provider_concurrency_all_busy",
    "shape": "mixed_exclusion",
    "expected_source_kind": "provider_failure",
    "expected_source_stage": null,
    "expected_attempts_empty": true,
    "exhaustion_client_request": {
      "method": "POST",
      "path": "/v1/responses",
      "headers": {
        "content-type": "application/json",
        "session-id": "concurrency-mixed-exhausted-relay",
        "thread-id": "concurrency-mixed-exhausted-relay"
      },
      "body": {
        "model": "mock.chat-model",
        "input": "must not reach either relay provider as business",
        "stream": true
      }
    },
    "capacity_reuse_client_request": {
      "method": "POST",
      "path": "/v1/responses",
      "headers": {
        "content-type": "application/json",
        "session-id": "concurrency-mixed-reuse-relay",
        "thread-id": "concurrency-mixed-reuse-relay"
      },
      "body": {
        "model": "mock.chat-model",
        "input": "reuse released relay capacity",
        "stream": true
      }
    },
    "expected_exhaustion_client": {
      "transport": "closed",
      "deadline_ms": 1500,
      "error_codes_must_not": [
        "ETIMEDOUT"
      ]
    },
    "expected_capacity_reuse_client": {
      "transport": "complete",
      "status": 200,
      "body_must": {
        "text": "capacity reused",
        "status": "completed",
        "output_items.0.type": "reasoning",
        "output_items.0.summary.0.text": "capacity reuse completed",
        "output_items.1.type": "message",
        "output_items.1.role": "assistant",
        "output_items.1.content.0.type": "output_text",
        "output_items.1.content.0.text": "capacity reused"
      },
      "body_must_not": [
        "provider_error",
        "internal_error",
        "routecodex_internal",
        "metadata_center"
      ],
      "semantic_terminal_required": true
    },
    "typed_error_codes": [
      "selected_target_exhausted"
    ],
    "typed_error_codes_must_not": [
      "provider_concurrency_busy"
    ],
    "upstream_business_sends": 1,
    "mixed_exclusion": {
      "excluded_provider_id": "mock-chat-excluded",
      "expected_holder_business_sends": 1,
      "expected_reuse_business_sends": 1,
      "expected_probe_sends": 1,
      "expected_health_entry_count": 2,
      "probe_input_contains": "ping; reply pong",
      "cooldown_identity": {
        "interface_id": "default",
        "auth_alias": "key1",
        "kind": "auth_key",
        "duration_ms": 60000
      }
    }
  },
  "assertions": {
    "provider_attempt_count": 2,
    "probe_attempts_may_occur": true,
    "no_control_leakage": true
  },
  "source": {
    "files": [
      "v3/crates/routecodex-v3-server/tests/multi_listener_server.rs"
    ],
    "tests": [
      "v3/crates/routecodex-v3-server/tests/multi_listener_server.rs::responses_provider_concurrency_relay_mixed_exclusion_stays_generic"
    ]
  },
  "contract_differences": []
}
