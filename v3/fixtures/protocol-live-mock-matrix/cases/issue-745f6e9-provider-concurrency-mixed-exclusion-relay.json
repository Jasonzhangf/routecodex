{
  "schema_version": 1,
  "case_id": "issue-745f6e9-provider-concurrency-mixed-exclusion-relay",
  "cell": {
    "entry_protocol": "responses",
    "provider_protocol": "openai_chat",
    "transport": "sse",
    "mode": "relay"
  },
  "runtime_setup": {
    "provider_id": "mock-chat-primary",
    "model": "mock.chat-model",
    "wire_model": "chat-model",
    "candidate_ids": [
      "mock-chat-primary/mock.chat-model",
      "mock-chat-recovered/mock.chat-model"
    ],
    "health": {
      "enabled": true,
      "failure_threshold": 1,
      "cooldown_ms": 60000
    },
    "attempt_store": {
      "residence_timeout_ms": 30000
    }
  },
  "client_request": {
    "method": "POST",
    "path": "/v1/responses",
    "headers": {
      "content-type": "application/json",
      "session-id": "independence-failure-relay-holder",
      "thread-id": "independence-failure-relay-holder"
    },
    "body": {
      "model": "mock.chat-model",
      "input": "hold the relay provider while a sibling fails",
      "stream": true
    }
  },
  "expected_provider": {
    "paths": [
      "/v1/chat/completions"
    ],
    "method": "POST",
    "auth_required": true,
    "body_must": {
      "model": "chat-model",
      "stream": true
    },
    "body_must_not": [
      "routecodex_internal",
      "metadata_center",
      "debug_snapshot"
    ],
    "exact": null
  },
  "upstream_response": {
    "protocol": "openai_chat",
    "mode": "fault",
    "status": 200,
    "content_type": "text/event-stream",
    "fault": "hold-open-controlled",
    "attempts": [
      {
        "kind": "fault",
        "fault": "hold-open-controlled",
        "sse_events": [
          {
            "data": {
              "id": "chatcmpl_independence_failure_relay_holder",
              "object": "chat.completion.chunk",
              "choices": [
                {
                  "index": 0,
                  "delta": {
                    "role": "assistant",
                    "content": "held response released"
                  }
                }
              ]
            }
          },
          {
            "data": {
              "id": "chatcmpl_independence_failure_relay_holder",
              "object": "chat.completion.chunk",
              "choices": [
                {
                  "index": 0,
                  "delta": {
                    "reasoning": {
                      "summary": [
                        {
                          "type": "summary_text",
                          "text": "relay failure holder completed"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          },
          {
            "data": {
              "id": "chatcmpl_independence_failure_relay_holder",
              "object": "chat.completion.chunk",
              "choices": [
                {
                  "index": 0,
                  "delta": {},
                  "finish_reason": "stop"
                }
              ]
            }
          },
          {
            "data": "[DONE]"
          }
        ]
      },
      {
        "kind": "json",
        "status": 500,
        "content_type": "application/json",
        "body": {
          "error": {
            "message": "controlled provider failure",
            "code": "upstream_http_error"
          }
        }
      },
      {
        "kind": "sse",
        "status": 200,
        "content_type": "text/event-stream",
        "sse_events": [
          {
            "data": {
              "id": "chatcmpl_independence_failure_relay_recovered",
              "object": "chat.completion.chunk",
              "choices": [
                {
                  "index": 0,
                  "delta": {
                    "role": "assistant",
                    "content": "recovered response"
                  }
                }
              ]
            }
          },
          {
            "data": {
              "id": "chatcmpl_independence_failure_relay_recovered",
              "object": "chat.completion.chunk",
              "choices": [
                {
                  "index": 0,
                  "delta": {
                    "reasoning": {
                      "summary": [
                        {
                          "type": "summary_text",
                          "text": "relay failure recovered"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          },
          {
            "data": {
              "id": "chatcmpl_independence_failure_relay_recovered",
              "object": "chat.completion.chunk",
              "choices": [
                {
                  "index": 0,
                  "delta": {},
                  "finish_reason": "stop"
                }
              ]
            }
          },
          {
            "data": "[DONE]"
          }
        ]
      }
    ]
  },
  "expected_client": {
    "transport": "complete",
    "status": 200,
    "body_must": {
      "text": "held response released",
      "status": "completed",
      "output_items.0.type": "message",
      "output_items.0.role": "assistant",
      "output_items.0.content.0.type": "output_text",
      "output_items.0.content.0.text": "held response released",
      "output_items.1.type": "reasoning",
      "output_items.1.summary.0.text": "relay failure holder completed"
    },
    "body_must_not": [
      "provider_error",
      "internal_error",
      "routecodex_internal",
      "metadata_center"
    ],
    "semantic_terminal_required": true
  },
  "request_independence_replay": {
    "kind": "provider_request_independence",
    "shape": "failure_isolation",
    "failed_client_request": {
      "method": "POST",
      "path": "/v1/responses",
      "headers": {
        "content-type": "application/json",
        "session-id": "independence-failure-relay-failed",
        "thread-id": "independence-failure-relay-failed"
      },
      "body": {
        "model": "mock.chat-model",
        "input": "fail once then recover on the next relay candidate",
        "stream": true
      }
    },
    "expected_failed_client": {
      "transport": "complete",
      "status": 200,
      "body_must": {
        "text": "recovered response",
        "status": "completed",
        "output_items.0.type": "message",
        "output_items.0.role": "assistant",
        "output_items.0.content.0.type": "output_text",
        "output_items.0.content.0.text": "recovered response",
        "output_items.1.type": "reasoning",
        "output_items.1.summary.0.text": "relay failure recovered"
      },
      "body_must_not": [
        "provider_error",
        "internal_error",
        "routecodex_internal"
      ],
      "semantic_terminal_required": true
    },
    "post_recovery_client_request": {
      "method": "POST",
      "path": "/v1/responses",
      "headers": {
        "content-type": "application/json",
        "session-id": "independence-failure-relay-post",
        "thread-id": "independence-failure-relay-post"
      },
      "body": {
        "model": "mock.chat-model",
        "input": "independent relay request after recovery",
        "stream": true
      }
    },
    "expected_post_recovery_client": {
      "transport": "complete",
      "status": 200,
      "body_must": {
        "text": "recovered response",
        "status": "completed",
        "output_items.0.type": "message",
        "output_items.0.role": "assistant",
        "output_items.0.content.0.type": "output_text",
        "output_items.0.content.0.text": "recovered response",
        "output_items.1.type": "reasoning",
        "output_items.1.summary.0.text": "relay failure recovered"
      },
      "body_must_not": [
        "provider_error",
        "internal_error",
        "routecodex_internal"
      ],
      "semantic_terminal_required": true
    },
    "failure_isolation": {
      "failed_provider_id": "mock-chat-primary",
      "recovered_provider_id": "mock-chat-recovered",
      "expected_provider_status": 500,
      "expected_action": "switch_provider",
      "expected_holder_business_sends": 1,
      "expected_failed_business_sends": 1,
      "expected_recovery_business_sends": 2
    },
    "typed_error_codes_must_not": [
      "provider_concurrency_busy"
    ]
  },
  "assertions": {
    "provider_attempt_count": 4,
    "probe_attempts_may_occur": true,
    "no_control_leakage": true
  },
  "source": {
    "sha": "25c366feb",
    "files": [
      "v3/crates/routecodex-v3-server/tests/multi_listener_server.rs"
    ],
    "tests": [
      "v3/crates/routecodex-v3-server/tests/multi_listener_server.rs::responses_relay_provider_503_never_reaches_the_client"
    ]
  },
  "contract_differences": []
}
