      "turn_id": "namespace-call-mock",
      "purpose": "The provider returns a namespaced function call with complete arguments; first-turn stream is true.",
      "expected_client_must": {"item.type": "function_call", "item.name": "spawn_agent", "item.namespace": "collaboration", "item.call_id": "call_ns_1", "item.arguments": "{\"message\":\"do work\"}"}
    },
    {
      "turn_id": "namespace-local-mock-outcome",
      "purpose": "The test-owned local namespace mock records the call and its actual readback output; the client submits that actual output in the next request.",
