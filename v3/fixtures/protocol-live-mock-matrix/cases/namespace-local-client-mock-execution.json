    "files": ["internal/gateway/namespace_test.go", "internal/gateway/codex_custom_tools_test.go"],
    "tests": ["internal/gateway/namespace_test.go::TestNamespacedCallStreamed", "internal/gateway/codex_custom_tools_test.go::TestCodexCustomToolsTranslated"],
    "adaptation": "Namespaced and custom declarations are adapted from Magpie. The supplemental local mock execution is an RCC test-owned extension: it selects a repo-owned function implementation explicitly and performs one bounded local file operation. No permission beyond the declared mock binding is granted; it does not launch an agent, send a message, or execute a shell command."
  },
  "contract_differences": [
    {"source_behavior": "Magpie offers Codex custom tools as wrapper functions with transform-specific behavior.", "rcc_requirement": "Preserve namespace, custom/complete arguments and call binding; do not invent an executor permission from the response."},
    {"source_behavior": "Magpie namespace calls reference agent spawning semantics.", "rcc_requirement": "The supplemental fixture binds the declared collaboration.spawn_agent function explicitly to the test-owned local-namespace-mock implementation. The observed call ID, namespace, name and complete arguments drive the next request; the local implementation's output is derived from an actual exclusive file write and readback, not from a scripted fixture value."}
  ],
  "turns": [
