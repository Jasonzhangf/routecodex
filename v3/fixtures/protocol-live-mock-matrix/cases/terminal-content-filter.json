{
  "schema_version": 1,
  "case_id": "terminal-content-filter",
  "cell": {"entry_protocol": "openai_chat", "provider_protocol": "responses", "transport": "json", "mode": "relay"},
  "client_request": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "headers": {"content-type": "application/json"},
    "body": {"model": "mock.responses-model", "messages": [{"role": "user", "content": "hello"}], "stream": false}
  },
  "expected_provider": {
    "paths": ["/v1/responses"],
    "method": "POST",
    "auth_required": true,
    "body_must": {"model": "responses-model", "stream": false},
    "body_must_not": ["routecodex_internal", "metadata_center", "debug_snapshot"],
    "exact": null
  },
  "upstream_response": {
    "protocol": "responses",
    "mode": "json",
    "status": 200,
    "content_type": "application/json",
    "body": {"id": "resp_content_filter", "status": "incomplete", "incomplete_details": {"reason": "content_filter"}, "output": [{"type": "message", "role": "assistant", "content": [{"type": "output_text", "text": "partial"}]}]}
  },
  "expected_client": {
    "transport": "complete",
    "status": 200,
    "body_must": {"choices.0.message.content": "partial", "choices.0.finish_reason": "content_filter"},
    "body_must_not": ["provider_error", "internal_error", "routecodex_internal", "metadata_center"],
    "semantic_terminal_required": true
  },
  "assertions": {"provider_attempt_count": 1, "probe_attempts_may_occur": true, "no_control_leakage": true},
  "source": {
    "sha": "bfaedf18301d02a423bd5422d22e41432d231ab8",
    "files": ["internal/gateway/translate_stream_test.go"],
    "tests": ["internal/gateway/translate_stream_test.go::TestStreamedCallStopsForTool"],
    "adaptation": "Content filter is a legal provider terminal, not a failure; it must be forwarded as finish_reason=content_filter."
  },
  "contract_differences": [
    {"source_behavior": "Some Magpie paths treat content filter as a stream error/stop.", "rcc_requirement": "Forward content_filter as a legal terminal, not as a provider failure."}
  ]
}
