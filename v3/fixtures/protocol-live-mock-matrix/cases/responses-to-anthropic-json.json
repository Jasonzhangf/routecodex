      "body_must": {
        "model": "anthropic-model",
        "max_tokens": 64,
        "messages.0.role": "user",
        "messages.1.role": "assistant",
        "messages.1.content.0.text": "ok",
        "messages.2.role": "user",
        "messages.2.content.0.text": "继续执行尚未完成的任务；需要工具时直接调用工具；如果任务已完成，请给出完成总结。"
      }
    }
  ],
  "upstream_response": {
    "protocol": "anthropic",
    "mode": "json",
    "status": 200,
    "content_type": "application/json",
    "body": {"id": "msg_responses_to_anthropic_json", "type": "message", "role": "assistant", "stop_reason": "end_turn", "content": [{"type": "text", "text": "ok"}], "usage": {"input_tokens": 7, "output_tokens": 2}},
    "attempts": [
      {
        "protocol": "anthropic",
        "mode": "json",
        "status": 200,
        "content_type": "application/json",
        "body": {"id": "msg_responses_to_anthropic_json", "type": "message", "role": "assistant", "stop_reason": "end_turn", "content": [{"type": "text", "text": "ok"}], "usage": {"input_tokens": 7, "output_tokens": 2}}
      },
      {
        "protocol": "anthropic",
        "mode": "json",
        "status": 200,
        "content_type": "application/json",
        "body": {"id": "msg_responses_to_anthropic_json", "type": "message", "role": "assistant", "stop_reason": "end_turn", "content": [{"type": "text", "text": "refill-ok"}], "usage": {"input_tokens": 7, "output_tokens": 2}}
      }
    ]
  },
  "expected_client": {
    "transport": "complete",
