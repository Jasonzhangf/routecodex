{
  "schema_version": 1,
  "case_id": "responses-to-anthropic-json",
  "cell": {"entry_protocol": "responses", "provider_protocol": "anthropic", "transport": "json", "mode": "relay"},
  "client_request": {
    "method": "POST",
    "path": "/v1/responses",
    "headers": {"content-type": "application/json"},
    "body": {"model": "mock.anthropic-model", "input": "hello", "max_output_tokens": 64, "stream": false}
  },
