{
  "schema_version": 1,
  "case_id": "unregistered-response-field-preserved",
  "cell": {"entry_protocol": "openai_chat", "provider_protocol": "openai_chat", "transport": "json", "mode": "direct"},
  "client_request": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "headers": {"content-type": "application/json"},
    "body": {"model": "mock.chat-model", "messages": [{"role": "user", "content": "hello"}], "stream": false}
  },
  "expected_provider": {
    "paths": ["/v1/chat/completions"],
    "method": "POST",
    "auth_required": true,
    "body_must": {"model": "chat-model", "messages.0.content": "hello", "stream": false},
    "body_must_not": ["routecodex_internal", "metadata_center", "debug_snapshot"],
    "exact": null
  },
  "upstream_response": {
    "protocol": "openai_chat",
    "mode": "json",
    "status": 200,
    "content_type": "application/json",
    "body": {
      "id": "chatcmpl_unregistered_resp",
      "object": "chat.completion",
      "choices": [{"index": 0, "message": {"role": "assistant", "content": "ok", "vendor_extra": {"trace": "opaque"}}, "finish_reason": "stop"}],
      "usage": {"prompt_tokens": 7, "completion_tokens": 2, "total_tokens": 9}
    }
  },
  "expected_client": {
    "transport": "complete",
    "status": 200,
    "body_must": {"choices.0.message.content": "ok", "choices.0.message.vendor_extra.trace": "opaque", "choices.0.finish_reason": "stop"},
    "body_must_not": ["provider_error", "internal_error", "routecodex_internal", "metadata_center"],
    "semantic_terminal_required": true
  },
  "assertions": {"provider_attempt_count": 1, "probe_attempts_may_occur": true, "no_control_leakage": true},
  "source": {
    "sha": "bfaedf18301d02a423bd5422d22e41432d231ab8",
    "files": ["internal/gateway/testdata/upstream_bodies/anthropic.json"],
    "tests": ["internal/gateway/wire_test.go::TestUpstreamNameReachesTheVendorOnly"],
    "adaptation": "Adds an unknown response field to a fixed successful body; the independent assertion checks representable response preservation."
  },
  "contract_differences": []
}
