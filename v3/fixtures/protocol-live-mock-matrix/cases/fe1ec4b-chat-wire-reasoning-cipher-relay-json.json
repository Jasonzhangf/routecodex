      "input": [
        {
          "role": "user",
          "content": [
            {
              "type": "input_text",
              "text": "preserve opaque chat reasoning and strip codex marker"
            }
          ]
        }
      ],
      "stream": false
    }
  },
  "expected_provider": {
    "paths": [
      "/v1/chat/completions"
    ],
    "method": "POST",
    "auth_required": true,
    "body_must": {
