    "mode": "json",
    "status": 200,
    "content_type": "application/json",
    "body": {
      "id": "chatcmpl_fe1ec4b_chat_cipher",
      "object": "chat.completion",
      "model": "chat-model",
      "choices": [
        {
          "index": 0,
          "message": {
            "role": "assistant",
            "reasoning": {
              "summary": [
                {
                  "type": "summary_text",
                  "text": "opaque chat reasoning"
                }
              ],
              "encrypted_content": "opaque-chat-business-cipher"
            },
            "content": ""
          },
          "finish_reason": "stop"
        },
        {
          "index": 1,
          "message": {
            "role": "assistant",
            "reasoning": {
              "summary": [
                {
                  "type": "summary_text",
                  "text": "codex marker reasoning"
                }
              ],
              "encrypted_content": "rsn_CODEX_LOCAL_CIPHER"
            },
            "content": "chat answer"
          },
          "finish_reason": "stop"
        }
      ],
      "usage": {
        "prompt_tokens": 11,
        "completion_tokens": 5,
        "total_tokens": 16
      }
    }
  },
  "expected_client": {
    "transport": "complete",
    "status": 200,
    "body_must": {
      "status": "completed",
      "output.0.type": "reasoning",
      "output.0.encrypted_content": "opaque-chat-business-cipher",
