{
  "schema_version": 1,
  "case_id": "chat-to-gemini-json",
  "cell": {"entry_protocol": "openai_chat", "provider_protocol": "gemini", "transport": "json", "mode": "relay"},
  "client_request": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "headers": {"content-type": "application/json"},
    "body": {"model": "mock.gemini-model", "messages": [{"role": "user", "content": "hello"}], "max_tokens": 64, "stream": false}
  },
  "expected_provider": {
    "paths": ["/v1beta/models/gemini-model:generateContent"],
    "method": "POST",
    "auth_required": true,
    "body_must": {"contents.0.role": "user", "contents.0.parts.0.text": "hello"},
    "body_must_not": ["routecodex_internal", "metadata_center", "debug_snapshot"],
    "exact": null
  },
  "expected_provider_by_attempt": [
    {},
    {"body_must": {"contents.0.parts.0.text": "hello", "contents.1.role": "model", "contents.1.parts.0.text": "ok", "contents.2.role": "user", "contents.2.parts.0.text": "继续执行尚未完成的任务；需要工具时直接调用工具；如果任务已完成，请给出完成总结。"}}
  ],
  "upstream_response": {
    "protocol": "gemini",
    "mode": "json",
    "status": 200,
    "content_type": "application/json",
    "body": {"candidates": [{"content": {"role": "model", "parts": [{"text": "ok"}]}, "finishReason": "STOP"}], "usageMetadata": {"promptTokenCount": 7, "candidatesTokenCount": 2, "totalTokenCount": 9}},
    "attempts": [
      {
        "protocol": "gemini",
        "mode": "json",
        "status": 200,
        "content_type": "application/json",
        "body": {"candidates": [{"content": {"role": "model", "parts": [{"text": "ok"}]}, "finishReason": "STOP"}], "usageMetadata": {"promptTokenCount": 7, "candidatesTokenCount": 2, "totalTokenCount": 9}}
      },
      {
        "protocol": "gemini",
        "mode": "json",
        "status": 200,
        "content_type": "application/json",
        "body": {"candidates": [{"content": {"role": "model", "parts": [{"text": "refill-ok"}]}, "finishReason": "STOP"}], "usageMetadata": {"promptTokenCount": 14, "candidatesTokenCount": 2, "totalTokenCount": 16}}
      }
    ]
  },
  "expected_client": {
    "transport": "complete",
    "status": 200,
    "body_must": {"choices.0.message.content": "okrefill-ok", "choices.0.finish_reason": "stop"},
    "body_must_not": ["provider_error", "internal_error", "routecodex_internal", "metadata_center"],
    "semantic_terminal_required": true
  },
  "assertions": {"provider_attempt_count": 2, "probe_attempts_may_occur": true, "no_control_leakage": true},
  "source": {
    "sha": "bfaedf18301d02a423bd5422d22e41432d231ab8",
    "files": ["internal/gateway/gemini_function_parts_test.go"],
    "tests": ["internal/gateway/gemini_function_parts_test.go::TestGeminiFunctionResponseImageReachesUpstream"],
    "adaptation": "Uses the fixed Gemini generateContent path/body shape; expected is protocol-derived, not from a Gemini codec."
  },
  "contract_differences": []
}
