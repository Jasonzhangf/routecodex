{
  "schema_version": 1,
  "case_id": "reasoning-signature-anthropic-to-gemini",
  "cell": {"entry_protocol": "anthropic", "provider_protocol": "gemini", "transport": "json", "mode": "relay"},
  "client_request": {
    "method": "POST",
    "path": "/v1/messages",
    "headers": {"content-type": "application/json"},
    "body": {
      "model": "mock.gemini-model",
      "max_tokens": 1000,
      "messages": [
        {"role": "user", "content": "list files"},
        {"role": "assistant", "content": [{"type": "tool_use", "id": "function-call-7", "name": "bash", "input": {"command": "ls"}, "thought_signature": "c2lnbmF0dXJlLW9uZQ=="}]},
        {"role": "user", "content": [{"type": "tool_result", "tool_use_id": "function-call-7", "content": "a.txt"}]}
      ],
      "tools": [{"name": "bash", "input_schema": {"type": "object"}}]
    }
  },
  "expected_provider": {
    "paths": ["/v1beta/models/gemini-model:generateContent"],
    "method": "POST",
    "auth_required": true,
    "body_must": {
      "contents.1.parts.0.functionCall.id": "function-call-7",
      "contents.1.parts.0.functionCall.thoughtSignature": "c2lnbmF0dXJlLW9uZQ==",
      "contents.2.parts.0.functionResponse.id": "function-call-7"
    },
    "body_must_not": ["routecodex_internal", "metadata_center", "debug_snapshot"],
    "exact": null
  },
  "upstream_response": {
    "protocol": "gemini",
    "mode": "json",
    "status": 200,
    "content_type": "application/json",
    "body": {"candidates": [{"content": {"role": "model", "parts": [{"text": "a.txt"}]}, "finishReason": "STOP"}], "usageMetadata": {"promptTokenCount": 7, "candidatesTokenCount": 2, "totalTokenCount": 9}}
  },
  "expected_client": {
    "transport": "complete",
    "status": 200,
    "body_must": {"content.0.text": "a.txt", "stop_reason": "end_turn"},
    "body_must_not": ["provider_error", "internal_error", "routecodex_internal", "metadata_center"],
    "semantic_terminal_required": true
  },
  "assertions": {"provider_attempt_count": 1, "probe_attempts_may_occur": true, "no_control_leakage": true},
  "source": {
    "sha": "bfaedf18301d02a423bd5422d22e41432d231ab8",
    "files": ["internal/gateway/gemini_signature_test.go"],
    "tests": ["internal/gateway/gemini_signature_test.go::TestGeminiThoughtSignatureThroughAnthropic"],
    "adaptation": "The provided signature is replayed exactly into the Gemini function call. RCC must not synthesize or tunnel signatures."
  },
  "contract_differences": [
    {"source_behavior": "Magpie can carry the Gemini signature in tool IDs or wrapper fields.", "rcc_requirement": "Represent the provided signature only through the protocol-native field; no signature-in-ID tunneling and no guessing."}
  ]
}
