{
  "schema_version": 1,
  "case_id": "chat-to-chat-json",
  "cell": {
    "entry_protocol": "openai_chat",
    "provider_protocol": "openai_chat",
    "transport": "json",
    "mode": "direct"
  },
  "client_request": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "headers": {"content-type": "application/json"},
    "body": {
      "model": "mock.chat-model",
      "messages": [{"role": "system", "content": "be brief"}, {"role": "user", "content": "hello"}],
      "temperature": 1,
      "max_tokens": 64,
      "stream": false
    }
  },
  "expected_provider": {
    "paths": ["/v1/chat/completions"],
    "method": "POST",
    "auth_required": true,
    "body_must": {
      "model": "chat-model",
      "messages.0.role": "system",
      "messages.1.content": "hello",
      "stream": false
    },
    "body_must_not": ["routecodex_internal", "metadata_center", "debug_snapshot", "provider_protocol"],
    "exact": null
  },
  "upstream_response": {
    "protocol": "openai_chat",
    "mode": "json",
    "status": 200,
    "content_type": "application/json",
    "body": {
      "id": "chatcmpl_chat_direct_json",
      "object": "chat.completion",
      "model": "chat-model",
      "choices": [{"index": 0, "message": {"role": "assistant", "content": "ok"}, "finish_reason": "stop"}],
      "usage": {"prompt_tokens": 7, "completion_tokens": 2, "total_tokens": 9}
    }
  },
  "expected_client": {
    "transport": "complete",
    "status": 200,
    "body_must": {"choices.0.message.content": "ok", "choices.0.finish_reason": "stop", "usage.prompt_tokens": 7},
    "body_must_not": ["provider_error", "internal_error", "routecodex_internal", "metadata_center"],
    "semantic_terminal_required": true
  },
  "assertions": {"provider_attempt_count": 1, "probe_attempts_may_occur": true, "no_control_leakage": true},
  "source": {
    "sha": "bfaedf18301d02a423bd5422d22e41432d231ab8",
    "files": ["internal/gateway/testdata/upstream_bodies/chat.json"],
    "tests": ["internal/gateway/wire_test.go::TestUpstreamNameReachesTheVendorOnly"],
    "adaptation": "Reused the fixed chat body shape as input stimulus; expected values are written from the OpenAI Chat protocol and RCC whitelist."
  },
  "contract_differences": []
}
