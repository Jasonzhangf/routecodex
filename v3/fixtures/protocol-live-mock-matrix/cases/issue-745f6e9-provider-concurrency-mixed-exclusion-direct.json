  "expected_client": {
    "transport": "complete",
    "status": 200,
    "body_must": {
      "text": "held response released",
      "status": "completed"
    },
    "body_must_not": [
      "provider_error",
      "internal_error",
      "routecodex_internal",
      "metadata_center"
    ],
    "semantic_terminal_required": true
  },
  "request_independence_replay": {
    "kind": "provider_request_independence",
    "shape": "failure_isolation",
    "failed_client_request": {
      "method": "POST",
      "path": "/v1/responses",
      "headers": {
        "content-type": "application/json",
        "session-id": "independence-failure-direct-failed",
        "thread-id": "independence-failure-direct-failed"
      },
      "body": {
        "model": "mock.responses-model",
        "input": "fail once then recover on the next direct candidate",
        "stream": true
      }
    },
    "expected_failed_client": {
      "transport": "complete",
      "status": 200,
      "body_must": {
        "text": "recovered response",
        "status": "completed"
      },
      "body_must_not": [
        "provider_error",
        "internal_error",
        "routecodex_internal"
      ],
      "semantic_terminal_required": true
    },
    "post_recovery_client_request": {
      "method": "POST",
      "path": "/v1/responses",
      "headers": {
        "content-type": "application/json",
        "session-id": "independence-failure-direct-post",
        "thread-id": "independence-failure-direct-post"
      },
      "body": {
        "model": "mock.responses-model",
        "input": "independent direct request after recovery",
        "stream": true
      }
    },
    "expected_post_recovery_client": {
      "transport": "complete",
      "status": 200,
      "body_must": {
        "text": "recovered response",
        "status": "completed"
      },
      "body_must_not": [
        "provider_error",
        "internal_error",
        "routecodex_internal"
      ],
      "semantic_terminal_required": true
    },
    "failure_isolation": {
      "failed_provider_id": "mock-responses-primary",
      "recovered_provider_id": "mock-responses-recovered",
      "expected_provider_status": 500,
      "expected_action": "switch_provider",
      "expected_holder_business_sends": 1,
      "expected_failed_business_sends": 1,
      "expected_recovery_business_sends": 2
    },
    "typed_error_codes_must_not": [
      "provider_concurrency_busy"
    ]
  },
  "assertions": {
    "provider_attempt_count": 4,
    "probe_attempts_may_occur": true,
    "no_control_leakage": true
  },
