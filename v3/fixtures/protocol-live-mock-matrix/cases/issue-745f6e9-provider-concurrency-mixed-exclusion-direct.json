{
  "schema_version": 1,
  "case_id": "issue-745f6e9-provider-concurrency-mixed-exclusion-direct",
  "cell": {
    "entry_protocol": "responses",
    "provider_protocol": "responses",
    "transport": "sse",
    "mode": "direct"
  },
  "runtime_setup": {
    "provider_id": "mock-responses-primary",
    "model": "mock.responses-model",
    "wire_model": "responses-model",
    "candidate_ids": [
      "mock-responses-primary/mock.responses-model",
      "mock-responses-recovered/mock.responses-model"
    ],
    "process": "direct",
    "health": {
      "enabled": true,
      "failure_threshold": 1,
      "cooldown_ms": 60000
    },
    "attempt_store": {
      "residence_timeout_ms": 30000
    }
  },
  "client_request": {
    "method": "POST",
    "path": "/v1/responses",
    "headers": {
      "content-type": "application/json",
      "session-id": "independence-failure-direct-holder",
      "thread-id": "independence-failure-direct-holder"
    },
    "body": {
      "model": "mock.responses-model",
      "input": "hold the direct provider while a sibling fails",
      "stream": true
    }
  },
  "expected_provider": {
    "paths": [
      "/v1/responses"
    ],
    "method": "POST",
    "auth_required": true,
    "body_must": {
      "model": "responses-model",
      "stream": true
    },
    "body_must_not": [
      "routecodex_internal",
      "metadata_center",
      "debug_snapshot"
    ],
    "exact": null
  },
  "upstream_response": {
    "protocol": "responses",
    "mode": "fault",
    "status": 200,
    "content_type": "text/event-stream",
    "fault": "hold-open-controlled",
    "attempts": [
      {
        "kind": "fault",
        "fault": "hold-open-controlled",
        "sse_events": [
          {
            "event": "response.created",
            "data": {
              "type": "response.created",
              "response": {
                "id": "resp_independence_failure_direct_holder",
                "status": "in_progress",
                "output": []
              }
            }
          },
          {
            "event": "response.output_text.delta",
            "data": {
              "type": "response.output_text.delta",
              "output_index": 0,
              "content_index": 0,
              "item_id": "msg_independence_failure_direct_holder",
              "delta": "held response released"
            }
          },
          {
            "event": "response.completed",
            "data": {
              "type": "response.completed",
              "response": {
                "id": "resp_independence_failure_direct_holder",
                "status": "completed",
                "output": [
                  {
                    "type": "message",
                    "role": "assistant",
                    "content": [
                      {
                        "type": "output_text",
                        "text": "held response released"
                      }
                    ]
                  },
                  {
                    "type": "reasoning",
                    "summary": [
                      {
                        "type": "summary_text",
                        "text": "direct failure holder completed"
                      }
                    ]
                  }
                ],
                "usage": {
                  "input_tokens": 5,
                  "output_tokens": 3,
                  "total_tokens": 8
                }
              }
            }
          }
        ]
      },
      {
        "kind": "json",
        "status": 500,
        "content_type": "application/json",
        "body": {
          "error": {
            "message": "controlled provider failure",
            "code": "upstream_http_error"
          }
        }
      },
      {
        "kind": "sse",
        "status": 200,
        "content_type": "text/event-stream",
        "sse_events": [
          {
            "event": "response.created",
            "data": {
              "type": "response.created",
              "response": {
                "id": "resp_independence_failure_direct_recovered",
                "status": "in_progress",
                "output": []
              }
            }
          },
          {
            "event": "response.output_text.delta",
            "data": {
              "type": "response.output_text.delta",
              "output_index": 0,
              "content_index": 0,
              "item_id": "msg_independence_failure_direct_recovered",
              "delta": "recovered response"
            }
          },
          {
            "event": "response.completed",
            "data": {
              "type": "response.completed",
              "response": {
                "id": "resp_independence_failure_direct_recovered",
                "status": "completed",
                "output": [
                  {
                    "type": "message",
                    "role": "assistant",
                    "content": [
                      {
                        "type": "output_text",
                        "text": "recovered response"
                      }
                    ]
                  },
                  {
                    "type": "reasoning",
                    "summary": [
                      {
                        "type": "summary_text",
                        "text": "direct failure recovered completed"
                      }
                    ]
                  }
                ],
                "usage": {
                  "input_tokens": 5,
                  "output_tokens": 2,
                  "total_tokens": 7
                }
              }
            }
          }
        ]
