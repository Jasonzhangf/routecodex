{
  "schema_version": 1,
  "case_id": "unregistered-request-field-continuation",
  "cell": {"entry_protocol": "openai_chat", "provider_protocol": "openai_chat", "transport": "json", "mode": "direct"},
  "client_request": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "headers": {"content-type": "application/json"},
    "body": {"model": "mock.chat-model", "messages": [{"role": "user", "content": "hello"}], "stream": false, "routecodex_unregistered_probe": {"nested": ["keep-out-of-wire"]}}
  },
  "expected_provider": {
    "paths": ["/v1/chat/completions"],
    "method": "POST",
    "auth_required": true,
    "body_must": {"model": "chat-model", "messages.0.content": "hello", "stream": false, "routecodex_unregistered_probe": {"nested": ["keep-out-of-wire"]}},
    "body_must_not": ["routecodex_internal", "metadata_center", "debug_snapshot"],
    "exact": null
  },
  "upstream_response": {
    "protocol": "openai_chat",
    "mode": "json",
    "status": 200,
    "content_type": "application/json",
    "body": {"id": "chatcmpl_unregistered_req", "object": "chat.completion", "choices": [{"index": 0, "message": {"role": "assistant", "content": "ok"}, "finish_reason": "stop"}], "usage": {"prompt_tokens": 7, "completion_tokens": 2, "total_tokens": 9}}
  },
  "expected_client": {
    "transport": "complete",
    "status": 200,
    "body_must": {"choices.0.message.content": "ok", "choices.0.finish_reason": "stop"},
    "body_must_not": ["provider_error", "internal_error", "routecodex_internal", "metadata_center", "routecodex_unregistered_probe"],
    "semantic_terminal_required": true
  },
  "assertions": {"provider_attempt_count": 1, "probe_attempts_may_occur": true, "no_control_leakage": false},
  "source": {
    "sha": "bfaedf18301d02a423bd5422d22e41432d231ab8",
    "files": ["internal/gateway/optional_fields_test.go"],
    "tests": ["internal/gateway/optional_fields_test.go::TestOptionalFieldUnsupportedRetried"],
    "adaptation": "Only the input field is borrowed. RCC preserves the complete client business value on the first attempt. This case intentionally uses a routecodex_ spelling as business data, so the name-only control-marker scan is inapplicable; the exact captured business value, independent auth, one-attempt count and normal response are required."
  },
  "contract_differences": [
    {"source_behavior": "Magpie removes the refused optional field and retries against the provider.", "rcc_requirement": "Preserve complete unregistered client business fields on the first attempt. A field name is not typed control authority and cannot authorize deletion or rejection."}
  ]
}
