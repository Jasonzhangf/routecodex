{
  "schema_version": 1,
  "case_id": "usage-missing-or-null-preserved",
  "cell": {"entry_protocol": "openai_chat", "provider_protocol": "openai_chat", "transport": "json", "mode": "direct"},
  "client_request": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "headers": {"content-type": "application/json"},
    "body": {"model": "mock.chat-model", "messages": [{"role": "user", "content": "hello"}], "stream": false}
  },
  "expected_provider": {
    "paths": ["/v1/chat/completions"],
    "method": "POST",
    "auth_required": true,
    "body_must": {"model": "chat-model", "stream": false},
    "body_must_not": ["routecodex_internal", "metadata_center", "debug_snapshot"],
    "exact": null
  },
  "upstream_response": {
    "protocol": "openai_chat",
    "mode": "json",
    "status": 200,
    "content_type": "application/json",
    "body": {"id": "chatcmpl_usage_missing", "object": "chat.completion", "choices": [{"index": 0, "message": {"role": "assistant", "content": "ok"}, "finish_reason": "stop"}], "usage": {"prompt_tokens": 7, "completion_tokens": 2, "total_tokens": null, "prompt_tokens_details": {"cached_tokens": null}}}
  },
  "expected_client": {
    "transport": "complete",
    "status": 200,
    "body_must": {"choices.0.message.content": "ok", "usage.prompt_tokens": 7, "usage.completion_tokens": 2, "usage.total_tokens": null, "usage.prompt_tokens_details.cached_tokens": null},
    "body_must_not": ["provider_error", "internal_error", "routecodex_internal", "metadata_center"],
    "semantic_terminal_required": true
  },
  "assertions": {"provider_attempt_count": 1, "probe_attempts_may_occur": true, "no_control_leakage": true},
  "source": {
    "sha": "bfaedf18301d02a423bd5422d22e41432d231ab8",
    "files": ["internal/gateway/translate_stream_test.go"],
    "tests": ["internal/gateway/translate_stream_test.go::TestChatTranslationUsageBeforeUnindexedChoice"],
    "adaptation": "The explicit nulls are the stimulus; the independent assertion is that null is preserved rather than coerced to zero."
  },
  "contract_differences": [
    {"source_behavior": "Magpie often omits or zero-fills absent usage counts.", "rcc_requirement": "Preserve missing versus zero and do not fabricate zeros."}
  ]
}
