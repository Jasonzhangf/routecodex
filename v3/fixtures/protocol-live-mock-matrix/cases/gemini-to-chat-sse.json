    "body_must_not": ["routecodex_internal", "metadata_center", "debug_snapshot"],
    "exact": null
  },
  "upstream_response": {
    "protocol": "openai_chat",
    "mode": "sse",
    "status": 200,
    "content_type": "text/event-stream",
    "sse_events": [
      {"data": {"id": "chatcmpl_gemini_to_chat_sse", "object": "chat.completion.chunk", "choices": [{"index": 0, "delta": {"role": "assistant", "content": "ok"}}]}},
      {"data": {"id": "chatcmpl_gemini_to_chat_sse", "object": "chat.completion.chunk", "choices": [{"index": 0, "delta": {}, "finish_reason": "stop"}]}},
      {"data": "[DONE]"}
    ]
  },
  "expected_client": {
    "transport": "complete",
    "status": 200,
    "body_must": {"text": "ok", "finishReason": "STOP"},
