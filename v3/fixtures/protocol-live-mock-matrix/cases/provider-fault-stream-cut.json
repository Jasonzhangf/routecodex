{
  "schema_version": 1,
  "case_id": "provider-fault-stream-cut",
  "cell": {"entry_protocol": "openai_chat", "provider_protocol": "openai_chat", "transport": "sse", "mode": "direct"},
  "client_request": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "headers": {"content-type": "application/json"},
    "body": {"model": "mock.chat-model", "messages": [{"role": "user", "content": "hello"}], "stream": true}
  },
  "expected_provider": {
    "paths": ["/v1/chat/completions"],
    "method": "POST",
    "auth_required": true,
    "body_must": {"model": "chat-model", "messages.0.content": "hello", "stream": true},
    "body_must_not": ["routecodex_internal", "metadata_center", "debug_snapshot"],
    "auth_orders": [
      ["Bearer fake-loopback-token-mock-chat-a", "Bearer fake-loopback-token-mock-chat-b"],
      ["Bearer fake-loopback-token-mock-chat-b", "Bearer fake-loopback-token-mock-chat-a"]
    ],
    "exact": null
  },
  "upstream_response": {
    "protocol": "openai_chat",
    "mode": "fault",
    "status": 200,
    "content_type": "text/event-stream",
    "fault": "stream_cut_before_content",
    "close_after_bytes": 64,
    "attempts": [
      {
        "kind": "fault",
        "fault": "stream_cut_before_content",
        "close_after_bytes": 64,
        "sse_events": [
          {"data": {"id": "chatcmpl_cut", "object": "chat.completion.chunk", "choices": [{"index": 0, "delta": {"role": "assistant"}}]}}
        ]
      },
      {
        "kind": "json",
        "status": 200,
        "content_type": "application/json",
        "body": {"id": "chatcmpl_recovered", "object": "chat.completion", "choices": [{"index": 0, "message": {"role": "assistant", "content": "ok"}, "finish_reason": "stop"}], "usage": {"prompt_tokens": 7, "completion_tokens": 2, "total_tokens": 9}}
      }
    ]
  },
  "expected_client": {
    "transport": "complete",
    "status": 200,
    "body_must": {"choices.0.message.content": "ok", "choices.0.finish_reason": "stop"},
    "body_must_not": ["provider_error", "internal_error", "routecodex_internal", "metadata_center", "EOF"],
    "semantic_terminal_required": true
  },
  "assertions": {"provider_attempt_count": 2, "probe_attempts_may_occur": true, "no_control_leakage": true},
  "runtime_setup": {
    "provider_id": "mock-chat-a",
    "model": "mock.chat-model",
    "wire_model": "chat-model",
    "candidate_ids": ["mock-chat-a/mock.chat-model", "mock-chat-b/mock.chat-model"]
  },
  "source": {
    "sha": "bfaedf18301d02a423bd5422d22e41432d231ab8",
    "files": ["internal/gateway/stream_cut_test.go"],
    "tests": ["internal/gateway/stream_cut_test.go::TestStreamCutBeforeContentTriedAgain"],
    "adaptation": "The first attempt cuts before content; the second returns a complete response. RCC must not expose the cut or the EOF."
  },
  "contract_differences": [
    {"source_behavior": "Magpie retries the cut before content inside the same turn.", "rcc_requirement": "Recovery stays internal, the client sees only the deliverable attempt, and no implicit same-candidate retry is used."}
  ]
}
