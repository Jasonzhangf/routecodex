                     choice
                         .get("finish_reason")
                         .and_then(serde_json::Value::as_str)
                         .is_some_and(|reason| !reason.is_empty())
                 })
             }),
         "anthropic" => {
             object.get("type").and_then(serde_json::Value::as_str) == Some("message")
                 && object
                     .get("stop_reason")
