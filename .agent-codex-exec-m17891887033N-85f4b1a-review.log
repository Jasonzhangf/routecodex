+    // 窗口同时清空；后续 100 次成功仍只按最近 100 次调用计分。
+    assert_eq!(success.score_milli, 100);
     for now_ms in 102..202 {
         store
             .record_provider_key_success("p", "k", "m", now_ms)
             .expect("success");
     }
     let after = store
         .scheduling_projection("p", "k", "m", 100, 1, 202)
         .expect("projection");
     assert_eq!(after.score_milli, 150);
