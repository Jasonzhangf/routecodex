    {"id":"执行请求处置","operator":"routecodex.v3.runtime.recovery_execute_step","operator_version":"1","inputs":["request-step"],"output":{"id":"request-disposition","schema":"Any","schema_ref":"v3.provider_request.arc.disposition"},"input_selector":{"include":[],"exclude":[],"predicate":null},"output_selector":{"include":[],"exclude":[],"predicate":null},"iterator":"Whole","resources":{"reads":["v3.runtime.request_control"],"writes":["v3.runtime.request_control"]}}
  ],
  "edges": [
