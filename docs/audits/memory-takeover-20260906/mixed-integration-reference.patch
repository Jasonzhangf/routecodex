+/// Provider-visible business projection. This type intentionally does not
+/// implement `Serialize`: only `text` is mounted by the protocol owner, while
+/// the count/truncation fields remain local diagnostics.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct MemoryRecallProjectionV1 {
+    text: String,
+    included_entries: usize,
+    truncated: bool,
+}
+
+impl MemoryRecallProjectionV1 {
+    /// Enabled Skill projection with no recalled entries. The protocol hook
+    /// still mounts schema guidance, while the empty recall body stays
+    /// absent from the provider-visible text.
+    pub fn empty() -> Self {
+        Self {
+            text: String::new(),
+            included_entries: 0,
+            truncated: false,
+        }
+    }
+
+    pub fn text(&self) -> &str {
+        &self.text
+    }
+
+    pub fn included_entries(&self) -> usize {
+        self.included_entries
+    }
+
+    pub fn truncated(&self) -> bool {
+        self.truncated
+    }
+}
+
+/// Immutable typed snapshot read by Req04. The generation and content hash
+/// are host-side identity; `project` renders business fields only.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct MemoryRecallSnapshotV1 {
+    generation: u64,
+    content_hash: String,
+    entries: Vec<MemoryIndexEntryDraftV1>,
+}
+
+impl MemoryRecallSnapshotV1 {
+    pub fn new(generation: u64, entries: Vec<MemoryIndexEntryDraftV1>) -> Self {
+        let entries = entries
+            .into_iter()
+            .map(MemoryIndexEntryDraftV1::normalized)
+            .collect::<Vec<_>>();
+        let bytes = serde_json::to_vec(&entries).expect("memory recall entries are serializable");
+        let content_hash = stable_content_hash(&bytes);
+        Self {
+            generation,
+            content_hash,
+            entries,
+        }
+    }
+
+    pub fn generation(&self) -> u64 {
+        self.generation
+    }
+
+    /// Host identity used by the immutable snapshot boundary. It is exposed
+    /// for typed bookkeeping only and is never included in provider text.
+    pub fn content_hash(&self) -> &str {
+        &self.content_hash
+    }
+
+    pub fn entries(&self) -> &[MemoryIndexEntryDraftV1] {
+        &self.entries
+    }
+
+    pub fn project(&self, limits: MemoryRecallLimits) -> Option<MemoryRecallProjectionV1> {
+        if limits.max_entries == 0 || limits.max_chars == 0 {
+            return None;
+        }
+        let marker_chars = MEMORY_RECALL_MARKER_V1.chars().count();
+        if marker_chars > limits.max_chars {
+            return None;
+        }
+        let mut text = MEMORY_RECALL_MARKER_V1.to_string();
+        let mut included_entries = 0usize;
+        let mut truncated = false;
+        for (index, entry) in self.entries.iter().enumerate() {
+            if index >= limits.max_entries {
+                truncated = true;
+                break;
+            }
+            let line = render_recall_entry(entry);
+            let used = text.chars().count();
+            let available = limits.max_chars.saturating_sub(used);
+            if available == 0 {
+                truncated = true;
+                break;
+            }
+            if line.chars().count() <= available {
+                text.push_str(&line);
+                included_entries += 1;
+                continue;
+            }
+            text.extend(line.chars().take(available));
+            included_entries += 1;
+            truncated = true;
+            break;
+        }
+        (included_entries > 0).then_some(MemoryRecallProjectionV1 {
+            text,
+            included_entries,
+            truncated,
+        })
+    }
+}
+
+fn render_recall_entry(entry: &MemoryIndexEntryDraftV1) -> String {
+    let mut line = format!("\n- {}: {}", entry.title, entry.summary);
+    if !entry.tags.is_empty() {
+        line.push_str(" | tags: ");
+        line.push_str(&entry.tags.join(", "));
+    }
+    if !entry.entities.is_empty() {
+        line.push_str(" | entities: ");
+        line.push_str(&entry.entities.join(", "));
+    }
+    line
+}
