+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct MemoryEnvelopeShape {
+    #[serde(default)]
+    entries: Vec<Value>,
+}
+
+/// Observe an optional memory sibling without rejecting or rewriting the
+/// parent response. Entry validation is deliberately local and best-effort.
+pub fn observe_memory_output(output_json: &str, source: &MemorySourceWindow) -> MemoryObservation {
+    let root: Value = match serde_json::from_str(output_json) {
+        Ok(value) => value,
+        Err(_) => {
+            return MemoryObservation {
+                accepted: Vec::new(),
+                diagnostics: vec![MemoryDiagnostic::global("memory_parse_invalid")],
+            }
+        }
+    };
+    let Some(memory) = root.get("memory") else {
+        return MemoryObservation {
+            accepted: Vec::new(),
+            diagnostics: Vec::new(),
+        };
+    };
+    if source.validate().is_err() {
+        return MemoryObservation {
+            accepted: Vec::new(),
+            diagnostics: vec![MemoryDiagnostic::global("memory_source_window_invalid")],
+        };
+    }
+    let envelope: MemoryEnvelopeShape = match serde_json::from_value(memory.clone()) {
+        Ok(value) => value,
+        Err(_) => {
+            return MemoryObservation {
+                accepted: Vec::new(),
+                diagnostics: vec![MemoryDiagnostic::global("memory_envelope_schema_invalid")],
+            }
+        }
+    };
+    let mut observed = MemoryObservation {
+        accepted: Vec::new(),
+        diagnostics: Vec::new(),
+    };
+    for (entry_index, value) in envelope.entries.into_iter().enumerate() {
+        let entry: MemoryIndexEntryDraftV1 = match serde_json::from_value(value) {
+            Ok(entry) => entry,
+            Err(_) => {
+                observed.diagnostics.push(MemoryDiagnostic::entry(
+                    "memory_entry_schema_invalid",
+                    entry_index,
+                ));
+                continue;
+            }
+        };
+        if entry.validate(source).is_err() {
+            observed
+                .diagnostics
+                .push(MemoryDiagnostic::entry("memory_entry_invalid", entry_index));
+            continue;
+        }
+        observed.accepted.push(entry.normalized());
+    }
+    observed
+}
