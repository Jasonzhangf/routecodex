+#[test]
+fn relay_req04_uses_declared_order_and_operation_gates() {
+    let manifest = relay_manifest();
+    let root = std::env::temp_dir().join(format!(
+        "routecodex-v3-relay-hook-operation-{}",
+        std::process::id()
+    ));
+    let _ = std::fs::remove_dir_all(&root);
+    let skill = Arc::new(MemorySkillHandle::open(&root).expect("memory skill"));
+    let plan = compile_v3_hub_hook_operation_plan(&manifest, Some(skill)).expect("hook plan");
+    assert!(plan.operation_enabled(
+        V3HubFixedNode::V3HubReqChatProcess04Governed,
+        V3HubHookPhase::Entry,
+        V3HubOperationKind::MemorySkillContextProjection
+    ));
+    let mut body = json!({
+        "model": "client-model",
+        "messages": [{"role":"user","content":"hello"}],
+        "tools": [{"type":"function","name":"lookup","parameters":{"type":"object","properties":{}}}]
+    });
+    let (trace, _events, tool_context) = run_req04(&manifest, &mut body, plan);
+    assert_eq!(
+        trace,
+        vec![
+            "V3HubHookOperationStoplessReq04",
+            "V3HubHookOperationStoplessWebSearchReq04",
+            "V3HubHookOperationToolreasonReq04",
+            "V3HubHookOperationMemorySkillContextProjection",
+            "V3AgentMemoryReq04RecallProjection",
+        ]
+    );
+    assert!(tool_context.enabled_flag());
+    assert!(body["tools"][0]["parameters"]["properties"]["reason"].is_object());
+    assert!(body["messages"].as_array().is_some_and(|messages| messages.len() == 2));
+
+    let mut disabled_manifest = manifest.clone();
+    disabled_manifest
+        .hub_v1
+        .as_mut()
+        .expect("Hub v1")
+        .hooks
+        .iter_mut()
+        .find(|hook| {
+            hook.node == V3HubFixedNode::V3HubReqChatProcess04Governed
+                && hook.phase == V3HubHookPhase::Entry
+        })
+        .expect("Req04 hook")
+        .operation_ids
+        .retain(|id| id != "routecodex.toolreason.req04.v1");
+    let disabled_plan = compile_v3_hub_hook_operation_plan(
+        &disabled_manifest,
+        Some(Arc::new(
+            MemorySkillHandle::open(std::env::temp_dir().join(format!(
+                "routecodex-v3-relay-hook-operation-disabled-{}",
+                std::process::id()
+            )))
+            .expect("disabled memory skill"),
+        )),
+    )
+    .expect("disabled hook plan");
+    let mut disabled_body = json!({
+        "model": "client-model",
+        "messages": [{"role":"user","content":"hello"}],
+        "tools": [{"type":"function","name":"lookup","parameters":{"type":"object","properties":{}}}]
+    });
+    let (disabled_trace, _, disabled_context) =
+        run_req04(&disabled_manifest, &mut disabled_body, disabled_plan);
+    assert!(!disabled_trace.contains(&"V3HubHookOperationToolreasonReq04"));
+    assert!(!disabled_context.enabled_flag());
