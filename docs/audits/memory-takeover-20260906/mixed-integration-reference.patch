+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct MemoryRecallLimits {
+    pub max_entries: usize,
+    pub max_chars: usize,
+}
+
+impl MemoryRecallLimits {
+    pub const fn new(max_entries: usize, max_chars: usize) -> Self {
+        Self {
+            max_entries,
+            max_chars,
+        }
+    }
+}
+
+impl Default for MemoryRecallLimits {
+    fn default() -> Self {
+        Self::new(
+            DEFAULT_MEMORY_RECALL_MAX_ENTRIES,
+            DEFAULT_MEMORY_RECALL_MAX_CHARS,
+        )
+    }
+}
