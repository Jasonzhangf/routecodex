+#[derive(Clone)]
+pub struct MemoryObserverHandle {
+    inner: std::sync::Arc<std::sync::Mutex<PendingMemoryObserver>>,
+}
+
+impl std::fmt::Debug for MemoryObserverHandle {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.write_str("MemoryObserverHandle(<pending-index>)")
+    }
+}
+
+impl MemoryObserverHandle {
+    pub fn new(observer: PendingMemoryObserver) -> Self {
+        Self {
+            inner: std::sync::Arc::new(std::sync::Mutex::new(observer)),
+        }
+    }
+
+    pub fn open(root: impl AsRef<Path>) -> Result<Self, PendingIndexError> {
+        Ok(Self::new(PendingMemoryObserver::open(root)?))
+    }
+
+    pub fn observe_completed_stop_json(
+        &self,
+        proof: CanonicalCompletedStopProof,
+        output_json: &str,
+        source: MemorySourceWindow,
+    ) -> Result<MemoryAdmissionReport, String> {
+        self.inner
+            .lock()
+            .map_err(|error| error.to_string())
+            .map(|mut observer| observer.observe_completed_stop_json(proof, output_json, source))
+    }
+
+    pub fn pending_entries(&self) -> Result<Vec<PendingIndexEntry>, String> {
+        self.inner
+            .lock()
+            .map_err(|error| error.to_string())
+            .map(|observer| observer.pending().active_entries().to_vec())
+    }
+}
