+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct MemorySourceWindow {
+    pub kind: MemorySourceKind,
+    pub event_refs: Vec<String>,
+}
+
+impl MemorySourceWindow {
+    pub fn new<I, S>(kind: MemorySourceKind, event_refs: I) -> Self
+    where
+        I: IntoIterator<Item = S>,
+        S: Into<String>,
+    {
+        Self {
+            kind,
+            event_refs: event_refs.into_iter().map(Into::into).collect(),
+        }
+    }
+
+    fn validate(&self) -> Result<(), &'static str> {
+        if self.event_refs.is_empty()
+            || self
+                .event_refs
+                .iter()
+                .any(|event_ref| event_ref.trim().is_empty())
+        {
+            return Err("source event refs are required");
+        }
+        Ok(())
+    }
+}
