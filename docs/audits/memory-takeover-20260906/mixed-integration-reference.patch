+fn agent_memory_test_hub_manifest() -> routecodex_v3_config::V3HubV1Manifest {
+    use routecodex_v3_config::{
+        V3HubFixedNode, V3HubHookManifest, V3HubHookPhase, V3HubHookRequirement,
+        V3HubOperationFailurePolicy, V3HubOperationKind, V3HubOperationManifest, V3HubV1Manifest,
+    };
+
+    let operation = |operation_id: &str,
+                     kind: V3HubOperationKind,
+                     node: V3HubFixedNode,
+                     phase: V3HubHookPhase,
+                     failure_policy: V3HubOperationFailurePolicy| {
+        V3HubOperationManifest {
+            operation_id: operation_id.to_string(),
+            owner: "routecodex-v3-test-hook".to_string(),
+            kind,
+            node,
+            phase,
+            failure_policy,
+            allow_reuse: false,
+        }
+    };
+    let request_node = V3HubFixedNode::V3HubReqChatProcess04Governed;
+    let response_node = V3HubFixedNode::V3HubRespChatProcess03Governed;
+    let operations = vec![
+        operation(
+            "routecodex.memory.skill.context.v1",
+            V3HubOperationKind::MemorySkillContextProjection,
+            request_node,
+            V3HubHookPhase::Entry,
+            V3HubOperationFailurePolicy::Abort,
+        ),
+        operation(
+            "routecodex.stopless.req04.v1",
+            V3HubOperationKind::StoplessReq04,
+            request_node,
+            V3HubHookPhase::Entry,
+            V3HubOperationFailurePolicy::Abort,
+        ),
+        operation(
+            "routecodex.toolreason.req04.v1",
+            V3HubOperationKind::ToolreasonReq04,
+            request_node,
+            V3HubHookPhase::Entry,
+            V3HubOperationFailurePolicy::Abort,
+        ),
+        operation(
+            "routecodex.toolreason.resp03.v1",
+            V3HubOperationKind::ToolreasonResp03,
+            response_node,
+            V3HubHookPhase::Entry,
+            V3HubOperationFailurePolicy::Observe,
+        ),
+        operation(
+            "routecodex.stopless.resp03.v1",
+            V3HubOperationKind::StoplessResp03,
+            response_node,
+            V3HubHookPhase::Entry,
+            V3HubOperationFailurePolicy::Abort,
+        ),
+        operation(
+            "routecodex.toolreason.sse-resp03.v1",
+            V3HubOperationKind::ToolreasonSseResp03,
+            response_node,
+            V3HubHookPhase::Exit,
+            V3HubOperationFailurePolicy::Observe,
+        ),
+        operation(
+            "routecodex.memory.skill.terminal.v1",
+            V3HubOperationKind::MemorySkillTerminalObservation,
+            response_node,
+            V3HubHookPhase::Exit,
+            V3HubOperationFailurePolicy::Observe,
+        ),
+    ];
+    let operation_ids = |node: V3HubFixedNode, phase: V3HubHookPhase| match (node, phase) {
+        (V3HubFixedNode::V3HubReqChatProcess04Governed, V3HubHookPhase::Entry) => vec![
+            "routecodex.memory.skill.context.v1".to_string(),
+            "routecodex.stopless.req04.v1".to_string(),
+            "routecodex.toolreason.req04.v1".to_string(),
+        ],
+        (V3HubFixedNode::V3HubRespChatProcess03Governed, V3HubHookPhase::Entry) => vec![
+            "routecodex.toolreason.resp03.v1".to_string(),
+            "routecodex.stopless.resp03.v1".to_string(),
+        ],
+        (V3HubFixedNode::V3HubRespChatProcess03Governed, V3HubHookPhase::Exit) => vec![
+            "routecodex.toolreason.sse-resp03.v1".to_string(),
+            "routecodex.memory.skill.terminal.v1".to_string(),
+        ],
+        _ => Vec::new(),
+    };
+    let hooks = V3HubFixedNode::ALL
+        .into_iter()
+        .flat_map(|node| V3HubHookPhase::ALL.into_iter().map(move |phase| (node, phase)))
+        .enumerate()
+        .map(|(order, (node, phase))| V3HubHookManifest {
+            hook_id: format!(
+                "hub_v1.{}.{}.not_implemented",
+                node.node_id(),
+                phase.as_str()
+            ),
+            node,
+            phase,
+            requirement: V3HubHookRequirement::Required,
+            enabled: true,
+            priority: 0,
+            order: order as u32,
+            allowed_resources: Vec::new(),
+            forbidden_resources: Vec::new(),
+            profile: None,
+            operation_ids: operation_ids(node, phase),
+        })
+        .collect();
+    V3HubV1Manifest {
+        skeleton: "hub_v1".to_string(),
+        entry_protocols: vec![
+            "responses".to_string(),
+            "anthropic".to_string(),
+            "gemini".to_string(),
+            "openai_chat".to_string(),
+        ],
+        hook_set_id: "test.hooks".to_string(),
+        operation_set_id: "test.operations".to_string(),
+        entry_protocol_bindings: Vec::new(),
+        resources: BTreeMap::new(),
+        hooks,
+        operations,
+    }
+}
