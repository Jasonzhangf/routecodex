+/// Model-owned business content. Host control fields are intentionally kept
+/// in [`PendingIndexEntry`] and never serialized into this draft.
+#[derive(Debug, Clone, PartialEq, Eq, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct MemoryIndexEntryDraftV1 {
+    pub schema: String,
+    pub operation: MemoryOperation,
+    #[serde(default, rename = "targetMemoryId")]
+    pub target_memory_id: Option<String>,
+    pub scope: MemoryScope,
+    pub kind: MemoryKind,
+    pub title: String,
+    pub summary: String,
+    pub tags: Vec<String>,
+    pub entities: Vec<String>,
+}
+
+impl MemoryIndexEntryDraftV1 {
+    fn validate(&self, source: &MemorySourceWindow) -> Result<(), &'static str> {
+        if self.schema != MEMORY_ENTRY_SCHEMA_V1 {
+            return Err("schema must be routecodex.memory.index-entry.v1");
+        }
+        if self.title.trim().is_empty() || self.summary.trim().is_empty() {
+            return Err("title and summary must be non-empty");
+        }
+        if !matches!(self.operation, MemoryOperation::Add)
+            && self
+                .target_memory_id
+                .as_deref()
+                .is_none_or(|target| target.trim().is_empty())
+        {
+            return Err("non-add operation requires target_memory_id");
+        }
+        source.validate()?;
+        if matches!(source.kind, MemorySourceKind::ToolCall)
+            && contains_future_tool_claim(&self.summary)
+        {
+            return Err("tool-call entry claims a future/current tool result");
+        }
+        Ok(())
+    }
+
+    fn normalized(mut self) -> Self {
+        self.title = self.title.trim().to_string();
+        self.summary = self.summary.trim().to_string();
+        self.tags = normalize_tags(self.tags);
+        self.entities = normalize_entities(self.entities);
+        self.target_memory_id = self
+            .target_memory_id
+            .map(|target| target.trim().to_string())
+            .filter(|target| !target.is_empty());
+        self
+    }
+}
+
+fn contains_future_tool_claim(summary: &str) -> bool {
+    let summary = summary.to_ascii_lowercase();
+    [
+        "current tool",
+        "tool succeeded",
+        "tool result",
+        "will return",
+    ]
+    .iter()
+    .any(|marker| summary.contains(marker))
+}
+
+fn normalize_tags(tags: Vec<String>) -> Vec<String> {
+    tags.into_iter()
+        .map(|tag| tag.trim().to_ascii_lowercase())
+        .filter(|tag| !tag.is_empty())
+        .collect::<BTreeSet<_>>()
+        .into_iter()
+        .collect()
+}
+
+fn normalize_entities(entities: Vec<String>) -> Vec<String> {
+    entities
+        .into_iter()
+        .map(|entity| entity.trim().to_string())
+        .filter(|entity| !entity.is_empty())
+        .collect::<BTreeSet<_>>()
+        .into_iter()
+        .collect()
+}
