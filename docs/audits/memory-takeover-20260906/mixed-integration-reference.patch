+use super::*;
+
+#[test]
+fn strict_memory_entry_schema_rejects_unknown_fields() {
+    let output = r#"{
+        "memory": {
+            "entries": [{
+                "schema": "routecodex.memory.index-entry.v1",
+                "operation": "add",
+                "scope": "project",
+                "kind": "fact",
+                "title": "Pinned target",
+                "summary": "The explicit provider target is retained.",
+                "tags": ["routing"],
+                "entities": ["routecodex"],
+                "unexpected": "must fail"
+            }]
+        }
+    }"#;
+    let source = MemorySourceWindow::new(MemorySourceKind::EndTurn, ["evt-1"]);
+    let observed = observe_memory_output(output, &source);
+    assert!(observed.accepted.is_empty());
+    assert_eq!(observed.diagnostics.len(), 1);
+    assert_eq!(observed.diagnostics[0].code, "memory_entry_schema_invalid");
+}
+
+#[test]
+fn missing_memory_is_a_soft_noop() {
+    let source = MemorySourceWindow::new(MemorySourceKind::EndTurn, ["evt-1"]);
+    let observed = observe_memory_output(r#"{"output":"normal response"}"#, &source);
+    assert!(observed.accepted.is_empty());
+    assert!(observed.diagnostics.is_empty());
+}
+
+#[test]
+fn malformed_root_json_is_a_diagnostic_only() {
+    let source = MemorySourceWindow::new(MemorySourceKind::EndTurn, ["evt-parse"]);
+    let observed = observe_memory_output(r#"{"status":"completed""#, &source);
+    assert!(observed.accepted.is_empty());
+    assert_eq!(observed.diagnostics.len(), 1);
+    assert_eq!(observed.diagnostics[0].code, "memory_parse_invalid");
+    assert!(observed.diagnostics[0].entry_index.is_none());
+}
+
+#[test]
+fn unknown_memory_envelope_fields_are_diagnostic_only() {
+    let output = r#"{
+        "memory": {
+            "entries": [],
+            "unexpected": true
+        }
+    }"#;
+    let source = MemorySourceWindow::new(MemorySourceKind::EndTurn, ["evt-1"]);
+    let observed = observe_memory_output(output, &source);
+    assert!(observed.accepted.is_empty());
+    assert_eq!(observed.diagnostics.len(), 1);
+    assert_eq!(
+        observed.diagnostics[0].code,
+        "memory_envelope_schema_invalid"
+    );
+}
+
+#[test]
+fn memory_envelope_entries_are_optional() {
+    let source = MemorySourceWindow::new(MemorySourceKind::CompactionSummary, ["evt-summary"]);
+    let observed = observe_memory_output(r#"{"memory": {}}"#, &source);
+    assert!(observed.accepted.is_empty());
+    assert!(observed.diagnostics.is_empty());
+}
+
+#[test]
+fn mixed_entries_accept_valid_and_diagnose_invalid_without_blocking_parent() {
+    let output = r#"{
+        "output": "parent remains successful",
+        "memory": {
+            "entries": [
+                {
+                    "schema": "routecodex.memory.index-entry.v1",
+                    "operation": "add",
+                    "scope": "project",
+                    "kind": "fact",
+                    "title": "Pinned target",
+                    "summary": "The explicit provider target is retained.",
+                    "tags": [" Routing ", "routing"],
+                    "entities": ["routecodex"]
+                },
+                {
+                    "schema": "routecodex.memory.index-entry.v1",
+                    "operation": "revise",
+                    "scope": "project",
+                    "kind": "decision",
+                    "title": "Missing target",
+                    "summary": "This entry is rejected locally.",
