+            "model":"anthropic-client",
+            "max_tokens":64,
+            "messages":[{"role":"user","content":"provider is unavailable"}],
+            "stream":false
+        }))
+        .send()
+        .await
+        .unwrap();
+    assert_eq!(json_response.status(), StatusCode::BAD_GATEWAY);
