+use crate::{
+    MemoryKnowledgeStore, MemoryKnowledgeStoreError, MemoryLevelOneIndexV1, MemoryObserverHandle,
+    MemoryRecallLimits, MemoryRecallProjectionV1, MemoryRecallSnapshotV1, MemorySourceWindow,
+    CanonicalCompletedStopProof, MemoryAdmissionReport, PendingIndex, PendingIndexError,
+    PendingMemoryObserver, SkillIndexError,
+};
+use std::path::{Path, PathBuf};
+use thiserror::Error;
+
+/// Skill-owned memory operations. The runtime may invoke this handle only via
+/// its typed context-projection and terminal-observation methods; it never
+/// reads the snapshot, generation, hash, or index directly.
+#[derive(Clone, Debug)]
+pub struct MemorySkillHandle {
+    root: PathBuf,
+    observer: MemoryObserverHandle,
+    knowledge: MemoryKnowledgeStore,
+    skill_index: MemoryLevelOneIndexV1,
+    recall_snapshot: MemoryRecallSnapshotV1,
+}
+
+#[derive(Debug, Error)]
+pub enum MemoryRuntimeError {
+    #[error("memory runtime pending store failed: {0}")]
+    Pending(#[from] PendingIndexError),
+    #[error("memory runtime knowledge store failed: {0}")]
+    Knowledge(#[from] MemoryKnowledgeStoreError),
+    #[error("memory runtime skill index failed: {0}")]
+    Skills(#[from] SkillIndexError),
+}
+
+impl MemorySkillHandle {
+    /// Open and recover all durable memory stores under `root`.
+    ///
+    /// Recovery runs before the snapshot is created, so prepared organization
+    /// transactions cannot leak partial knowledge into Req04 recall. Any
+    /// corrupt journal fails startup; callers must not substitute an empty or
+    /// in-memory store.
+    pub fn open(root: impl AsRef<Path>) -> Result<Self, MemoryRuntimeError> {
+        let root = root.as_ref().to_path_buf();
+        let mut pending = PendingIndex::open(root.join("pending"))?;
+        let mut knowledge = MemoryKnowledgeStore::open(root.join("knowledge"))?;
+        knowledge.recover_pending(&mut pending)?;
+        let recall_snapshot = knowledge.recall_snapshot(pending.generation());
+        let skill_index = MemoryLevelOneIndexV1::open(root.join("index"))?;
+        let observer = MemoryObserverHandle::new(PendingMemoryObserver::from_pending(pending));
+        Ok(Self {
+            root,
+            observer,
+            knowledge,
+            skill_index,
+            recall_snapshot,
+        })
+    }
+
+    pub fn root(&self) -> &Path {
+        &self.root
+    }
+
+    pub fn observer(&self) -> MemoryObserverHandle {
+        self.observer.clone()
+    }
+
+    pub fn recall_snapshot(&self) -> MemoryRecallSnapshotV1 {
+        self.recall_snapshot.clone()
+    }
+
+    /// Execute the Skill context projection operation. The returned text is
+    /// the only memory value allowed to cross into a provider request.
+    pub fn project_context(
+        &self,
+        limits: MemoryRecallLimits,
+    ) -> Option<MemoryRecallProjectionV1> {
+        self.recall_snapshot.project(limits)
+    }
+
+    /// Execute the Skill terminal-observation operation. Schema admission and
+    /// append-only persistence remain entirely inside the Skill owner.
+    pub fn observe_terminal(
+        &self,
+        proof: CanonicalCompletedStopProof,
+        output_json: &str,
+        source: MemorySourceWindow,
+    ) -> Result<MemoryAdmissionReport, String> {
+        self.observer
+            .observe_completed_stop_json(proof, output_json, source)
+    }
+
+    pub fn pending_entries(&self) -> Result<Vec<crate::PendingIndexEntry>, String> {
+        self.observer.pending_entries()
+    }
+
+    pub fn skill_references(&self) -> Vec<crate::MemorySkillReferenceV1> {
+        self.skill_index.references()
+    }
+
+    /// Number of committed raw knowledge entries loaded during startup.
+    /// This remains a host-side diagnostic and is never rendered into a
+    /// provider payload.
+    pub fn committed_knowledge_entries(&self) -> usize {
+        self.knowledge.raw_entries().len()
+    }
+}
diff --git a/v3/crates/routecodex-v3-agent-memory/src/skill_index.rs b/v3/crates/routecodex-v3-agent-memory/src/skill_index.rs
