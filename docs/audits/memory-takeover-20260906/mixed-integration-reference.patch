+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct CanonicalCompletedStopProof {
+    _private: (),
+}
+
+impl CanonicalCompletedStopProof {
+    pub fn from_fields(response_status: Option<&str>, finish_reason: Option<&str>) -> Option<Self> {
+        (response_status == Some("completed") && finish_reason == Some("stop"))
+            .then_some(Self { _private: () })
+    }
+
+    /// Responses native SSE has no wire `finish_reason`; its typed terminal
+    /// event is the protocol-level stop proof. Keep this constructor narrow:
+    /// only the registered `response.completed` event with an explicit nested
+    /// `response.status=completed` may use it. Generic JSON bodies must still
+    /// provide the literal completed/stop pair through [`from_fields`].
+    pub fn from_responses_completed_event(
+        event_type: Option<&str>,
+        response_status: Option<&str>,
+    ) -> Option<Self> {
+        (event_type == Some("response.completed") && response_status == Some("completed"))
+            .then_some(Self { _private: () })
+    }
+}
