+/// Compiled operation order for the fixed Hub v1 skeleton.
+///
+/// The plan owns only immutable operation declarations and the optional Skill
+/// handle. It is the sole runtime boundary for memory/stopless/toolreason
+/// business operations; callers must not carry their individual state.
+#[derive(Debug, Clone)]
+pub struct V3HubHookOperationPlan {
+    operation_set_id: String,
+    operations: BTreeMap<String, V3HubOperationManifest>,
+    sequences: BTreeMap<(V3HubFixedNode, V3HubHookPhase), Vec<String>>,
+    memory_skill: Option<Arc<MemorySkillHandle>>,
+}
+
+impl V3HubHookOperationPlan {
+    pub fn compile(
+        manifest: &V3HubV1Manifest,
+        memory_skill: Option<Arc<MemorySkillHandle>>,
+    ) -> Result<Self, V3HubHookOperationPlanError> {
+        if manifest.operation_set_id.trim().is_empty() {
+            return Err(V3HubHookOperationPlanError::MissingOperationSetId);
+        }
+        crate::hub_v1::validate_v3_hub_v1_hook_manifest(manifest)
+            .map_err(|error| V3HubHookOperationPlanError::Invalid(error.to_string()))?;
+
+        let mut operations = BTreeMap::new();
+        for operation in &manifest.operations {
+            if operations
+                .insert(operation.operation_id.clone(), operation.clone())
+                .is_some()
+            {
+                return Err(V3HubHookOperationPlanError::DuplicateOperation {
+                    operation_id: operation.operation_id.clone(),
+                });
+            }
+        }
+        let mut sequences = BTreeMap::new();
+        for hook in &manifest.hooks {
+            let mut sequence = Vec::with_capacity(hook.operation_ids.len());
+            let mut seen = BTreeSet::new();
+            for operation_id in &hook.operation_ids {
+                if !seen.insert(operation_id) {
+                    return Err(V3HubHookOperationPlanError::Invalid(format!(
+                        "hook {} repeats operation {}",
+                        hook.hook_id, operation_id
+                    )));
+                }
+                let Some(operation) = operations.get(operation_id) else {
+                    return Err(V3HubHookOperationPlanError::UnknownOperation {
+                        operation_id: operation_id.clone(),
+                    });
+                };
+                if operation.node != hook.node || operation.phase != hook.phase {
+                    return Err(V3HubHookOperationPlanError::Invalid(format!(
+                        "operation {} is incompatible with hook {} {}",
+                        operation_id,
+                        hook.node.node_id(),
+                        hook.phase.as_str()
+                    )));
+                }
+                sequence.push(operation_id.clone());
+            }
+            sequences.insert((hook.node, hook.phase), sequence);
+        }
+        Ok(Self {
+            operation_set_id: manifest.operation_set_id.clone(),
+            operations,
+            sequences,
+            memory_skill,
+        })
+    }
+
+    pub fn operation_set_id(&self) -> &str {
+        &self.operation_set_id
+    }
+
+    pub fn operation_ids(&self, node: V3HubFixedNode, phase: V3HubHookPhase) -> Vec<&str> {
+        self.sequences
+            .get(&(node, phase))
+            .map(|sequence| sequence.iter().map(String::as_str).collect())
+            .unwrap_or_default()
+    }
+
+    pub fn operation(&self, operation_id: &str) -> Option<&V3HubOperationManifest> {
+        self.operations.get(operation_id)
+    }
+
+    /// Returns true only when the operation kind is actually mounted on this
+    /// node/phase sequence. An operation present in the catalog but absent
+    /// from the hook is not executable.
+    pub fn operation_enabled(
+        &self,
+        node: V3HubFixedNode,
+        phase: V3HubHookPhase,
+        kind: V3HubOperationKind,
+    ) -> bool {
+        self.operation_ids(node, phase).into_iter().any(|operation_id| {
+            self.operation(operation_id)
+                .is_some_and(|operation| operation.kind == kind)
+        })
+    }
+
+    pub fn has_kind(&self, kind: V3HubOperationKind) -> bool {
+        self.operations
+            .values()
+            .any(|operation| operation.kind == kind)
+    }
+
+    pub fn memory_skill(&self) -> Option<&Arc<MemorySkillHandle>> {
+        self.memory_skill.as_ref()
+    }
+
+    pub fn is_empty(&self, node: V3HubFixedNode, phase: V3HubHookPhase) -> bool {
+        self.sequences.get(&(node, phase)).is_none_or(Vec::is_empty)
+    }
+
+    /// Run the ordered Req04 entry operations against the standardized request.
+    /// The execution state is opaque to the kernel; individual business state
+    /// remains owned by the operation implementation.
+    pub(crate) fn run_req04(
+        &self,
+        context: &mut V3Req04HookContext<'_>,
+        state: &mut V3HubHookExecutionState,
+    ) -> Result<(), V3Error01SourceRaised> {
+        if state.req04_complete {
+            return Ok(());
+        }
+        let operation_ids = self.operation_ids(
+            V3HubFixedNode::V3HubReqChatProcess04Governed,
+            V3HubHookPhase::Entry,
+        );
+        for operation_id in operation_ids {
+            let operation = self.operation(operation_id).ok_or_else(|| {
+                self.operation_failure(operation_id, "operation disappeared after compile")
+            })?;
+            context.trace.push(operation_trace_marker(operation.kind));
+            let result: Result<(), V3Error01SourceRaised> = match operation.kind {
+                V3HubOperationKind::MemorySkillContextProjection => {
+                    if !crate::hub_v1::v3_feature_enabled_for_server(
+                        context.manifest,
+                        context.server_id,
+                        "agent_memory",
+                        false,
+                    ) {
+                        Ok(())
+                    } else {
+                        let skill = self.memory_skill.as_ref().ok_or_else(|| {
+                            self.operation_failure(
+                                &operation.operation_id,
+                                "agent_memory is enabled but MemorySkillHandle is missing",
+                            )
+                        })?;
+                        let projection = skill
+                            .project_context(MemoryRecallLimits::default())
+                            .or_else(|| Some(MemoryRecallProjectionV1::empty()));
+                        crate::memory_req04::apply_v3_memory_recall_at_req04(
+                            context.body,
+                            projection.as_ref(),
+                            context.trace,
+                        )
+                        .map_err(|error| self.operation_failure(&operation.operation_id, &error))
+                    }
+                }
+                V3HubOperationKind::StoplessReq04 => {
+                    match crate::kernel::prepare_v3_responses_direct_stopless_control_request(
+                        context.manifest,
+                        context.server_id,
+                        context.stopless_control,
+                        context.stopless_scope,
+                        context.body,
+                        context.request_id,
+                        context.now_epoch_ms,
+                        context.trace,
+                    ) {
+                        Ok(request_state) => {
+                            state.stopless_request_state = request_state;
+                            Ok(())
+                        }
+                        Err(source) => Err(source),
+                    }
+                }
+                V3HubOperationKind::StoplessWebSearchReq04 => {
+                    crate::kernel::prepare_v3_responses_direct_web_search_control_request(
+                        context.manifest,
+                        context.stopless_control,
+                        context.stopless_scope,
+                        context.body,
+                        context.trace,
+                    )?;
+                    crate::kernel::apply_v3_responses_direct_web_search_control_completion(
+                        context.stopless_control,
+                        context.stopless_scope,
+                        context.body,
+                        context.trace,
+                    )
+                }
+                V3HubOperationKind::ToolreasonReq04 => {
+                    apply_toolreason_req04(
+                        context.manifest,
+                        context.server_id,
+                        context.body,
+                        context.tool_thinking_turn_context,
+                        context.request_id,
+                    )
+                    .map_err(|error| self.operation_failure(&operation.operation_id, &error))
+                }
+                _ => Err(self.operation_failure(
+                    &operation.operation_id,
+                    "operation is not valid for Req04 entry",
+                )),
+            };
+            if let Err(error) = result {
+                self.handle_operation_error(operation, error, context.trace)?;
+            }
+        }
+        state.req04_complete = true;
+        Ok(())
+    }
+
+    /// Run the same ordered Req04 operation sequence for Relay. Relay-specific
+    /// continuation/profile state is supplied as typed context; operation
+    /// selection and failure policy remain owned by this compiled plan.
+    pub(crate) fn run_relay_req04(
+        &self,
+        context: &mut V3RelayReq04HookContext<'_>,
+        state: &mut V3HubHookExecutionState,
+    ) -> Result<(), V3Error01SourceRaised> {
+        if state.req04_complete {
+            return Ok(());
+        }
+        let operation_ids = self.operation_ids(
+            V3HubFixedNode::V3HubReqChatProcess04Governed,
+            V3HubHookPhase::Entry,
+        );
+        for operation_id in operation_ids {
+            let operation = self.operation(operation_id).ok_or_else(|| {
+                self.operation_failure(operation_id, "operation disappeared after compile")
+            })?;
+            context.trace.push(operation_trace_marker(operation.kind));
+            let operation_result: Result<(), V3Error01SourceRaised> = match operation.kind {
+                V3HubOperationKind::StoplessReq04 => {
+                    if !context.stopless_reasoning_stop_enabled {
+                        Ok(())
+                    } else {
+                        let restored_state = context.stopless_center_state;
+                        let request_state = crate::hub_v1::apply_v3_stopless_request_hook_at_req04(
+                            context.body,
+                            context.current_payload_start,
+                            context.events,
+                            restored_state,
+                            context.stopless_transition_request_id,
+                            context.stopless_transition_updated_at,
+                        )
+                        .map_err(|error| {
+                            self.operation_failure(
+                                &operation.operation_id,
+                                &error.to_string(),
+                            )
+                        })?
+                        .map(|state| state.with_max_stop_budget_floor(4));
+                        let should_inject_provider_contract = request_state
+                            .as_ref()
+                            .is_some_and(crate::hub_v1::V3StoplessCenterState::schema_guidance_active)
+                            || restored_state
+                                .is_some_and(crate::hub_v1::V3StoplessCenterState::schema_guidance_active)
+                                && context
+                                    .stopless_transition_request_id
+                                    .is_some_and(|request_id| !request_id.trim().is_empty());
+                        if should_inject_provider_contract {
+                            super::stopless_injection::inject_v3_stopless_provider_contract(
+                                context.body,
+                                context.current_payload_start,
+                            )
+                            .map_err(|error| {
+                                self.operation_failure(
+                                    &operation.operation_id,
+                                    &error.to_string(),
+                                )
+                            })?;
+                            context
+                                .events
+                                .push(crate::hub_v1::V3HubRelayRequestHookEvent::Req04StoplessGuidancePrepared);
+                        }
+                        if request_state.is_some() {
+                            context
+                                .events
+                                .push(crate::hub_v1::V3HubRelayRequestHookEvent::Req04ServertoolGoverned);
+                        }
+                        *context.stopless_state = request_state.clone();
+                        state.stopless_request_state = request_state;
+                        Ok(())
+                    }
+                }
+                V3HubOperationKind::StoplessWebSearchReq04 => {
+                    if !context.web_search_mode_b {
+                        Ok(())
+                    } else {
+                        let request_state = crate::hub_v1::apply_v3_web_search_request_hook_at_req04(
+                            context.body,
+                        )
+                        .map_err(|error| {
+                            self.operation_failure(
+                                &operation.operation_id,
+                                &error.to_string(),
+                            )
+                        })?;
+                        if request_state.is_some() {
+                            context
+                                .events
+                                .push(crate::hub_v1::V3HubRelayRequestHookEvent::Req04ServertoolGoverned);
+                        }
+                        *context.web_search_state = request_state;
+                        Ok(())
+                    }
+                }
+                V3HubOperationKind::ToolreasonReq04 => apply_toolreason_req04(
+                    context.manifest,
+                    context.server_id,
+                    context.body,
+                    context.tool_thinking_turn_context,
+                    context.request_id,
+                )
+                .map_err(|error| self.operation_failure(&operation.operation_id, &error)),
+                V3HubOperationKind::MemorySkillContextProjection => {
+                    if !crate::hub_v1::v3_feature_enabled_for_server(
+                        context.manifest,
+                        context.server_id,
+                        "agent_memory",
+                        false,
+                    ) {
+                        Ok(())
+                    } else {
+                        let skill = self.memory_skill.as_ref().ok_or_else(|| {
+                            self.operation_failure(
+                                &operation.operation_id,
+                                "agent_memory is enabled but MemorySkillHandle is missing",
+                            )
+                        })?;
+                        let projection = skill
+                            .project_context(MemoryRecallLimits::default())
+                            .or_else(|| Some(MemoryRecallProjectionV1::empty()));
+                        crate::memory_req04::apply_v3_memory_recall_at_req04(
+                            context.body,
+                            projection.as_ref(),
+                            context.trace,
+                        )
+                        .map_err(|error| self.operation_failure(&operation.operation_id, &error))
+                    }
+                }
+                _ => Err(self.operation_failure(
+                    &operation.operation_id,
+                    "operation is not valid for Relay Req04 entry",
+                )),
+            };
+            if let Err(error) = operation_result {
+                self.handle_operation_error(operation, error, context.trace)?;
+            }
+        }
+        state.req04_complete = true;
+        Ok(())
+    }
+
+    /// Run the ordered Resp03 entry operations. This is the only dispatcher
+    /// path that can project toolreason or stopless response semantics.
+    pub(crate) fn run_resp03_entry(
+        &self,
+        context: &mut V3Resp03HookContext<'_>,
+    ) -> Result<V3Resp03HookResult, V3Error01SourceRaised> {
+        let mut result = V3Resp03HookResult {
+            intercepted: false,
+            continuation: V3HookContinuationTransition::PassThrough,
+        };
+        let operation_ids = self.operation_ids(
+            V3HubFixedNode::V3HubRespChatProcess03Governed,
+            V3HubHookPhase::Entry,
+        );
+        for operation_id in operation_ids {
+            let operation = self.operation(operation_id).ok_or_else(|| {
+                self.operation_failure(operation_id, "operation disappeared after compile")
+            })?;
+            context.trace.push(operation_trace_marker(operation.kind));
+            let operation_result: Result<(), V3Error01SourceRaised> = match operation.kind {
+                V3HubOperationKind::ToolreasonResp03 => {
+                    if let V3ClientBody::Json(payload) = &mut context.client_payload.body {
+                        if context.tool_thinking_context.enabled_flag() {
+                            crate::hub_v1::map_v3_toolreason_to_reasoning_content_at_resp03_with_expected_model_and_context(
+                                payload,
+                                true,
+                                crate::hub_v1::v3_toolreason_client_projection_enabled_for_server(
+                                    context.manifest,
+                                    context.server_id,
+                                ),
+                                context.expected_model_id,
+                                crate::hub_v1::V3ToolreasonObservationContext {
+                                    session_id: None,
+                                    request_id: Some(context.request_id),
+                                },
+                            );
+                            if let Some(names) =
+                                context.tool_thinking_context.original_custom_tool_names()
+                            {
+                                crate::hub_v1::restore_v3_tool_thinking_custom_calls_in_payload_at_resp03(
+                                    payload, names,
+                                );
+                            }
+                            context.trace.push("V3ToolreasonResp03Projected");
+                        }
+                    }
+                    Ok(())
+                }
+                V3HubOperationKind::ServertoolResp03 => {
+                    // Direct Responses has no Relay response-hook profile. Its
+                    // protocol-specific servertool/stop handling is owned by
+                    // the Direct StoplessResp03 operation below; keep this
+                    // declared slot explicit and observable without applying
+                    // a Relay projection against a client payload.
+                    Ok(())
+                }
+                V3HubOperationKind::StoplessResp03 => {
+                    if let V3ClientBody::Json(payload) = &mut context.client_payload.body {
+                        match crate::kernel::apply_v3_responses_direct_stopless_json_response_control(
+                            crate::kernel::V3ResponsesDirectStoplessJsonResponseControlInput {
+                                manifest: context.manifest,
+                                server_id: context.server_id,
+                                stopless_control: context.stopless_control,
+                                stopless_scope: context.stopless_scope,
+                                request_stopless_state: context.execution_state.stopless_request_state(),
+                                request_web_search_state: None,
+                                transition_request_id: context.request_id,
+                                transition_updated_at: context.now_epoch_ms,
+                                payload,
+                            },
+                            context.trace,
+                        ) {
+                            Ok(outcome) => {
+                                result.intercepted = outcome.intercepted;
+                                result.continuation = match outcome.continuation_transition {
+                                    crate::kernel::V3DirectStoplessContinuationTransition::PassThrough => {
+                                        V3HookContinuationTransition::PassThrough
+                                    }
+                                    crate::kernel::V3DirectStoplessContinuationTransition::Continue {
+                                        response_id,
+                                    } => V3HookContinuationTransition::Continue { response_id },
+                                    crate::kernel::V3DirectStoplessContinuationTransition::Terminal => {
+                                        V3HookContinuationTransition::Terminal
+                                    }
+                                };
+                                Ok(())
+                            }
+                            Err(error) => Err(error),
+                        }
+                    } else {
+                        Ok(())
+                    }
+                }
+                V3HubOperationKind::StoplessWebSearchResp03 => {
+                    // The asynchronous search hop is dispatched by the
+                    // operation-specific method below. The synchronous entry
+                    // dispatcher only records that this slot is declared.
+                    Ok(())
+                }
+                _ => Err(self.operation_failure(
+                    &operation.operation_id,
+                    "operation is not valid for Resp03 entry",
+                )),
+            };
+            if let Err(error) = operation_result {
+                self.handle_operation_error(operation, error, context.trace)?;
+            }
+        }
+        Ok(result)
+    }
+
+    /// Run Relay Resp03 through the startup-compiled operation sequence.
+    /// Protocol codecs only provide the normalized response and profile; they
+    /// must not call the response registry directly or rebuild this order.
+    pub(crate) fn run_relay_resp03(
+        &self,
+        input: crate::hub_v1::V3HubRespInbound02Normalized,
+        profile: &crate::hub_v1::V3HubRelayResponseHookProfile,
+        trace: &mut Vec<&'static str>,
+    ) -> Result<crate::hub_v1::V3HubRespChatProcess03Outcome, crate::hub_v1::V3HubRelayResponseError> {
+        let mut input = crate::hub_v1::strip_v3_resp03_encrypted_reasoning_content(
+            input,
+            profile.retain_response_cipher(),
+        );
+        let mut input = crate::hub_v1::harvest_v3_think_blocks_at_resp03(input);
+        // Keep the shared Resp03 tool-frame invariant on the plan path: a
+        // Responses payload carrying function calls cannot remain terminal
+        // merely because the provider reported status=completed.
+        let mut input = crate::hub_v1::complete_or_repair_v3_resp03_tool_frames(input);
+        let mut intercepted = false;
+        let mut stopless_center_state = None;
+        let mut web_search_center_state = None;
+        let stopless_operation_enabled = self.operation_enabled(
+            V3HubFixedNode::V3HubRespChatProcess03Governed,
+            V3HubHookPhase::Entry,
+            V3HubOperationKind::StoplessResp03,
+        );
+
+        let operation_ids = self.operation_ids(
+            V3HubFixedNode::V3HubRespChatProcess03Governed,
+            V3HubHookPhase::Entry,
+        );
+        for operation_id in operation_ids {
+            let operation = self.operation(operation_id).ok_or_else(|| {
+                crate::hub_v1::V3HubRelayResponseError::ProviderCompatFailed {
+                    reason: format!("operation {operation_id} disappeared after compile"),
+                }
+            })?;
+            trace.push(operation_trace_marker(operation.kind));
+            let before_operation = input.clone();
+            let operation_result: Result<(), crate::hub_v1::V3HubRelayResponseError> = match operation.kind {
+                V3HubOperationKind::ToolreasonResp03 => {
+                    let payload = Arc::make_mut(input.provider_payload_mut());
+                    if profile.toolreason_observation_enabled() {
+                        let context = crate::hub_v1::V3ToolreasonObservationContext {
+                            session_id: profile.toolreason_observation_session_id(),
+                            request_id: profile.toolreason_observation_request_id(),
+                        };
+                        if let Some(expected_model_id) = profile.toolreason_expected_model_id() {
+                            crate::hub_v1::map_v3_toolreason_to_reasoning_content_at_resp03_with_expected_model_and_context(
+                                payload,
+                                profile.tool_thinking_enabled(),
+                                profile.toolreason_client_projection_enabled(),
+                                Some(expected_model_id),
+                                context,
+                            );
+                        } else {
+                            crate::hub_v1::map_v3_toolreason_to_reasoning_content_at_resp03_with_projection_and_context(
+                                payload,
+                                profile.tool_thinking_enabled(),
+                                profile.toolreason_client_projection_enabled(),
+                                context,
+                            );
+                        }
+                    } else {
+                        crate::hub_v1::map_v3_toolreason_to_reasoning_content_at_resp03_without_observation(
+                            payload,
+                            profile.tool_thinking_enabled(),
+                            profile.toolreason_client_projection_enabled(),
+                        );
+                    }
+                    trace.push("V3ToolreasonResp03Projected");
+                    Ok(())
+                }
+                V3HubOperationKind::ServertoolResp03 => {
+                    let (next, _) = crate::hub_v1::apply_v3_servertool_response_projection_at_resp03(
+                        input,
+                        profile,
+                    )?;
+                    input = next;
+                    Ok(())
+                }
+                V3HubOperationKind::StoplessWebSearchResp03 => {
+                    let governance = crate::hub_v1::build_v3_resp03_protocol_governance(&input)?;
+                    if matches!(
+                        crate::hub_v1::inspect_v3_resp03_finish_reason(&input, &governance),
+                        crate::hub_v1::V3Resp03FinishReasonBranch::ToolCall
+                    ) {
+                        let outcome = crate::hub_v1::apply_v3_stopless_web_search_response_at_resp03(
+                            input,
+                            profile,
+                        )?;
+                        input = outcome.input;
+                        intercepted |= outcome.intercepted;
+                        if outcome.web_search_state.is_some() {
+                            web_search_center_state = outcome.web_search_state;
+                        }
+                        if outcome.center_state.is_some() {
+                            stopless_center_state = outcome.center_state;
+                        }
+                    }
+                    Ok(())
+                }
+                V3HubOperationKind::StoplessResp03 => {
+                    let governance = crate::hub_v1::build_v3_resp03_protocol_governance(&input)?;
+                    let outcome = match crate::hub_v1::inspect_v3_resp03_finish_reason(
+                        &input,
+                        &governance,
+                    ) {
+                        crate::hub_v1::V3Resp03FinishReasonBranch::ToolCall => {
+                            crate::hub_v1::apply_v3_stopless_reasoning_stop_response_at_resp03(
+                                input, profile,
+                            )?
+                        }
+                        crate::hub_v1::V3Resp03FinishReasonBranch::Stop => {
+                            crate::hub_v1::apply_v3_stop_servertool_hook_at_resp03(input, profile)?
+                        }
+                        crate::hub_v1::V3Resp03FinishReasonBranch::Other => {
+                            crate::hub_v1::V3StoplessResponseHookOutcome {
+                                input,
+                                center_state: None,
+                                web_search_state: None,
+                                intercepted: false,
+                            }
+                        }
+                    };
+                    input = outcome.input;
+                    intercepted |= outcome.intercepted;
+                    if outcome.center_state.is_some() {
+                        stopless_center_state = outcome.center_state;
+                    }
+                    if outcome.web_search_state.is_some() {
+                        web_search_center_state = outcome.web_search_state;
+                    }
+                    Ok(())
+                }
+                _ => Err(crate::hub_v1::V3HubRelayResponseError::ProviderCompatFailed {
+                    reason: format!(
+                        "operation {} is not valid for Relay Resp03 entry",
+                        operation.operation_id
+                    ),
+                }),
+            };
+            if let Err(error) = operation_result {
+                input = before_operation;
+                match operation.failure_policy {
+                    V3HubOperationFailurePolicy::Abort => return Err(error),
+                    V3HubOperationFailurePolicy::Observe => {
+                        trace.push("V3HubHookOperationObservedFailure");
+                    }
+                }
+            }
+        }
+
+        let governance = crate::hub_v1::build_v3_resp03_protocol_governance(&input)?;
+        let branch = crate::hub_v1::inspect_v3_resp03_finish_reason(&input, &governance);
+        let (input, governance) = match branch {
+            crate::hub_v1::V3Resp03FinishReasonBranch::ToolCall => {
+                let mut input = if intercepted {
+                    input
+                } else {
+                    crate::hub_v1::project_v3_apply_patch_freeform_calls_at_resp03(input)
+                };
+                crate::hub_v1::restore_v3_tool_thinking_custom_calls_at_resp03(
+                    &mut input,
+                    profile.tool_thinking_original_custom_tool_names(),
+                );
+                if stopless_operation_enabled && profile.stopless_schema_guidance_active() {
+                    let mut visible = input.provider_payload().as_ref().clone();
+                    crate::hub_v1::strip_v3_stopless_control_echoes(&mut visible);
+                    *input.provider_payload_mut() = Arc::new(visible);
+                }
+                let governance = crate::hub_v1::build_v3_resp03_protocol_governance(&input)?;
+                (input, governance)
+            }
+            crate::hub_v1::V3Resp03FinishReasonBranch::Stop
+            | crate::hub_v1::V3Resp03FinishReasonBranch::Other => {
+                let mut input = input;
+                if stopless_operation_enabled && profile.stopless_schema_guidance_active() {
+                    let mut visible = input.provider_payload().as_ref().clone();
+                    crate::hub_v1::strip_v3_stopless_control_echoes(&mut visible);
+                    *input.provider_payload_mut() = Arc::new(visible);
+                }
+                (input, governance)
+            }
+        };
+        Ok(crate::hub_v1::build_v3_resp03_outcome(
+            input,
+            governance,
+            stopless_center_state,
+            web_search_center_state,
+            profile,
+        ))
+    }
+
+}
+
+/// Shared Toolreason Req04 operation used by every direct/relay adapter.
+///
+/// The fixed skeleton owns sequencing; this operation owns the protocol-neutral
+/// admission and delegates the existing typed payload compiler for the final
+/// request-local context. It deliberately returns a plain error string here so
+/// the plan can apply the declared Abort/Observe policy at its boundary.
+fn apply_toolreason_req04(
+    manifest: &V3Config05ManifestPublished,
+    server_id: &str,
+    body: &mut Value,
+    tool_thinking_turn_context: &mut V3ToolThinkingTurnContext,
+    _request_id: &str,
+) -> Result<(), String> {
+    let enabled = crate::hub_v1::v3_tool_thinking_enabled_for_server(manifest, server_id);
+    if tool_thinking_turn_context.enabled_flag() {
+        return Ok(());
+    }
+    if crate::hub_v1::is_v3_tool_thinking_output_continuation(
+        body,
+        body.get("previous_response_id")
+            .and_then(Value::as_str),
+    ) {
+        return Ok(());
+    }
+    let current_payload_start =
+        crate::hub_v1::current_v3_tool_thinking_payload_start(body)?;
+    *tool_thinking_turn_context =
+        crate::hub_v1::compile_v3_tool_thinking_turn_context_at_req04(
+            body,
+            current_payload_start,
+            enabled,
+        )
+        .map_err(|error| error.to_string())?;
+    Ok(())
+}
+
+fn operation_trace_marker(kind: V3HubOperationKind) -> &'static str {
+    match kind {
+        V3HubOperationKind::MemorySkillContextProjection => {
+            "V3HubHookOperationMemorySkillContextProjection"
+        }
+        V3HubOperationKind::MemorySkillTerminalObservation => {
+            "V3HubHookOperationMemorySkillTerminalObservation"
+        }
+        V3HubOperationKind::StoplessReq04 => "V3HubHookOperationStoplessReq04",
+        V3HubOperationKind::StoplessWebSearchReq04 => "V3HubHookOperationStoplessWebSearchReq04",
+        V3HubOperationKind::StoplessResp03 => "V3HubHookOperationStoplessResp03",
+        V3HubOperationKind::StoplessWebSearchResp03 => {
+            "V3HubHookOperationStoplessWebSearchResp03"
+        }
+        V3HubOperationKind::ServertoolResp03 => "V3HubHookOperationServertoolResp03",
+        V3HubOperationKind::ToolreasonReq04 => "V3HubHookOperationToolreasonReq04",
+        V3HubOperationKind::ToolreasonResp03 => "V3HubHookOperationToolreasonResp03",
+        V3HubOperationKind::ToolreasonSseResp03 => "V3HubHookOperationToolreasonSseResp03",
+    }
+}
+
+pub fn compile_v3_hub_hook_operation_plan(
+    published: &V3Config05ManifestPublished,
+    memory_skill: Option<Arc<MemorySkillHandle>>,
+) -> Result<Arc<V3HubHookOperationPlan>, V3HubHookOperationPlanError> {
+    let manifest = published
+        .hub_v1
+        .as_ref()
+        .ok_or_else(|| V3HubHookOperationPlanError::Invalid("Hub v1 manifest is missing".into()))?;
+    Ok(Arc::new(V3HubHookOperationPlan::compile(
+        manifest,
+        memory_skill,
+    )?))
+}
+
+/// Server startup owns only this compiled plan. Memory files are opened here,
+/// behind the plan boundary, when at least one enabled listener opts in.
+pub fn compile_v3_hub_hook_operation_plan_for_server(
+    published: &V3Config05ManifestPublished,
+    config_path: Option<&Path>,
+) -> Result<Arc<V3HubHookOperationPlan>, std::io::Error> {
+    let memory_enabled = published.servers.values().any(|server| {
+        server.enabled
+            && crate::v3_feature_enabled_for_server(published, &server.id, "agent_memory", false)
+    });
+    let memory_skill = if memory_enabled {
+        let config_path = config_path.ok_or_else(|| {
+            std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                "agent_memory requires a canonical config path",
+            )
+        })?;
+        let root = routecodex_v3_config::v3_agent_memory_store_path(config_path);
+        Some(Arc::new(
+            MemorySkillHandle::open(root).map_err(std::io::Error::other)?,
+        ))
+    } else {
+        None
+    };
+    compile_v3_hub_hook_operation_plan(published, memory_skill).map_err(std::io::Error::other)
+}
