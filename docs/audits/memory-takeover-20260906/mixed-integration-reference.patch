+use crate::{FrozenCut, MemoryIndexEntryDraftV1, PendingIndex, PendingIndexError};
+use serde::{Deserialize, Serialize};
+use std::collections::{BTreeMap, BTreeSet};
+use std::fs::{self, File, OpenOptions};
+use std::io::{BufRead, BufReader, Write};
+use std::path::{Path, PathBuf};
+use thiserror::Error;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum MemoryOrganizationMode {
+    Incremental,
+    Full,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct MemoryCompressedSegmentV1 {
+    pub child_entry_ids: Vec<String>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct MemoryOrganizationProposalV1 {
+    pub generation: u64,
+    pub segments: Vec<MemoryCompressedSegmentV1>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct MemoryRawKnowledgeEntryV1 {
+    pub entry_id: String,
+    pub admitted_sequence: u64,
+    pub content_hash: String,
+    pub draft: MemoryIndexEntryDraftV1,
+    pub evidence_refs: Vec<String>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct MemoryOrganizationDeltaV1 {
+    pub generation: u64,
+    pub watermark: u64,
+    pub entry_ids: Vec<String>,
+    pub compressed_segments: Vec<MemoryCompressedSegmentV1>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct MemoryOrganizationEpochV1 {
+    pub epoch: u64,
+    pub generation: u64,
+    pub watermark: u64,
+    pub active_entry_ids: Vec<String>,
+    pub compressed_segments: Vec<MemoryCompressedSegmentV1>,
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct MemoryKnowledgeStore {
+    root: Option<PathBuf>,
+    raw_entries: Vec<MemoryRawKnowledgeEntryV1>,
+    organization_deltas: Vec<MemoryOrganizationDeltaV1>,
+    organization_epochs: Vec<MemoryOrganizationEpochV1>,
+    prepared: BTreeMap<String, MemoryPreparedOrganizationTransaction>,
+    committed_transactions: BTreeSet<String>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct MemoryPreparedOrganizationTransaction {
+    transaction_id: String,
+    cut: FrozenCut,
+    raw_entries: Vec<MemoryRawKnowledgeEntryV1>,
+    delta: MemoryOrganizationDeltaV1,
+    epoch: MemoryOrganizationEpochV1,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(tag = "event", rename_all = "snake_case")]
+enum MemoryKnowledgeEvent {
+    Prepare {
+        transaction_id: String,
+        cut: FrozenCut,
+        raw_entries: Vec<MemoryRawKnowledgeEntryV1>,
+        delta: MemoryOrganizationDeltaV1,
+        epoch: MemoryOrganizationEpochV1,
+    },
+    Commit {
+        transaction_id: String,
+    },
+}
+
+#[derive(Debug, Error)]
+pub enum MemoryKnowledgeStoreError {
+    #[error("memory knowledge store I/O failed: {0}")]
+    Io(String),
+    #[error("memory knowledge store journal is corrupt: {0}")]
+    Corrupt(String),
+    #[error("memory knowledge store serialization failed: {0}")]
+    Serialization(String),
+    #[error("memory organization transaction {0} is unavailable")]
+    TransactionUnavailable(String),
+    #[error("memory organization transaction {0} conflicts with an existing prepare")]
+    TransactionConflict(String),
+    #[error("memory organization transaction {0} does not match PendingIndex")]
+    PendingMismatch(String),
+}
+
+impl MemoryKnowledgeStore {
+    /// Open the append-only organization journal. Only committed transaction
+    /// events are projected into recall-visible knowledge; prepared events are
+    /// retained as recoverable cuts until `recover_pending` finalizes them.
+    pub fn open(root: impl AsRef<Path>) -> Result<Self, MemoryKnowledgeStoreError> {
+        let root = root.as_ref().to_path_buf();
+        fs::create_dir_all(&root)
+            .map_err(|error| MemoryKnowledgeStoreError::Io(error.to_string()))?;
+        let mut store = Self {
+            root: Some(root),
+            ..Self::default()
+        };
+        let journal = store.journal_path().expect("opened store has a root");
+        if journal.exists() {
+            let file = File::open(&journal)
+                .map_err(|error| MemoryKnowledgeStoreError::Io(error.to_string()))?;
+            for (line_number, line) in BufReader::new(file).lines().enumerate() {
+                let line =
+                    line.map_err(|error| MemoryKnowledgeStoreError::Io(error.to_string()))?;
+                if line.trim().is_empty() {
+                    return Err(MemoryKnowledgeStoreError::Corrupt(format!(
+                        "empty journal line {}",
+                        line_number + 1
+                    )));
+                }
+                let event: MemoryKnowledgeEvent = serde_json::from_str(&line).map_err(|error| {
+                    MemoryKnowledgeStoreError::Corrupt(format!("line {}: {error}", line_number + 1))
+                })?;
+                store.replay(event)?;
+            }
+        }
+        Ok(store)
+    }
+
+    pub fn reopen(root: impl AsRef<Path>) -> Result<Self, MemoryKnowledgeStoreError> {
+        Self::open(root)
+    }
+
+    pub fn journal_path(&self) -> Option<PathBuf> {
+        self.root
+            .as_ref()
+            .map(|root| root.join("organization-transactions.jsonl"))
+    }
+
+    pub fn raw_entries(&self) -> &[MemoryRawKnowledgeEntryV1] {
+        &self.raw_entries
+    }
+
+    pub fn organization_deltas(&self) -> &[MemoryOrganizationDeltaV1] {
+        &self.organization_deltas
+    }
+
+    pub fn organization_epochs(&self) -> &[MemoryOrganizationEpochV1] {
+        &self.organization_epochs
+    }
+
+    pub fn recoverable_transactions(&self) -> usize {
+        self.prepared.len()
+    }
+
+    fn next_epoch(&self) -> u64 {
+        self.organization_epochs
+            .iter()
+            .map(|epoch| epoch.epoch)
+            .chain(
+                self.prepared
+                    .values()
+                    .map(|transaction| transaction.epoch.epoch),
+            )
+            .max()
+            .map_or(0, |epoch| epoch.saturating_add(1))
+    }
+
+    fn prepare_transaction(
+        &mut self,
+        transaction: &MemoryOrganizationTransaction,
+    ) -> Result<String, MemoryKnowledgeStoreError> {
+        let transaction_id = transaction.transaction_id();
+        let prepared = MemoryPreparedOrganizationTransaction {
+            transaction_id: transaction_id.clone(),
+            cut: transaction.cut.clone(),
+            raw_entries: transaction.raw_entries.clone(),
+            delta: transaction.delta.clone(),
+            epoch: transaction.epoch.clone(),
+        };
+        if let Some(existing) = self.prepared.get(&transaction_id) {
+            if existing != &prepared {
+                return Err(MemoryKnowledgeStoreError::TransactionConflict(
+                    transaction_id,
+                ));
+            }
+            return Ok(transaction_id);
+        }
+        if self.committed_transactions.contains(&transaction_id) {
+            return Ok(transaction_id);
+        }
+        self.append_event(&MemoryKnowledgeEvent::Prepare {
+            transaction_id: transaction_id.clone(),
+            cut: prepared.cut.clone(),
+            raw_entries: prepared.raw_entries.clone(),
+            delta: prepared.delta.clone(),
+            epoch: prepared.epoch.clone(),
+        })?;
+        self.prepared.insert(transaction_id.clone(), prepared);
+        Ok(transaction_id)
+    }
+
+    fn commit_transaction(
+        &mut self,
+        transaction_id: &str,
+    ) -> Result<(), MemoryKnowledgeStoreError> {
+        if self.committed_transactions.contains(transaction_id) {
+            return Ok(());
+        }
+        let prepared = self.prepared.get(transaction_id).cloned().ok_or_else(|| {
+            MemoryKnowledgeStoreError::TransactionUnavailable(transaction_id.to_string())
+        })?;
+        self.merge_raw_entries(&prepared)?;
+        self.append_event(&MemoryKnowledgeEvent::Commit {
+            transaction_id: transaction_id.to_string(),
+        })?;
+        self.apply_committed(prepared)?;
+        Ok(())
+    }
+
+    /// Reconcile prepared organization cuts with the durable Pending Index.
+    /// A cut is recoverable when it is still frozen or when Pending already
+    /// recorded its commit before the store commit marker was written.
+    pub fn recover_pending(
+        &mut self,
+        pending: &mut PendingIndex,
+    ) -> Result<usize, MemoryKnowledgeStoreError> {
+        let mut prepared_transactions = self.prepared.values().cloned().collect::<Vec<_>>();
+        prepared_transactions.sort_by(|left, right| {
+            left.cut
+                .generation
+                .cmp(&right.cut.generation)
+                .then_with(|| left.cut.watermark.cmp(&right.cut.watermark))
+                .then_with(|| left.transaction_id.cmp(&right.transaction_id))
+        });
+        let mut recovered = 0usize;
+        for prepared in prepared_transactions {
+            let transaction_id = prepared.transaction_id.clone();
+            let frozen_matches = pending.frozen_cut(prepared.cut.generation) == Some(&prepared.cut);
+            let committed_matches = prepared
+                .cut
+                .entries
+                .iter()
+                .all(|entry| pending.committed_entry_ids().any(|id| id == entry.entry_id));
+            if frozen_matches {
+                pending
+                    .commit_frozen(prepared.cut.generation)
+                    .map_err(|error| {
+                        MemoryKnowledgeStoreError::PendingMismatch(format!(
+                            "{}: {error}",
+                            transaction_id
+                        ))
+                    })?;
+            } else if !committed_matches {
+                return Err(MemoryKnowledgeStoreError::PendingMismatch(transaction_id));
+            }
+            self.commit_transaction(&prepared.transaction_id)?;
+            recovered = recovered.saturating_add(1);
+        }
+        Ok(recovered)
+    }
+
+    fn replay(&mut self, event: MemoryKnowledgeEvent) -> Result<(), MemoryKnowledgeStoreError> {
+        match event {
+            MemoryKnowledgeEvent::Prepare {
+                transaction_id,
+                cut,
+                raw_entries,
+                delta,
+                epoch,
+            } => {
+                let prepared = MemoryPreparedOrganizationTransaction {
+                    transaction_id: transaction_id.clone(),
+                    cut,
+                    raw_entries,
+                    delta,
+                    epoch,
+                };
+                if let Some(existing) = self.prepared.get(&transaction_id) {
+                    if existing != &prepared {
+                        return Err(MemoryKnowledgeStoreError::Corrupt(format!(
+                            "conflicting prepare for transaction {transaction_id}"
+                        )));
+                    }
+                    return Ok(());
+                }
+                if self.committed_transactions.contains(&transaction_id) {
+                    return Err(MemoryKnowledgeStoreError::Corrupt(format!(
+                        "prepare after commit for transaction {transaction_id}"
+                    )));
+                }
+                self.prepared.insert(transaction_id, prepared);
+            }
+            MemoryKnowledgeEvent::Commit { transaction_id } => {
+                if self.committed_transactions.contains(&transaction_id) {
+                    return Ok(());
+                }
+                let prepared = self.prepared.remove(&transaction_id).ok_or_else(|| {
+                    MemoryKnowledgeStoreError::Corrupt(format!(
+                        "commit without prepare for transaction {transaction_id}"
+                    ))
+                })?;
+                self.apply_committed(prepared)?;
+            }
+        }
+        Ok(())
+    }
+
+    fn apply_committed(
+        &mut self,
+        prepared: MemoryPreparedOrganizationTransaction,
+    ) -> Result<(), MemoryKnowledgeStoreError> {
+        let transaction_id = prepared.transaction_id.clone();
+        let raw_entries = self.merge_raw_entries(&prepared)?;
+        self.raw_entries = raw_entries;
+        self.organization_deltas.push(prepared.delta);
+        self.organization_epochs.push(prepared.epoch);
+        self.committed_transactions.insert(transaction_id.clone());
+        self.prepared.remove(&transaction_id);
+        Ok(())
+    }
+
+    fn merge_raw_entries(
+        &self,
+        prepared: &MemoryPreparedOrganizationTransaction,
+    ) -> Result<Vec<MemoryRawKnowledgeEntryV1>, MemoryKnowledgeStoreError> {
+        let transaction_id = prepared.transaction_id.as_str();
+        let mut raw_entries = self
+            .raw_entries
+            .iter()
+            .cloned()
+            .map(|entry| (entry.entry_id.clone(), entry))
+            .collect::<BTreeMap<_, _>>();
+        for entry in &prepared.raw_entries {
+            match raw_entries.get(&entry.entry_id) {
+                Some(current) if current != entry => {
+                    return Err(MemoryKnowledgeStoreError::Corrupt(format!(
+                        "raw entry {} conflicts during transaction {}",
+                        entry.entry_id, transaction_id
+                    )));
+                }
+                Some(_) => {}
+                None => {
+                    raw_entries.insert(entry.entry_id.clone(), entry.clone());
+                }
+            }
+        }
+        let mut raw_entries = raw_entries.into_values().collect::<Vec<_>>();
+        raw_entries.sort_by(|left, right| {
+            left.admitted_sequence
+                .cmp(&right.admitted_sequence)
+                .then_with(|| left.entry_id.cmp(&right.entry_id))
+        });
+        Ok(raw_entries)
+    }
+
+    fn append_event(&self, event: &MemoryKnowledgeEvent) -> Result<(), MemoryKnowledgeStoreError> {
+        let Some(journal) = self.journal_path() else {
+            return Ok(());
+        };
+        let line = serde_json::to_vec(event)
+            .map_err(|error| MemoryKnowledgeStoreError::Serialization(error.to_string()))?;
+        let mut file = OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(journal)
+            .map_err(|error| MemoryKnowledgeStoreError::Io(error.to_string()))?;
+        file.write_all(&line)
+            .and_then(|_| file.write_all(b"\n"))
+            .and_then(|_| file.sync_data())
+            .map_err(|error| MemoryKnowledgeStoreError::Io(error.to_string()))
+    }
+
+    pub fn recall_snapshot(&self, generation: u64) -> crate::MemoryRecallSnapshotV1 {
+        crate::MemoryRecallSnapshotV1::new(
+            generation,
+            self.raw_entries
+                .iter()
+                .map(|entry| entry.draft.clone())
+                .collect(),
+        )
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct MemoryOrganizationReceipt {
+    pub mode: MemoryOrganizationMode,
+    pub generation: u64,
+    pub watermark: u64,
+    pub epoch: u64,
+    pub committed_entries: usize,
+    pub compressed_entries: usize,
+}
+
+#[derive(Debug, Error)]
+pub enum MemoryOrganizationError {
+    #[error("pending index operation failed: {0}")]
+    Pending(#[from] PendingIndexError),
+    #[error("memory knowledge store operation failed: {0}")]
+    Knowledge(#[from] MemoryKnowledgeStoreError),
+    #[error("organization proposal is invalid: {0}")]
+    InvalidProposal(String),
+    #[error("frozen cut is no longer available or changed")]
+    FrozenCutChanged,
+    #[error("memory entry {0} was already committed to raw knowledge")]
+    AlreadyCommitted(String),
+}
+
+#[derive(Debug, Clone)]
+pub struct MemoryOrganizationTransaction {
+    mode: MemoryOrganizationMode,
+    cut: FrozenCut,
+    raw_entries: Vec<MemoryRawKnowledgeEntryV1>,
+    delta: MemoryOrganizationDeltaV1,
+    epoch: MemoryOrganizationEpochV1,
+}
+
+impl MemoryOrganizationTransaction {
+    pub fn prepare(
+        cut: FrozenCut,
+        knowledge: &MemoryKnowledgeStore,
+        mode: MemoryOrganizationMode,
+        max_index_entries: usize,
+        proposal: Option<&MemoryOrganizationProposalV1>,
+    ) -> Result<Self, MemoryOrganizationError> {
+        if cut.entries.is_empty() {
+            return Err(MemoryOrganizationError::InvalidProposal(
+                "frozen cut cannot be empty".to_string(),
+            ));
+        }
+        if let Some(entry) = cut.entries.iter().find(|candidate| {
+            knowledge
+                .raw_entries
+                .iter()
+                .any(|raw| raw.entry_id == candidate.entry_id)
+        }) {
+            return Err(MemoryOrganizationError::AlreadyCommitted(
+                entry.entry_id.clone(),
+            ));
+        }
+        if let Some(proposal) = proposal {
+            validate_memory_organization_proposal(&cut, proposal)?;
+        }
+
+        let mut raw_entries = knowledge.raw_entries.clone();
+        raw_entries.extend(cut.entries.iter().map(|entry| MemoryRawKnowledgeEntryV1 {
+            entry_id: entry.entry_id.clone(),
+            admitted_sequence: entry.admitted_sequence,
+            content_hash: entry.content_hash.clone(),
+            draft: entry.draft.clone(),
+            evidence_refs: entry.source.event_refs.clone(),
+        }));
+
+        let compressed_segments = match proposal {
+            Some(proposal) => proposal.segments.clone(),
+            None => select_capacity_compression(&raw_entries, max_index_entries),
+        };
+        let delta = MemoryOrganizationDeltaV1 {
+            generation: cut.generation,
+            watermark: cut.watermark,
+            entry_ids: cut
+                .entries
+                .iter()
+                .map(|entry| entry.entry_id.clone())
+                .collect(),
+            compressed_segments: compressed_segments.clone(),
+        };
+        let epoch = MemoryOrganizationEpochV1 {
+            epoch: knowledge.next_epoch(),
+            generation: cut.generation,
+            watermark: cut.watermark,
+            active_entry_ids: raw_entries
+                .iter()
+                .map(|entry| entry.entry_id.clone())
+                .collect(),
+            compressed_segments,
+        };
+        Ok(Self {
+            mode,
+            cut,
+            raw_entries,
+            delta,
+            epoch,
+        })
+    }
+
+    pub fn cut(&self) -> &FrozenCut {
+        &self.cut
+    }
+
+    fn transaction_id(&self) -> String {
+        let bytes = serde_json::to_vec(&(
+            self.mode,
+            &self.cut,
+            &self.raw_entries,
+            &self.delta,
+            &self.epoch,
+        ))
+        .expect("organization transaction is serializable");
+        format!("org-{}", crate::stable_content_hash(&bytes))
+    }
+
+    pub fn promote(
+        self,
+        pending: &mut PendingIndex,
+        knowledge: &mut MemoryKnowledgeStore,
+    ) -> Result<MemoryOrganizationReceipt, MemoryOrganizationError> {
+        if pending.frozen_cut(self.cut.generation) != Some(&self.cut) {
+            return Err(MemoryOrganizationError::FrozenCutChanged);
+        }
+        let transaction_id = knowledge.prepare_transaction(&self)?;
+        pending.commit_frozen(self.cut.generation)?;
+        knowledge.commit_transaction(&transaction_id)?;
+        let compressed_entries = self
+            .epoch
+            .compressed_segments
+            .iter()
+            .map(|segment| segment.child_entry_ids.len())
+            .sum();
+        Ok(MemoryOrganizationReceipt {
+            mode: self.mode,
+            generation: self.cut.generation,
+            watermark: self.cut.watermark,
+            epoch: self.epoch.epoch,
+            committed_entries: self.cut.entries.len(),
+            compressed_entries,
+        })
+    }
+}
+
+pub fn organize_pending_generation(
+    pending: &mut PendingIndex,
+    knowledge: &mut MemoryKnowledgeStore,
+    mode: MemoryOrganizationMode,
+    max_index_entries: usize,
+    proposal: Option<&MemoryOrganizationProposalV1>,
+) -> Result<MemoryOrganizationReceipt, MemoryOrganizationError> {
+    knowledge.recover_pending(pending)?;
+    let preview = pending.preview_freeze()?;
+    let transaction = MemoryOrganizationTransaction::prepare(
+        preview,
+        knowledge,
+        mode,
+        max_index_entries,
+        proposal,
+    )?;
+    let frozen = pending.freeze()?;
+    if frozen != *transaction.cut() {
+        return Err(MemoryOrganizationError::FrozenCutChanged);
+    }
+    transaction.promote(pending, knowledge)
+}
+
+pub fn validate_memory_organization_proposal(
+    cut: &FrozenCut,
+    proposal: &MemoryOrganizationProposalV1,
+) -> Result<(), MemoryOrganizationError> {
+    if proposal.generation != cut.generation {
+        return Err(MemoryOrganizationError::InvalidProposal(format!(
+            "generation {} does not match frozen generation {}",
+            proposal.generation, cut.generation
+        )));
+    }
+    let source: BTreeSet<&str> = cut
+        .entries
+        .iter()
+        .map(|entry| entry.entry_id.as_str())
+        .collect();
+    let mut referenced = BTreeSet::new();
+    for segment in &proposal.segments {
+        if segment.child_entry_ids.is_empty() {
+            return Err(MemoryOrganizationError::InvalidProposal(
+                "organization segment cannot be empty".to_string(),
+            ));
+        }
+        for id in &segment.child_entry_ids {
+            if !source.contains(id.as_str()) {
+                return Err(MemoryOrganizationError::InvalidProposal(format!(
+                    "unknown entry {id}"
+                )));
+            }
+            if !referenced.insert(id.as_str()) {
+                return Err(MemoryOrganizationError::InvalidProposal(format!(
+                    "entry {id} is referenced more than once"
+                )));
+            }
+        }
+    }
+    if referenced != source {
+        return Err(MemoryOrganizationError::InvalidProposal(
+            "organization does not cover every frozen entry".to_string(),
+        ));
+    }
+    Ok(())
+}
+
+fn select_capacity_compression(
+    raw_entries: &[MemoryRawKnowledgeEntryV1],
+    max_index_entries: usize,
+) -> Vec<MemoryCompressedSegmentV1> {
+    if max_index_entries == 0 || raw_entries.len() < max_index_entries {
+        return Vec::new();
+    }
+    let mut ordered = raw_entries.iter().collect::<Vec<_>>();
+    ordered.sort_by(|left, right| {
+        left.admitted_sequence
+            .cmp(&right.admitted_sequence)
+            .then_with(|| left.entry_id.cmp(&right.entry_id))
+    });
+    let count = ordered.len().saturating_add(9) / 10;
+    let child_entry_ids = ordered
+        .into_iter()
+        .take(count.max(1))
+        .map(|entry| entry.entry_id.clone())
+        .collect::<Vec<_>>();
+    vec![MemoryCompressedSegmentV1 { child_entry_ids }]
+}
