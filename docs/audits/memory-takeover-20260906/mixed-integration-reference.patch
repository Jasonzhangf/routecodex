+#[test]
+fn pending_index_reopens_and_deduplicates_by_content_hash() {
+    let root = tempfile_root("pending-reopen");
+    let source = MemorySourceWindow::new(MemorySourceKind::EndTurn, ["evt-1"]);
+    let draft = valid_draft();
+    let mut index = PendingIndex::open(&root).expect("open pending index");
+    let first = index
+        .append(draft.clone(), source.clone())
+        .expect("append first");
+    assert!(first.inserted);
+    drop(index);
+
+    let mut reopened = PendingIndex::open(&root).expect("reopen pending index");
+    let duplicate = reopened
+        .append(draft, source)
+        .expect("deduplicate on reopen");
+    assert!(!duplicate.inserted);
+    assert_eq!(duplicate.entry.entry_id, first.entry.entry_id);
+    assert_eq!(reopened.active_entries().len(), 1);
+    assert_eq!(reopened.next_sequence(), 1);
+}
+
+#[test]
+fn pending_memory_observer_deduplicates_repeated_terminal_observation() {
+    let root = tempfile_root("observer-dedupe");
+    let handle = MemoryObserverHandle::open(&root).expect("open observer");
+    let proof = CanonicalCompletedStopProof::from_fields(Some("completed"), Some("stop"))
