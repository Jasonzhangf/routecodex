+use super::*;
+
+impl V3HubHookOperationPlan {
+    /// Execute the asynchronous Stopless web-search operation declared on the
+    /// Resp03 entry hook. The kernel supplies only typed runtime dependencies;
+    /// it does not inspect or orchestrate the search state itself.
+    pub(crate) async fn run_stopless_web_search_resp03<T: ResponsesTransport + ?Sized>(
+        &self,
+        manifest: &V3Config05ManifestPublished,
+        server_id: &str,
+        stopless_control: Option<&V3ResponsesDirectStoplessControlState>,
+        stopless_scope: Option<&V3ResponsesDirectStoplessControlScope>,
+        request_body: &Value,
+        payload: &mut Value,
+        failure_session_scope: &V3ProviderFailureSessionScope,
+        provider_health: &V3ProviderFailureRuntimeHealth,
+        transport: &T,
+        request_id: &str,
+        allow_exhaustion_rescue_probe: bool,
+        trace: &mut Vec<&'static str>,
+    ) -> Result<bool, V3Error01SourceRaised> {
+        let Some(operation_id) = self
+            .operation_ids(
+                V3HubFixedNode::V3HubRespChatProcess03Governed,
+                V3HubHookPhase::Entry,
+            )
+            .into_iter()
+            .find(|operation_id| {
+                self.operation(operation_id).is_some_and(|operation| {
+                    operation.kind == V3HubOperationKind::StoplessWebSearchResp03
+                })
+            })
+        else {
+            return Ok(false);
+        };
+        let operation = self.operation(operation_id).ok_or_else(|| {
+            self.operation_failure(operation_id, "operation disappeared after compile")
+        })?;
+        let result = async {
+            let Some(search_state) =
+                crate::kernel::apply_v3_responses_direct_web_search_json_response_control(
+                    stopless_control,
+                    stopless_scope,
+                    payload,
+                    trace,
+                )?
+            else {
+                return Ok(false);
+            };
+            let captured = if search_state.phase()
+                == crate::hub_v1::V3WebSearchCenterPhase::SearchResultCaptured
+            {
+                search_state
+            } else {
+                let backend_binding =
+                    crate::hub_v1::resolve_request_web_search_backend_binding(manifest, request_body);
+                crate::hub_v1::execute_local_web_search_hop(
+                    manifest,
+                    server_id,
+                    failure_session_scope,
+                    provider_health,
+                    backend_binding.as_deref(),
+                    &search_state,
+                    transport,
+                    request_id,
+                    allow_exhaustion_rescue_probe,
+                )
+                .await
+                .map_err(|error| self.operation_failure(operation_id, &error.to_string()))?
+            };
+            crate::hub_v1::project_web_search_result_into_finalized(payload, &captured)
+                .map_err(|error| self.operation_failure(operation_id, &error.to_string()))?;
+            if let (Some(control), Some(scope)) = (stopless_control, stopless_scope) {
+                control
+                    .web_search_store_for_scope(
+                        scope,
+                        captured,
+                        crate::hub_v1::V3ServerToolCenterWriteOrigin {
+                            module: "hub_v1_hook_operations",
+                            symbol: "V3HubHookOperationPlan::run_stopless_web_search_resp03",
+                            stage: "resp03_web_search_runtime_control_updated",
+                        },
+                        Some("resp03 web_search operation persisted captured state"),
+                        Some(request_id),
+                    )
+                    .map_err(|error| self.operation_failure(operation_id, &error.to_string()))?;
+            }
+            trace.push("V3DirectWebSearchResp03HostedResultProjected");
+            Ok(true)
+        }
+        .await;
+        match result {
+            Ok(projected) => Ok(projected),
+            Err(error) => {
+                self.handle_operation_error(operation, error, trace)?;
+                Ok(false)
+            }
+        }
+    }
+
+    /// Run Resp03 exit operations after the client payload/stream has been
+    /// sealed. Memory Skill observation is deliberately terminal-only.
+    pub(crate) fn run_resp03_exit(
+        &self,
+        context: &mut V3Resp03ExitHookContext<'_>,
+    ) -> Result<(), V3Error01SourceRaised> {
+        let operation_ids = self.operation_ids(
+            V3HubFixedNode::V3HubRespChatProcess03Governed,
+            V3HubHookPhase::Exit,
+        );
+        for operation_id in operation_ids {
+            let operation = self.operation(operation_id).ok_or_else(|| {
+                self.operation_failure(operation_id, "operation disappeared after compile")
+            })?;
+            context.trace.push(operation_trace_marker(operation.kind));
+            let operation_result = match operation.kind {
+                V3HubOperationKind::MemorySkillTerminalObservation => {
+                    if crate::hub_v1::v3_feature_enabled_for_server(
+                        context.manifest,
+                        context.server_id,
+                        "agent_memory",
+                        false,
+                    ) {
+                        crate::memory_resp03::apply_v3_responses_direct_memory_resp03_observer(
+                            context.client_payload,
+                            self.memory_skill.as_deref(),
+                            context.request_id,
+                            context.stream_observation,
+                            context.committed_client_sse,
+                            context.trace,
+                        );
+                    }
+                    Ok(())
+                }
+                // The sealed stream has already executed the registered typed
+                // SSE hook during Resp14→Resp15 projection. The operation is
+                // still represented in the manifest and records that handoff.
+                V3HubOperationKind::ToolreasonSseResp03 => {
+                    if matches!(context.client_payload.body, V3ClientBody::CommittedSse(_)) {
+                        context.trace.push("V3ToolreasonSseResp03HookDelegated");
+                    }
+                    Ok(())
+                }
+                _ => Err(self.operation_failure(
+                    &operation.operation_id,
+                    "operation is not valid for Resp03 exit",
+                )),
+            };
+            if let Err(error) = operation_result {
+                self.handle_operation_error(operation, error, context.trace)?;
+            }
+        }
+        Ok(())
+    }
+
+    /// Dispatch one OpenAI Chat/Relay SSE semantic frame through the declared
+    /// `ToolreasonSseResp03` operation. Framing, decoding, and state ownership
+    /// stay in the adjacent codec; this method is the only production bridge
+    /// to the checked atomic toolreason helper.
+    pub(crate) fn run_toolreason_sse_resp03_frame(
+        &self,
+        context: &mut V3ToolreasonSseResp03FrameContext<'_>,
+    ) -> Result<(), V3Error01SourceRaised> {
+        for operation_id in self.operation_ids(
+            V3HubFixedNode::V3HubRespChatProcess03Governed,
+            V3HubHookPhase::Exit,
+        ) {
+            let operation = self.operation(operation_id).ok_or_else(|| {
+                self.operation_failure(operation_id, "operation disappeared after compile")
+            })?;
+            if operation.kind != V3HubOperationKind::ToolreasonSseResp03 {
+                continue;
+            }
+            context.trace.push(operation_trace_marker(operation.kind));
+            crate::hub_v1::collect_v3_responses_sse_tool_name_at_resp03(
+                context.payload,
+                context.tool_names,
+            );
+            let original_payload = context.payload.clone();
+            let result = (context.toolreason_hook)(
+                context.payload,
+                context.tool_names,
+                context.pending_reasons,
+                context.reason_emitted,
+                context.project_to_client,
+                context.session_id,
+                context.request_id,
+                context.expected_model_id,
+                context.argument_buffers,
+                context.projection_authorized.as_deref_mut(),
+                context.stream_observation,
+            )
+            .map_err(|error| self.operation_failure(operation_id, &error));
+            if let Err(error) = result {
+                if matches!(operation.failure_policy, V3HubOperationFailurePolicy::Observe) {
+                    *context.payload = original_payload;
+                }
+                self.handle_operation_error(operation, error, context.trace)?;
+            }
+        }
+        Ok(())
+    }
+
+    /// Dispatch terminal toolreason observation through the same declared
+    /// SSE operation. Callers must invoke this only after a validated terminal
+    /// boundary; incomplete/drop paths intentionally never reach this method.
+    pub(crate) fn run_toolreason_sse_resp03_finalize(
+        &self,
+        context: &mut V3ToolreasonSseResp03FinalizeContext<'_>,
+    ) -> Result<(), V3Error01SourceRaised> {
+        for operation_id in self.operation_ids(
+            V3HubFixedNode::V3HubRespChatProcess03Governed,
+            V3HubHookPhase::Exit,
+        ) {
+            let operation = self.operation(operation_id).ok_or_else(|| {
+                self.operation_failure(operation_id, "operation disappeared after compile")
+            })?;
+            if operation.kind != V3HubOperationKind::ToolreasonSseResp03 {
+                continue;
+            }
+            context.trace.push(operation_trace_marker(operation.kind));
+            let result = crate::hub_v1::finalize_v3_toolreason_observation_at_resp03_with_expected_model_and_stream_observation(
+                context.tool_names,
+                context.pending_reasons,
+                context.reason_emitted,
+                crate::hub_v1::V3ToolreasonObservationContext {
+                    session_id: context.session_id,
+                    request_id: context.request_id,
+                },
+                context.expected_model_id,
+                context.stream_observation,
+            )
+            .map_err(|error| self.operation_failure(operation_id, &error));
+            if let Err(error) = result {
+                self.handle_operation_error(operation, error, context.trace)?;
+            }
+        }
+        Ok(())
+    }
+
+    pub(crate) fn clear_req04_before_relay(
+        &self,
+        manifest: &V3Config05ManifestPublished,
+        server_id: &str,
+        stopless_control: Option<&V3ResponsesDirectStoplessControlState>,
+        stopless_scope: Option<&V3ResponsesDirectStoplessControlScope>,
+        state: &V3HubHookExecutionState,
+    ) -> Result<(), V3Error01SourceRaised> {
+        crate::kernel::clear_v3_responses_direct_stopless_control_on_pre_resp03_terminal(
+            manifest,
+            server_id,
+            stopless_control,
+            stopless_scope,
+            state.stopless_request_state(),
+        )
+    }
+
+    pub(super) fn operation_failure(&self, operation_id: &str, message: &str) -> V3Error01SourceRaised {
+        build_v3_error_01_source_raised(
+            V3ErrorSourceKind::RuntimeFailure,
+            "V3HubHookOperation",
+            "hook_operation_failed",
+            format!("operation {operation_id}: {message}"),
+        )
+    }
+
+    pub(super) fn handle_operation_error(
+        &self,
+        operation: &V3HubOperationManifest,
+        error: V3Error01SourceRaised,
+        trace: &mut Vec<&'static str>,
+    ) -> Result<(), V3Error01SourceRaised> {
+        match operation.failure_policy {
+            V3HubOperationFailurePolicy::Abort => Err(error),
+            V3HubOperationFailurePolicy::Observe => {
+                trace.push("V3HubHookOperationObservedFailure");
+                Ok(())
+            }
+        }
+    }
+}
