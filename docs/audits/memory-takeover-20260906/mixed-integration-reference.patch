--- /dev/null
+++ b/v3/crates/routecodex-v3-agent-memory/src/skill_index.rs
@@ -0,0 +1,428 @@
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use std::collections::BTreeMap;
+use std::fs::{self, File, OpenOptions};
+use std::io::{BufRead, BufReader, Write};
+use std::path::{Path, PathBuf};
+use thiserror::Error;
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct SkillManifestV1 {
+    pub skill_id: String,
+    pub version: String,
+    pub body: String,
+    manifest_hash: String,
+}
+
+impl SkillManifestV1 {
+    pub fn new(
+        skill_id: impl Into<String>,
+        version: impl Into<String>,
+        body: impl Into<String>,
+    ) -> Result<Self, SkillManifestError> {
+        let manifest = Self {
+            skill_id: skill_id.into(),
+            version: version.into(),
+            body: body.into(),
+            manifest_hash: String::new(),
+        };
+        manifest.validate_identity()?;
+        let manifest_hash =
+            stable_skill_hash(&manifest.skill_id, &manifest.version, &manifest.body);
+        Ok(Self {
+            manifest_hash,
+            ..manifest
+        })
+    }
+
+    pub fn manifest_hash(&self) -> &str {
+        &self.manifest_hash
+    }
+
+    fn validate_identity(&self) -> Result<(), SkillManifestError> {
+        if self.skill_id.trim().is_empty() {
+            return Err(SkillManifestError::Invalid(
+                "skill_id must be non-empty".to_string(),
+            ));
+        }
+        if self.version.trim().is_empty() {
+            return Err(SkillManifestError::Invalid(
+                "version must be non-empty".to_string(),
+            ));
+        }
+        if self.body.trim().is_empty() {
+            return Err(SkillManifestError::Invalid(
+                "skill body must be non-empty".to_string(),
+            ));
+        }
+        Ok(())
+    }
+
+    fn validate(&self) -> Result<(), SkillManifestError> {
+        self.validate_identity()?;
+        let expected = stable_skill_hash(&self.skill_id, &self.version, &self.body);
+        if self.manifest_hash != expected {
+            return Err(SkillManifestError::Invalid(
+                "manifest_hash does not match canonical skill body".to_string(),
+            ));
+        }
+        Ok(())
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct MemorySkillReferenceV1 {
+    pub skill_ref: String,
+    pub version: String,
+    pub manifest_hash: String,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SkillPromotionOutcome {
+    pub reference: MemorySkillReferenceV1,
+    pub inserted: bool,
+}
+
+#[derive(Debug, Error)]
+pub enum SkillManifestError {
+    #[error("skill manifest is invalid: {0}")]
+    Invalid(String),
+}
+
+#[derive(Debug, Error)]
+pub enum SkillIndexError {
+    #[error("skill index I/O failed: {0}")]
+    Io(String),
+    #[error("skill index journal is corrupt: {0}")]
+    Corrupt(String),
+    #[error("skill manifest is invalid: {0}")]
+    InvalidManifest(String),
+    #[error("manifest hash conflict for {skill_id}@{version}")]
+    ManifestHashConflict { skill_id: String, version: String },
+    #[error("skill index serialization failed: {0}")]
+    Serialization(String),
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(tag = "event", rename_all = "snake_case")]
+enum SkillIndexEvent {
+    Promote { reference: MemorySkillReferenceV1 },
+}
+
+#[derive(Debug, Clone)]
+pub struct MemoryLevelOneIndexV1 {
+    root: PathBuf,
+    references: BTreeMap<(String, String), MemorySkillReferenceV1>,
+}
+
+impl MemoryLevelOneIndexV1 {
+    pub fn open(root: impl AsRef<Path>) -> Result<Self, SkillIndexError> {
+        let root = root.as_ref().to_path_buf();
+        fs::create_dir_all(root.join("skills"))
+            .map_err(|error| SkillIndexError::Io(error.to_string()))?;
+        let mut index = Self {
+            root,
+            references: BTreeMap::new(),
+        };
+        let journal = index.journal_path();
+        if journal.exists() {
+            let file =
+                File::open(&journal).map_err(|error| SkillIndexError::Io(error.to_string()))?;
+            for (line_number, line) in BufReader::new(file).lines().enumerate() {
+                let line = line.map_err(|error| SkillIndexError::Io(error.to_string()))?;
+                if line.trim().is_empty() {
+                    return Err(SkillIndexError::Corrupt(format!(
+                        "empty journal line {}",
+                        line_number + 1
+                    )));
+                }
+                let event: SkillIndexEvent = serde_json::from_str(&line).map_err(|error| {
+                    SkillIndexError::Corrupt(format!("line {}: {error}", line_number + 1))
+                })?;
+                index.replay(event)?;
+            }
+        }
+        for reference in index.references.values() {
+            let path = index
+                .root
+                .join("skills")
+                .join(format!("{}.json", reference.manifest_hash));
+            let bytes = fs::read(&path).map_err(|error| {
+                SkillIndexError::Corrupt(format!(
+                    "manifest {} is unavailable: {error}",
+                    reference.manifest_hash
+                ))
+            })?;
+            let manifest: SkillManifestV1 = serde_json::from_slice(&bytes).map_err(|error| {
+                SkillIndexError::Corrupt(format!(
+                    "manifest {} is invalid: {error}",
+                    reference.manifest_hash
+                ))
+            })?;
+            manifest
+                .validate()
+                .map_err(|error| SkillIndexError::Corrupt(error.to_string()))?;
+            if manifest.skill_id != reference.skill_ref
+                || manifest.version != reference.version
+                || manifest.manifest_hash() != reference.manifest_hash
+            {
+                return Err(SkillIndexError::Corrupt(format!(
+                    "manifest reference mismatch for {}@{}",
+                    reference.skill_ref, reference.version
+                )));
+            }
+        }
+        Ok(index)
+    }
+
+    pub fn reopen(root: impl AsRef<Path>) -> Result<Self, SkillIndexError> {
+        Self::open(root)
+    }
+
+    pub fn references(&self) -> Vec<MemorySkillReferenceV1> {
+        self.references.values().cloned().collect()
+    }
+
+    pub fn journal_path(&self) -> PathBuf {
+        self.root.join("level-one-index.jsonl")
+    }
+
+    pub fn manifest_path(&self, manifest: &SkillManifestV1) -> PathBuf {
+        self.root
+            .join("skills")
+            .join(format!("{}.json", manifest.manifest_hash()))
+    }
+
+    pub fn promote(
+        &mut self,
+        manifest: &SkillManifestV1,
+    ) -> Result<SkillPromotionOutcome, SkillIndexError> {
+        manifest
+            .validate()
+            .map_err(|error| SkillIndexError::InvalidManifest(error.to_string()))?;
+        let key = (manifest.skill_id.clone(), manifest.version.clone());
+        let reference = MemorySkillReferenceV1 {
+            skill_ref: manifest.skill_id.clone(),
+            version: manifest.version.clone(),
+            manifest_hash: manifest.manifest_hash().to_string(),
+        };
+        if let Some(existing) = self.references.get(&key) {
+            if existing.manifest_hash != reference.manifest_hash {
+                return Err(SkillIndexError::ManifestHashConflict {
+                    skill_id: manifest.skill_id.clone(),
+                    version: manifest.version.clone(),
+                });
+            }
+        }
+        let path = self.manifest_path(manifest);
+        let bytes = serde_json::to_vec_pretty(manifest)
+            .map_err(|error| SkillIndexError::Serialization(error.to_string()))?;
+        if path.exists() {
+            let existing =
+                fs::read(&path).map_err(|error| SkillIndexError::Io(error.to_string()))?;
+            if existing != bytes {
+                return Err(SkillIndexError::ManifestHashConflict {
+                    skill_id: manifest.skill_id.clone(),
+                    version: manifest.version.clone(),
+                });
+            }
+        } else {
+            atomic_write(&path, &bytes)?;
+        }
+
+        if let Some(existing) = self.references.get(&key) {
+            if existing.manifest_hash == reference.manifest_hash {
+                return Ok(SkillPromotionOutcome {
+                    reference: existing.clone(),
+                    inserted: false,
+                });
+            }
+            return Err(SkillIndexError::ManifestHashConflict {
+                skill_id: manifest.skill_id.clone(),
+                version: manifest.version.clone(),
+            });
+        }
+        self.append_event(&SkillIndexEvent::Promote {
+            reference: reference.clone(),
+        })?;
+        self.references.insert(key, reference.clone());
+        Ok(SkillPromotionOutcome {
+            reference,
+            inserted: true,
+        })
+    }
+
+    fn replay(&mut self, event: SkillIndexEvent) -> Result<(), SkillIndexError> {
+        match event {
+            SkillIndexEvent::Promote { reference } => {
+                if reference.skill_ref.trim().is_empty()
+                    || reference.version.trim().is_empty()
+                    || reference.manifest_hash.trim().is_empty()
+                {
+                    return Err(SkillIndexError::Corrupt(
+                        "skill reference fields must be non-empty".to_string(),
+                    ));
+                }
+                let key = (reference.skill_ref.clone(), reference.version.clone());
+                if let Some(existing) = self.references.get(&key) {
+                    if existing != &reference {
+                        return Err(SkillIndexError::Corrupt(format!(
+                            "manifest hash conflict for {}@{}",
+                            reference.skill_ref, reference.version
+                        )));
+                    }
+                    return Ok(());
+                }
+                self.references.insert(key, reference);
+            }
+        }
+        Ok(())
+    }
+
+    fn append_event(&self, event: &SkillIndexEvent) -> Result<(), SkillIndexError> {
+        let line = serde_json::to_vec(event)
+            .map_err(|error| SkillIndexError::Serialization(error.to_string()))?;
+        let mut file = OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(self.journal_path())
+            .map_err(|error| SkillIndexError::Io(error.to_string()))?;
+        file.write_all(&line)
+            .and_then(|_| file.write_all(b"\n"))
+            .and_then(|_| file.sync_data())
+            .map_err(|error| SkillIndexError::Io(error.to_string()))
+    }
+}
+
+fn atomic_write(path: &Path, bytes: &[u8]) -> Result<(), SkillIndexError> {
+    let tmp = path.with_extension("tmp");
+    fs::write(&tmp, bytes).map_err(|error| SkillIndexError::Io(error.to_string()))?;
+    fs::rename(&tmp, path).map_err(|error| SkillIndexError::Io(error.to_string()))
+}
+
+fn stable_skill_hash(skill_id: &str, version: &str, body: &str) -> String {
+    let mut digest = Sha256::new();
+    digest.update(skill_id.as_bytes());
+    digest.update([0]);
+    digest.update(version.as_bytes());
+    digest.update([0]);
+    digest.update(body.as_bytes());
+    digest
+        .finalize()
+        .iter()
+        .map(|byte| format!("{byte:02x}"))
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use crate::{MemoryLevelOneIndexV1, SkillManifestV1};
+    use std::path::PathBuf;
+
+    fn root(label: &str) -> PathBuf {
+        let root = std::env::temp_dir().join(format!(
+            "routecodex-v3-memory-skill-index-{label}-{}",
+            std::process::id()
+        ));
+        let _ = std::fs::remove_dir_all(&root);
+        root
+    }
+
+    fn manifest(body: &str) -> SkillManifestV1 {
+        SkillManifestV1::new("routecodex.agent-memory", "1.0.0", body)
+            .expect("valid skill manifest")
+    }
+
+    #[test]
+    fn skill_manifest_hash_covers_identity_and_immutable_body() {
+        let first = manifest("remember the selected route");
+        let second = SkillManifestV1::new(
+            "routecodex.agent-memory",
+            "1.0.0",
+            "remember a different route",
+        )
+        .expect("valid skill manifest");
+        assert_ne!(first.manifest_hash(), second.manifest_hash());
+        assert_eq!(first.skill_id, "routecodex.agent-memory");
+        assert_eq!(first.version, "1.0.0");
+        assert_eq!(first.body, "remember the selected route");
+    }
+
+    #[test]
+    fn malformed_skill_manifest_is_rejected_before_index_append() {
+        assert!(SkillManifestV1::new("", "1.0.0", "body").is_err());
+        assert!(SkillManifestV1::new("skill", "", "body").is_err());
+        assert!(SkillManifestV1::new("skill", "1.0.0", "").is_err());
+    }
+
+    #[test]
+    fn unknown_skill_manifest_fields_are_rejected() {
+        let error = serde_json::from_str::<SkillManifestV1>(
+            r#"{
+                "skill_id":"routecodex.agent-memory",
+                "version":"1.0.0",
+                "body":"immutable body",
+                "manifest_hash":"",
+                "unexpected":"must fail"
+            }"#,
+        )
+        .expect_err("unknown skill manifest field must fail closed");
+        assert!(error.to_string().contains("unknown field"));
+    }
+
+    #[test]
+    fn level_one_index_persists_reference_only_and_reopens_idempotently() {
+        let root = root("promote");
+        let skill = manifest("remember the selected route");
+        let mut index = MemoryLevelOneIndexV1::open(&root).expect("open level-one index");
+        let first = index.promote(&skill).expect("promote skill");
+        assert!(first.inserted);
+        assert_eq!(index.references().len(), 1);
+        let journal = std::fs::read_to_string(index.journal_path()).expect("read index journal");
+        assert!(journal.contains("routecodex.agent-memory"));
+        assert!(journal.contains("manifest_hash"));
+        assert!(!journal.contains("remember the selected route"));
+        assert!(!journal.contains("body"));
+        let body_path = index.manifest_path(&skill);
+        let persisted: SkillManifestV1 =
+            serde_json::from_slice(&std::fs::read(body_path).expect("read immutable manifest"))
+                .expect("parse immutable manifest");
+        assert_eq!(persisted, skill);
+
+        drop(index);
+        let mut reopened = MemoryLevelOneIndexV1::open(&root).expect("reopen level-one index");
+        let duplicate = reopened.promote(&skill).expect("dedupe skill");
+        assert!(!duplicate.inserted);
+        assert_eq!(reopened.references().len(), 1);
+    }
+
+    #[test]
+    fn same_skill_version_cannot_be_replaced_by_a_different_manifest() {
+        let root = root("conflict");
+        let first = manifest("first body");
+        let second = manifest("second body");
+        let mut index = MemoryLevelOneIndexV1::open(&root).expect("open level-one index");
+        index.promote(&first).expect("promote first");
+        let error = index
+            .promote(&second)
+            .expect_err("immutable version conflict");
+        assert!(error.to_string().contains("manifest hash conflict"));
+        assert_eq!(index.references().len(), 1);
+    }
+
+    #[test]
+    fn index_journal_corruption_fails_reopen_without_truncation() {
+        let root = root("corrupt");
+        let mut index = MemoryLevelOneIndexV1::open(&root).expect("open level-one index");
+        index.promote(&manifest("body")).expect("promote skill");
+        let path = index.journal_path();
+        let mut bytes = std::fs::read(&path).expect("read journal");
+        bytes.extend_from_slice(b"{not-json}\n");
+        std::fs::write(&path, &bytes).expect("corrupt journal");
+        let error = MemoryLevelOneIndexV1::open(&root).expect_err("corrupt journal fails closed");
+        assert!(error.to_string().contains("corrupt"));
+        assert_eq!(std::fs::read(path).expect("journal remains"), bytes);
+    }
+}
