+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct MemoryAdmissionReport {
+    pub observation: MemoryObservation,
+    pub admitted: Vec<PendingIndexEntry>,
+    pub deduplicated: usize,
+    pub append_errors: Vec<String>,
+}
+
+pub struct PendingMemoryObserver {
+    pending: PendingIndex,
+}
+
+impl PendingMemoryObserver {
+    pub fn open(root: impl AsRef<Path>) -> Result<Self, PendingIndexError> {
+        Ok(Self {
+            pending: PendingIndex::open(root)?,
+        })
+    }
+
+    pub fn from_pending(pending: PendingIndex) -> Self {
+        Self { pending }
+    }
+
+    pub fn pending(&self) -> &PendingIndex {
+        &self.pending
+    }
+
+    pub fn observe_completed_stop_json(
+        &mut self,
+        _proof: CanonicalCompletedStopProof,
+        output_json: &str,
+        source: MemorySourceWindow,
+    ) -> MemoryAdmissionReport {
+        let observation = observe_memory_output(output_json, &source);
+        let mut admitted = Vec::new();
+        let mut deduplicated = 0usize;
+        let mut append_errors = Vec::new();
+        for draft in &observation.accepted {
+            match self.pending.append(draft.clone(), source.clone()) {
+                Ok(outcome) if outcome.inserted => admitted.push(outcome.entry),
+                Ok(_) => deduplicated = deduplicated.saturating_add(1),
+                Err(error) => append_errors.push(error.to_string()),
+            }
+        }
+        MemoryAdmissionReport {
+            observation,
+            admitted,
+            deduplicated,
+            append_errors,
+        }
+    }
+}
