+/// Durable append-only staging index. The journal is the persistence truth;
+/// in-memory vectors are only the current projection used by the host.
+#[derive(Debug)]
+pub struct PendingIndex {
+    root: PathBuf,
+    generation: u64,
+    next_sequence: u64,
+    active: Vec<PendingIndexEntry>,
+    frozen: BTreeMap<u64, FrozenCut>,
+    content_ids: BTreeMap<String, String>,
+    entries_by_id: BTreeMap<String, PendingIndexEntry>,
+    committed_ids: BTreeSet<String>,
+}
+
+impl PendingIndex {
+    pub fn open(root: impl AsRef<Path>) -> Result<Self, PendingIndexError> {
+        let root = root.as_ref().to_path_buf();
+        fs::create_dir_all(&root).map_err(|error| PendingIndexError::Io(error.to_string()))?;
+        let mut index = Self {
+            root,
+            generation: 0,
+            next_sequence: 0,
+            active: Vec::new(),
+            frozen: BTreeMap::new(),
+            content_ids: BTreeMap::new(),
+            entries_by_id: BTreeMap::new(),
+            committed_ids: BTreeSet::new(),
+        };
+        let journal = index.journal_path();
+        if journal.exists() {
+            let file =
+                File::open(&journal).map_err(|error| PendingIndexError::Io(error.to_string()))?;
+            for (line_number, line) in BufReader::new(file).lines().enumerate() {
+                let line = line.map_err(|error| PendingIndexError::Io(error.to_string()))?;
+                if line.trim().is_empty() {
+                    return Err(PendingIndexError::Corrupt(format!(
+                        "empty journal line {}",
+                        line_number + 1
+                    )));
+                }
+                let event: PendingEvent = serde_json::from_str(&line).map_err(|error| {
+                    PendingIndexError::Corrupt(format!("line {}: {error}", line_number + 1))
+                })?;
+                index.replay(event)?;
+            }
+        }
+        Ok(index)
+    }
+
+    pub fn generation(&self) -> u64 {
+        self.generation
+    }
+
+    pub fn next_sequence(&self) -> u64 {
+        self.next_sequence
+    }
+
+    pub fn active_entries(&self) -> &[PendingIndexEntry] {
+        &self.active
+    }
+
+    /// Build a side-effect-free cut of the current generation. Compaction
+    /// validates against this preview before `freeze` appends its journal
+    /// event, so a rejected organization proposal cannot mutate Pending.
+    pub fn preview_freeze(&self) -> Result<FrozenCut, PendingIndexError> {
+        if self.active.is_empty() {
+            return Err(PendingIndexError::EmptyFreeze);
+        }
+        Ok(FrozenCut {
+            generation: self.generation,
+            watermark: self.next_sequence.saturating_sub(1),
+            entries: self.active.clone(),
+        })
+    }
+
+    pub fn frozen_cut(&self, generation: u64) -> Option<&FrozenCut> {
+        self.frozen.get(&generation)
+    }
+
+    pub fn committed_entry_ids(&self) -> impl Iterator<Item = &str> {
+        self.committed_ids.iter().map(String::as_str)
+    }
+
+    pub fn journal_path(&self) -> PathBuf {
+        self.root.join("pending-index.jsonl")
+    }
+
+    pub fn append(
+        &mut self,
+        draft: MemoryIndexEntryDraftV1,
+        source: MemorySourceWindow,
+    ) -> Result<PendingAppendOutcome, PendingIndexError> {
+        draft
+            .validate(&source)
+            .map_err(|error| PendingIndexError::InvalidEntry(error.to_string()))?;
+        let draft = draft.normalized();
+        let bytes = serde_json::to_vec(&draft)
+            .map_err(|error| PendingIndexError::Serialization(error.to_string()))?;
+        let content_hash = stable_content_hash(&bytes);
+        if let Some(entry_id) = self.content_ids.get(&content_hash) {
+            let entry = self.entries_by_id.get(entry_id).ok_or_else(|| {
+                PendingIndexError::Corrupt(format!(
+                    "content hash points to missing entry {entry_id}"
+                ))
+            })?;
+            return Ok(PendingAppendOutcome {
+                entry: entry.clone(),
+                inserted: false,
+            });
+        }
+        let entry = PendingIndexEntry {
+            entry_id: format!("mem-{content_hash}"),
+            generation: self.generation,
+            admitted_sequence: self.next_sequence,
+            content_hash: content_hash.clone(),
+            draft,
+            source,
+        };
+        let next_sequence = self.next_sequence.checked_add(1).ok_or_else(|| {
+            PendingIndexError::InvalidEntry("admitted sequence exhausted".to_string())
+        })?;
+        self.append_event(&PendingEvent::Append {
+            entry: entry.clone(),
+        })?;
+        self.next_sequence = next_sequence;
+        self.content_ids
+            .insert(content_hash, entry.entry_id.clone());
+        self.entries_by_id
+            .insert(entry.entry_id.clone(), entry.clone());
+        self.active.push(entry.clone());
+        Ok(PendingAppendOutcome {
+            entry,
+            inserted: true,
+        })
+    }
+
+    pub fn freeze(&mut self) -> Result<FrozenCut, PendingIndexError> {
+        let cut = self.preview_freeze()?;
+        let next_generation = self.generation.checked_add(1).ok_or_else(|| {
+            PendingIndexError::InvalidEntry("pending generation exhausted".to_string())
+        })?;
+        self.append_event(&PendingEvent::Freeze { cut: cut.clone() })?;
+        self.active.clear();
+        self.frozen.insert(cut.generation, cut.clone());
+        self.generation = next_generation;
+        Ok(cut)
+    }
+
+    pub fn commit_frozen(&mut self, generation: u64) -> Result<(), PendingIndexError> {
+        let cut = self
+            .frozen
+            .get(&generation)
+            .ok_or(PendingIndexError::FrozenGenerationUnavailable(generation))?;
+        self.append_event(&PendingEvent::Commit { generation })?;
+        for entry in &cut.entries {
+            self.committed_ids.insert(entry.entry_id.clone());
+        }
+        self.frozen.remove(&generation);
+        Ok(())
+    }
+
+    fn replay(&mut self, event: PendingEvent) -> Result<(), PendingIndexError> {
+        match event {
+            PendingEvent::Append { entry } => {
+                if entry.generation != self.generation {
+                    return Err(PendingIndexError::Corrupt(format!(
+                        "append generation {} does not match current generation {}",
+                        entry.generation, self.generation
+                    )));
+                }
+                if entry.admitted_sequence != self.next_sequence {
+                    return Err(PendingIndexError::Corrupt(format!(
+                        "append sequence {} does not match next sequence {}",
+                        entry.admitted_sequence, self.next_sequence
+                    )));
+                }
+                if self.entries_by_id.contains_key(&entry.entry_id) {
+                    return Err(PendingIndexError::Corrupt(format!(
+                        "duplicate entry id {}",
+                        entry.entry_id
+                    )));
+                }
+                entry
+                    .draft
+                    .validate(&entry.source)
+                    .map_err(|error| PendingIndexError::Corrupt(error.to_string()))?;
+                if entry.draft.clone().normalized() != entry.draft {
+                    return Err(PendingIndexError::Corrupt(format!(
+                        "entry {} draft is not normalized",
+                        entry.entry_id
+                    )));
+                }
+                let expected_hash = serde_json::to_vec(&entry.draft)
+                    .map(|bytes| stable_content_hash(&bytes))
+                    .map_err(|error| PendingIndexError::Corrupt(error.to_string()))?;
+                if entry.content_hash != expected_hash {
+                    return Err(PendingIndexError::Corrupt(format!(
+                        "entry {} content hash does not match draft",
+                        entry.entry_id
+                    )));
+                }
+                let expected_entry_id = format!("mem-{expected_hash}");
+                if entry.entry_id != expected_entry_id {
+                    return Err(PendingIndexError::Corrupt(format!(
+                        "entry id {} does not match content hash",
+                        entry.entry_id
+                    )));
+                }
+                if let Some(existing_id) = self.content_ids.get(&entry.content_hash) {
+                    return Err(PendingIndexError::Corrupt(format!(
+                        "duplicate content hash {} for entries {} and {}",
+                        entry.content_hash, existing_id, entry.entry_id
+                    )));
+                }
+                self.next_sequence = self.next_sequence.checked_add(1).ok_or_else(|| {
+                    PendingIndexError::Corrupt("admitted sequence exhausted".to_string())
+                })?;
+                self.content_ids
+                    .insert(entry.content_hash.clone(), entry.entry_id.clone());
+                self.entries_by_id
+                    .insert(entry.entry_id.clone(), entry.clone());
+                self.active.push(entry);
+            }
+            PendingEvent::Freeze { cut } => {
+                let expected_watermark = self.next_sequence.checked_sub(1);
+                if cut.generation != self.generation
+                    || cut.entries.is_empty()
+                    || cut.entries != self.active
+                    || Some(cut.watermark) != expected_watermark
+                {
+                    return Err(PendingIndexError::Corrupt(format!(
+                        "freeze generation {} does not match active projection or watermark",
+                        cut.generation
+                    )));
+                }
+                if self.frozen.contains_key(&cut.generation) {
+                    return Err(PendingIndexError::Corrupt(format!(
+                        "duplicate freeze generation {}",
+                        cut.generation
+                    )));
+                }
+                self.active.clear();
+                self.frozen.insert(cut.generation, cut);
+                self.generation = self.generation.checked_add(1).ok_or_else(|| {
+                    PendingIndexError::Corrupt("pending generation exhausted".to_string())
+                })?;
+            }
+            PendingEvent::Commit { generation } => {
+                let cut = self.frozen.remove(&generation).ok_or_else(|| {
+                    PendingIndexError::Corrupt(format!(
+                        "commit generation {generation} has no frozen cut"
+                    ))
+                })?;
+                for entry in cut.entries {
+                    self.committed_ids.insert(entry.entry_id);
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn append_event(&self, event: &PendingEvent) -> Result<(), PendingIndexError> {
+        let line = serde_json::to_vec(event)
+            .map_err(|error| PendingIndexError::Serialization(error.to_string()))?;
+        let mut file = OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(self.journal_path())
+            .map_err(|error| PendingIndexError::Io(error.to_string()))?;
+        file.write_all(&line)
+            .and_then(|_| file.write_all(b"\n"))
+            .and_then(|_| file.sync_data())
+            .map_err(|error| PendingIndexError::Io(error.to_string()))
+    }
+}
+
+fn stable_content_hash(bytes: &[u8]) -> String {
+    let mut digest = Sha256::new();
+    digest.update(bytes);
+    digest
+        .finalize()
+        .iter()
+        .map(|byte| format!("{byte:02x}"))
+        .collect()
+}
