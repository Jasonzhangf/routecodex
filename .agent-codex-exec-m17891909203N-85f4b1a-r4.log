     let health = V3ProviderFailureRuntimeHealth::from_manifest(&manifest);
     let session = test_provider_failure_scope(
         "post_commit_transient_counted",
         "post_commit_transient_counted",
         "transient-session",
     )
     .expect("transient session scope");
