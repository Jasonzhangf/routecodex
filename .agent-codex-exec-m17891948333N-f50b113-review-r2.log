   621	
   622	/// Responses wire tools only support provider-native tool types; a Codex `type=namespace`
   623	/// container (MCP tool discovery) is not a standard Responses tool and fails strict providers.
   624	/// Flatten each namespace child into a plain `function` tool, preserving order and child
   625	/// name/description/parameters/strict, so no `namespace` container crosses the provider wire.
   626	///
   627	/// The expanded `function` shape follows the target provider's native tool convention:
   628	/// `responses` providers (OpenAI Responses standard) receive the flat form
   629	/// (`{"type":"function","name":...}`), while `openai_chat` providers (Chat-style gateways
   630	/// such as Console Go, whose `/v1/responses` endpoint reuses the Chat tool serde) receive
   631	/// the nested form (`{"type":"function","function":{...}}`).
   632	fn expand_namespace_tools_in_responses_wire_body(
   633	    request_id: &str,
   634	    provider_type: &str,
   635	    mut body: Value,
   636	) -> Result<Value, V3ProviderError> {
   637	    let Some(tools) = body.get("tools").and_then(Value::as_array) else {
   638	        return Ok(body);
   639	    };
   640	    let has_namespace = tools
   641	        .iter()
   642	        .any(|tool| tool.get("type").and_then(Value::as_str) == Some("namespace"));
   643	    if !has_namespace && provider_type != "openai_chat" {
   644	        return Ok(body);
   645	    }
   646	    let protocol = match provider_type {
   647	        "openai_chat" => "openai-chat",
   648	        _ => RESPONSES_WIRE_PROTOCOL_NAME,
   649	    };
   650	    let tools = tools.clone();
   651	    let mut expanded = Vec::with_capacity(tools.len());
   652	    let mut namespace_name_map = HashMap::new();
   653	    for tool in tools {
   654	        if tool.get("type").and_then(Value::as_str) == Some("namespace") {
   655	            let namespace_name = tool
   656	                .get("name")
   657	                .and_then(Value::as_str)
   658	                .map(str::trim)
   659	                .filter(|value| !value.is_empty());
   660	            if let (Some(namespace_name), Some(children)) =
   661	                (namespace_name, tool.get("tools").and_then(Value::as_array))
   662	            {
   663	                for child in children {
   664	                    let child_name = child
   665	                        .get("function")
   666	                        .and_then(Value::as_object)
   667	                        .and_then(|function| function.get("name"))
   668	                        .or_else(|| child.get("name"))
   669	                        .and_then(Value::as_str)
   670	                        .map(str::trim)
   671	                        .filter(|value| !value.is_empty());
   672	                    if let Some(child_name) = child_name {
   673	                        let qualified_name = format!("{namespace_name}.{child_name}");
   674	                        namespace_name_map.insert(
   675	                            qualified_name,
   676	                            map_namespace_tool_name(namespace_name, child_name),
   677	                        );
   678	                    }
   679	                }
   680	            }
   681	        }
   682	        match flatten_namespace_tool_for_provider(protocol, &tool) {
   683	            Ok(Some(mut children)) => {
   684	                if let Some(namespace_name) = tool.get("name").and_then(Value::as_str) {
   685	                    rename_flattened_namespace_children(
   686	                        namespace_name,
   687	                        tool.get("tools").and_then(Value::as_array),
   688	                        &mut children,
   689	                    );
   690	                }
   691	                expanded.extend(children)
   692	            }
   693	            Ok(None) => expanded.push(tool),
   694	            Err(detail) => {
   695	                return Err(V3ProviderError::NamespaceToolFlattenFailed {
   696	                    request_id: request_id.to_string(),
   697	                    detail,
   698	                })
   699	            }
   700	        }
   701	    }
   702	    if provider_type == "openai_chat" {
   703	        expanded = normalize_openai_chat_function_tools(request_id, expanded)?;
   704	    }
   705	    body["tools"] = Value::Array(expanded);
   706	    rewrite_namespace_qualified_call_names(&mut body, &namespace_name_map);
   707	    Ok(body)
   708	}
   709	
   710	fn rename_flattened_namespace_children(
   711	    namespace_name: &str,
   712	    source_children: Option<&Vec<Value>>,
   713	    flattened_children: &mut [Value],
   714	) {
   715	    let Some(source_children) = source_children else {
   716	        return;
   717	    };
   718	    for (source, flattened) in source_children.iter().zip(flattened_children.iter_mut()) {
   719	        let child_name = source
   720	            .get("function")
   721	            .and_then(Value::as_object)
   722	            .and_then(|function| function.get("name"))
   723	            .or_else(|| source.get("name"))
   724	            .and_then(Value::as_str)
   725	            .map(str::trim)
   726	            .filter(|value| !value.is_empty());
   727	        let Some(child_name) = child_name else {
   728	            continue;
   729	        };
   730	        let mapped = Value::String(map_namespace_tool_name(namespace_name, child_name));
   731	        if let Some(object) = flattened.as_object_mut() {
   732	            object.insert("name".to_string(), mapped.clone());
   733	            if let Some(function) = object.get_mut("function").and_then(Value::as_object_mut) {
   734	                function.insert("name".to_string(), mapped.clone());
   735	            }
   736	        }
   737	    }
   738	}
   739	
   740	fn map_namespace_tool_name(namespace_name: &str, child_name: &str) -> String {
   741	    if child_name
   742	        .strip_prefix(namespace_name)
   743	        .is_some_and(|suffix| suffix.starts_with("__"))
   744	    {
   745	        return child_name.to_string();
   746	    }
   747	    let qualified_name = format!("{namespace_name}.{child_name}");
   748	    let mut mapped = String::with_capacity(qualified_name.len());
   749	    for character in qualified_name.chars() {
   750	        match character {
   751	            '.' => mapped.push_str("__"),
   752	            character if character.is_ascii_alphanumeric() || matches!(character, '_' | '-') => {
   753	                mapped.push(character)
   754	            }
   755	            _ => mapped.push('_'),
   756	        }
   757	    }
   758	    mapped
   759	}
   760	
   761	fn rewrite_namespace_qualified_call_names(body: &mut Value, names: &HashMap<String, String>) {
   762	    fn rewrite_call_object(value: &mut Value, names: &HashMap<String, String>) {
