   768	fn rewrite_namespace_qualified_call_names(body: &mut Value, names: &HashMap<String, String>) {
   769	    fn rewrite_call_object(value: &mut Value, names: &HashMap<String, String>) {
   770	        let Some(object) = value.as_object_mut() else {
   771	            return;
   772	        };
   773	        if let Some(Value::String(name)) = object.get_mut("name") {
   774	            if let Some(mapped) = names.get(name.as_str()) {
   775	                *name = mapped.clone();
   776	            }
   777	        }
   778	        if let Some(function) = object.get_mut("function").and_then(Value::as_object_mut) {
   779	            if let Some(Value::String(name)) = function.get_mut("name") {
   780	                if let Some(mapped) = names.get(name.as_str()) {
   781	                    *name = mapped.clone();
   782	                }
   783	            }
   784	        }
   785	    }
   786	
   787	    if let Some(input) = body.get_mut("input").and_then(Value::as_array_mut) {
   788	        for item in input {
   789	            if matches!(
   790	                item.get("type").and_then(Value::as_str),
   791	                Some("function_call" | "custom_tool_call" | "tool_use")
   792	            ) {
   793	                rewrite_call_object(item, names);
   794	            }
   795	        }
   796	    }
   797	    if let Some(messages) = body.get_mut("messages").and_then(Value::as_array_mut) {
   798	        for message in messages {
   799	            let Some(tool_calls) = message.get_mut("tool_calls").and_then(Value::as_array_mut)
   800	            else {
   801	                continue;
   802	            };
   803	            for tool_call in tool_calls {
   804	                if tool_call.get("type").and_then(Value::as_str) == Some("function") {
   805	                    rewrite_call_object(tool_call, names);
   806	                }
   807	            }
   808	        }
   809	    }
   810	}
