   622	/// Responses wire tools only support provider-native tool types; a Codex `type=namespace`
   623	/// container (MCP tool discovery) is not a standard Responses tool and fails strict providers.
   624	/// Flatten each namespace child into a plain `function` tool, preserving order and child
   625	/// name/description/parameters/strict, so no `namespace` container crosses the provider wire.
   626	///
   627	/// The expanded `function` shape follows the target provider's native tool convention:
   628	/// `responses` providers (OpenAI Responses standard) receive the flat form
   629	/// (`{"type":"function","name":...}`), while `openai_chat` providers (Chat-style gateways
   630	/// such as Console Go, whose `/v1/responses` endpoint reuses the Chat tool serde) receive
   631	/// the nested form (`{"type":"function","function":{...}}`).
   632	fn expand_namespace_tools_in_responses_wire_body(
   633	    request_id: &str,
   634	    provider_type: &str,
   635	    mut body: Value,
   636	) -> Result<Value, V3ProviderError> {
   637	    let Some(tools) = body.get("tools").and_then(Value::as_array) else {
   638	        rewrite_namespace_qualified_call_names_from_convention(&mut body);
   639	        return Ok(body);
   640	    };
   641	    let has_namespace = tools
   642	        .iter()
   643	        .any(|tool| tool.get("type").and_then(Value::as_str) == Some("namespace"));
   644	    if !has_namespace && provider_type != "openai_chat" {
   645	        rewrite_namespace_qualified_call_names_from_convention(&mut body);
   646	        return Ok(body);
   647	    }
   648	    let protocol = match provider_type {
   649	        "openai_chat" => "openai-chat",
   650	        _ => RESPONSES_WIRE_PROTOCOL_NAME,
   651	    };
   652	    let tools = tools.clone();
   653	    let mut expanded = Vec::with_capacity(tools.len());
   654	    let mut namespace_name_map = HashMap::new();
   655	    for tool in tools {
   656	        if tool.get("type").and_then(Value::as_str) == Some("namespace") {
   657	            let namespace_name = tool
   658	                .get("name")
   659	                .and_then(Value::as_str)
   660	                .map(str::trim)
   661	                .filter(|value| !value.is_empty());
   662	            if let (Some(namespace_name), Some(children)) =
   663	                (namespace_name, tool.get("tools").and_then(Value::as_array))
   664	            {
   665	                for child in children {
   666	                    let child_name = child
   667	                        .get("function")
   668	                        .and_then(Value::as_object)
   669	                        .and_then(|function| function.get("name"))
   670	                        .or_else(|| child.get("name"))
   671	                        .and_then(Value::as_str)
   672	                        .map(str::trim)
   673	                        .filter(|value| !value.is_empty());
   674	                    if let Some(child_name) = child_name {
   675	                        let qualified_name = format!("{namespace_name}.{child_name}");
   676	                        namespace_name_map.insert(
   677	                            qualified_name,
   678	                            map_namespace_tool_name(namespace_name, child_name),
   679	                        );
   680	                    }
   681	                }
   682	            }
   683	        }
   684	        match flatten_namespace_tool_for_provider(protocol, &tool) {
   685	            Ok(Some(mut children)) => {
   686	                if let Some(namespace_name) = tool.get("name").and_then(Value::as_str) {
   687	                    rename_flattened_namespace_children(
   688	                        namespace_name,
   689	                        tool.get("tools").and_then(Value::as_array),
   690	                        &mut children,
   691	                    );
   692	                }
   693	                expanded.extend(children)
   694	            }
   695	            Ok(None) => expanded.push(tool),
   696	            Err(detail) => {
   697	                return Err(V3ProviderError::NamespaceToolFlattenFailed {
   698	                    request_id: request_id.to_string(),
   699	                    detail,
   700	                })
   701	            }
   702	        }
   703	    }
   704	    if provider_type == "openai_chat" {
   705	        expanded = normalize_openai_chat_function_tools(request_id, expanded)?;
   706	    }
   707	    body["tools"] = Value::Array(expanded);
   708	    rewrite_namespace_qualified_call_names(&mut body, &namespace_name_map);
   709	    // Historical inputs may carry an MCP-qualified call even when the current
   710	    // tool declaration is incomplete or omitted its child. Apply the same
   711	    // validated convention mapping as the no-tools path so strict providers
   712	    // never receive a dotted function name.
   713	    rewrite_namespace_qualified_call_names_from_convention(&mut body);
   714	    Ok(body)
   715	}
   716	
   717	fn rename_flattened_namespace_children(
   718	    namespace_name: &str,
   719	    source_children: Option<&Vec<Value>>,
   720	    flattened_children: &mut [Value],
   721	) {
   722	    let Some(source_children) = source_children else {
   723	        return;
   724	    };
   725	    for (source, flattened) in source_children.iter().zip(flattened_children.iter_mut()) {
   726	        let child_name = source
   727	            .get("function")
   728	            .and_then(Value::as_object)
   729	            .and_then(|function| function.get("name"))
   730	            .or_else(|| source.get("name"))
   731	            .and_then(Value::as_str)
   732	            .map(str::trim)
   733	            .filter(|value| !value.is_empty());
   734	        let Some(child_name) = child_name else {
   735	            continue;
   736	        };
   737	        let mapped = Value::String(map_namespace_tool_name(namespace_name, child_name));
   738	        if let Some(object) = flattened.as_object_mut() {
   739	            object.insert("name".to_string(), mapped.clone());
   740	            if let Some(function) = object.get_mut("function").and_then(Value::as_object_mut) {
   741	                function.insert("name".to_string(), mapped.clone());
   742	            }
   743	        }
   744	    }
   745	}
   746	
   747	fn map_namespace_tool_name(namespace_name: &str, child_name: &str) -> String {
   748	    if child_name
   749	        .strip_prefix(namespace_name)
   750	        .is_some_and(|suffix| suffix.starts_with("__"))
   751	    {
   752	        return child_name.to_string();
   753	    }
   754	    let qualified_name = format!("{namespace_name}.{child_name}");
   755	    let mut mapped = String::with_capacity(qualified_name.len());
   756	    for character in qualified_name.chars() {
   757	        match character {
   758	            '.' => mapped.push_str("__"),
   759	            character if character.is_ascii_alphanumeric() || matches!(character, '_' | '-') => {
   760	                mapped.push(character)
   761	            }
   762	            _ => mapped.push('_'),
   763	        }
   764	    }
   765	    mapped
   766	}
